<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AvaloniaUIKit</RootNamespace>
    <PackageId>AvaloniaUIKit.Dock</PackageId>
    <Description>GPUI Kit's Dock look for Dock.Avalonia, on top of AvaloniaUIKit's UIKitTheme.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AvaloniaXamlIlVerifyIl>true</AvaloniaXamlIlVerifyIl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../AvaloniaUIKit/BannedSymbols.txt" Link="BannedSymbols.txt" />
    <ProjectReference Include="../AvaloniaUIKit/AvaloniaUIKit.csproj" />
  </ItemGroup>
</Project>
