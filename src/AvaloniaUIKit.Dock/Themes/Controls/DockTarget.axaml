<!--
  GPUI Kit's drop placeholder (base/dock/drag.rs, dock/tab_panel.rs) -> DockTarget.
  The selectors are the zones GPUI picks from the pointer: the left or right 35%
  of the group splits it sideways, the top or bottom 35% of the middle splits it
  up or down, and the middle merges into it. They are transparent; the operation
  they pick shows as GPUI's placeholder, the drop target color over the half (or
  the whole) of the group it will take. Dock sets the active indicator's opacity,
  so the color is painted on a fill beside it at full strength. A tab's target is
  a 2px marker at its left edge (uikit-dock-insert): GPUI's insertion line, in the
  drag border color.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit"
                    x:CompileBindings="True">
  <ControlTheme x:Key="{x:Type DockTarget}" TargetType="DockTarget">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="uikit:DockTargets.MarksTab" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="PART_IndicatorGrid" RowDefinitions="*,*" ColumnDefinitions="*,*">
          <Border x:Name="PART_TopFill" Grid.Row="0" Grid.ColumnSpan="2" Classes="fill"
                  IsVisible="{Binding #PART_TopIndicator.Opacity, Converter={x:Static uikit:DockConverters.IsShown}}" />
          <Border x:Name="PART_BottomFill" Grid.Row="1" Grid.ColumnSpan="2" Classes="fill"
                  IsVisible="{Binding #PART_BottomIndicator.Opacity, Converter={x:Static uikit:DockConverters.IsShown}}" />
          <Border x:Name="PART_LeftFill" Grid.RowSpan="2" Grid.Column="0" Classes="fill"
                  IsVisible="{Binding #PART_LeftIndicator.Opacity, Converter={x:Static uikit:DockConverters.IsShown}}" />
          <Border x:Name="PART_RightFill" Grid.RowSpan="2" Grid.Column="1" Classes="fill"
                  IsVisible="{Binding #PART_RightIndicator.Opacity, Converter={x:Static uikit:DockConverters.IsShown}}" />
          <Border x:Name="PART_CenterFill" Grid.RowSpan="2" Grid.ColumnSpan="2" Classes="fill"
                  IsVisible="{Binding #PART_CenterIndicator.Opacity, Converter={x:Static uikit:DockConverters.IsShown}}" />

          <Panel x:Name="PART_TopIndicator"
                 Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="0"
                 IsVisible="{TemplateBinding ShowVerticalTargets}"
                 DockProperties.IndicatorDockOperation="Top" />
          <Panel x:Name="PART_BottomIndicator"
                 Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0"
                 IsVisible="{TemplateBinding ShowVerticalTargets}"
                 DockProperties.IndicatorDockOperation="Bottom" />
          <Panel x:Name="PART_LeftIndicator"
                 Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                 IsVisible="{TemplateBinding ShowHorizontalTargets}"
                 DockProperties.IndicatorDockOperation="Left" />
          <Panel x:Name="PART_RightIndicator"
                 Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                 IsVisible="{TemplateBinding ShowHorizontalTargets}"
                 DockProperties.IndicatorDockOperation="Right" />
          <Panel x:Name="PART_CenterIndicator"
                 Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                 DockProperties.IndicatorDockOperation="Fill" />

          <!-- drag.rs: 35% / 65% of the width, then of the height. -->
          <Grid x:Name="PART_SelectorGrid" Grid.RowSpan="2" Grid.ColumnSpan="2"
                RowDefinitions="35*,30*,35*" ColumnDefinitions="35*,30*,35*">
            <Panel x:Name="PART_LeftSelector"
                   Grid.RowSpan="3" Grid.Column="0"
                   IsVisible="{TemplateBinding ShowHorizontalTargets}"
                   DockProperties.IndicatorDockOperation="Left" />
            <Panel x:Name="PART_RightSelector"
                   Grid.RowSpan="3" Grid.Column="2"
                   IsVisible="{TemplateBinding ShowHorizontalTargets}"
                   DockProperties.IndicatorDockOperation="Right" />
            <Panel x:Name="PART_TopSelector"
                   Grid.Row="0" Grid.Column="1"
                   IsVisible="{TemplateBinding ShowVerticalTargets}"
                   DockProperties.IndicatorDockOperation="Top" />
            <Panel x:Name="PART_BottomSelector"
                   Grid.Row="2" Grid.Column="1"
                   IsVisible="{TemplateBinding ShowVerticalTargets}"
                   DockProperties.IndicatorDockOperation="Bottom" />
            <Panel x:Name="PART_CenterSelector"
                   Grid.Row="1" Grid.Column="1"
                   DockProperties.IndicatorDockOperation="Fill" />
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^/template/ Border.fill">
      <Setter Property="Background" Value="{DynamicResource UIKit.DropTarget}" />
    </Style>
    <Style Selector="^/template/ Panel">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
