<!--
  GPUI Kit TabBar / Tab (crates/component/src/tab) -> Tabalonia's TabsControl
  and DragTabItem. The look is generated with TabStrip's (Themes/Tabs.axaml,
  scripts/gen_tabs_theme.py). Use it instead of Tabalonia's themes: their
  styles would override these.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaUIKit.UIKitTabaloniaTheme">
  <StyleInclude Source="avares://AvaloniaUIKit.Tabalonia/Themes/Tabs.axaml" />
</Styles>
