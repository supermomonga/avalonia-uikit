    <Setter Property="TextBlock.LineHeight" Value="20" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl.underline.large > tab|DragTabItem /template/ Border#PART_Background">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl.underline.large > tab|DragTabItem /template/ Border#PART_Inner">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0,0" />
    <Setter Property="Margin" Value="0,5,0,6" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl.underline.large > tab|DragTabItem.icon-only /template/ Border#PART_Inner">
    <Setter Property="Width" Value="40" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl.underline.large > tab|DragTabItem /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5" />
  </Style>
  <Style Selector="tab|TabsControl.xsmall > tab|DragTabItem PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="tab|TabsControl.small > tab|DragTabItem PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="tab|TabsControl:not(.xsmall):not(.small):not(.large) > tab|DragTabItem PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="tab|TabsControl.large > tab|DragTabItem PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <!-- The close button's icon is an xsmall button's (12px), whatever the tab's icon size. -->
  <Style Selector="tab|DragTabItem PathIcon.uikit-tab-button">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
</Styles>
