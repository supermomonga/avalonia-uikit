<!--
  DO NOT EDIT. Generated by scripts/gen_tabs_theme.py.

  GPUI Kit TabBar / Tab (crates/component/src/tab) -> Tabalonia's TabsControl /
  DragTabItem, with the same classes and metrics as TabStrip and TabControl
  (Tabs.axaml in AvaloniaUIKit):

    <tab:TabsControl Classes="pill small menu" ItemsSource="{Binding Tabs}"
                     TabItemWidth="120" EnableTabDetaching="False" />

  Classes on the TabsControl: variant outline pill segmented underline (GPUI's
  default Tab without one), size xsmall small large (medium without one), menu
  for GPUI's menu(true) (a caret button listing the tabs); icon-only on a tab
  whose header is an icon. LeftContent and RightContent are the bar's prefix
  and suffix. The tabs scroll sideways when they overflow, as GPUI's do. Each
  tab is TabItemWidth wide (Tabalonia lays its tabs out at one width) with its
  label centred, the close button as the suffix GPUI's tabs story gives a
  closable tab, and Tabalonia's add button after the last tab. The indicator
  follows a dragged tab at once and springs to a newly selected one. Tabs show
  an Avalonia-only ring on keyboard focus.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uikit="using:AvaloniaUIKit"
        xmlns:tab="clr-namespace:Tabalonia.Controls;assembly=Tabalonia"
        xmlns:tabconv="clr-namespace:Tabalonia.Converters;assembly=Tabalonia"
        xmlns:tabpanels="clr-namespace:Tabalonia.Panels;assembly=Tabalonia">
  <Styles.Resources>
    <!-- styled.rs raised_shadow(): the segmented indicator. -->
    <BoxShadows x:Key="UIKit.Shadow.Raised">0 1 3.4641 0 #1A000000, 0 1 1.7321 -1 #1A000000</BoxShadows>
    <!-- tab.rs: the newly selected pill's label, 200ms ease-in-out-cubic. -->
    <uikit:ColorTransition x:Key="UIKit.Tab.PillFade" Duration="0:0:0.2" Easing="CubicEaseInOut" Properties="Foreground" />
    <!-- The drag handle over a tab's label: hit-testable, paints nothing. -->
    <ControlTheme x:Key="UIKitDragTabThumb" TargetType="tab:LeftPressedThumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <!-- The window-moving thumbs beside the tabs: GPUI's bar does not move the window. -->
    <ControlTheme x:Key="UIKitTabsWindowThumb" TargetType="Thumb">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <tabconv:ShowDefaultCloseButtonConverter x:Key="UIKitTabsShowsClose" />
    <ControlTheme x:Key="{x:Type tab:DragTabItem}" TargetType="tab:DragTabItem">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.TabForeground}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextBlock.LineHeight" Value="17.5" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <!-- As TabItem's (Tabs.axaml): the background, and the border over it. -->
            <Border Name="PART_Background" Background="{TemplateBinding Background}" />
            <Border Name="PART_LayoutRoot"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    ClipToBounds="True">
              <!-- tab.rs: the label fills the tab, then gap_1 and the suffix (the close button). -->
              <Grid ColumnDefinitions="*,Auto">
                <Border Name="PART_Inner" VerticalAlignment="Center">
                  <!-- tab.rs under max_width: an ellipsized label starts at its box's start. -->
                  <ContentPresenter Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    uikit:TextLines.StartsTrimmedText="True" />
                </Border>
                <tab:LeftPressedThumb Name="PART_Thumb" Theme="{StaticResource UIKitDragTabThumb}" />
                <!-- The tabs story's close suffix: a ghost xsmall button with the 12px Close icon. -->
                <Button Name="PART_CloseButton" Grid.Column="1" Classes="ghost xsmall icon-only"
                        Margin="4,0,0,0" VerticalAlignment="Center"
                        Command="{Binding $parent[tab:TabsControl].CloseItemCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                  <Button.IsVisible>
                    <MultiBinding Converter="{StaticResource UIKitTabsShowsClose}">
                      <Binding Path="ShowDefaultCloseButton" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type tab:TabsControl}}" />
                      <Binding Path="FixedHeaderCount" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type tab:TabsControl}}" />
                      <Binding Path="LogicalIndex" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                  </Button.IsVisible>
                  <PathIcon Classes="uikit-tab-button" Data="{DynamicResource UIKit.Icon.Close}" />
                </Button>
              </Grid>
            </Border>
            <!-- Avalonia-only keyboard focus (GPUI tabs take no focus): the 3px ring band. -->
            <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3"
                    BorderBrush="{DynamicResource UIKit.FocusRing}"
                    IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type tab:TabsControl}" TargetType="tab:TabsControl">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <DockPanel>
              <!--
                tab_bar.rs: the bar is the prefix, the tabs (scrolling sideways when
                they overflow), the menu button and the suffix. TopPanel only looks
                its six parts up by name, so the bar's prefix and suffix are shown
                outside the scrolling tabs and its own content parts stay empty.
              -->
              <Border Name="PART_Bar" DockPanel.Dock="Top">
                <Panel>
                  <!-- Tab and Underline: a 1px border line along the bar's bottom, under the tabs. -->
                  <Border Name="PART_Baseline" BorderThickness="0,0,0,1"
                          BorderBrush="{DynamicResource UIKit.Border}" IsHitTestVisible="False" />
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <ContentPresenter Name="PART_Prefix" Content="{TemplateBinding LeftContent}"
                                      VerticalAlignment="Center" />
                    <ScrollViewer Name="PART_Scroller" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                      <Panel>
                        <!-- The selected tab's indicator (Pill, Segmented, Underline), under the tabs. -->
                        <Canvas Name="PART_IndicatorLayer" ClipToBounds="True" IsHitTestVisible="False">
                          <Panel Name="PART_Indicator" uikit:Tabs.Indicator="True" uikit:DragTabs.FollowsDrag="True"
                                 uikit:Motion.Spring="{DynamicResource UIKit.Spring.Move}" uikit:Motion.SpringsCanvasLeft="True">
                            <Border Name="PART_IndicatorFill"
                                    uikit:Motion.Spring="{DynamicResource UIKit.Spring.Move}"
                                    Width="{Binding $self.(uikit:Motion.SpringValue)}" />
                          </Panel>
                        </Canvas>
                        <tabpanels:TopPanel Name="PART_TopPanel">
                          <Panel Name="PART_LeftContent" />
                          <Thumb Name="PART_LeftDragWindowThumb" Theme="{StaticResource UIKitTabsWindowThumb}" />
                          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                          <!-- Avalonia-only: Tabalonia's add button, a ghost xsmall button with the Plus icon. -->
                          <Button Name="PART_AddItemButton" Classes="ghost xsmall icon-only" Margin="4,0,0,0"
                                  Command="{Binding AddItemCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                  IsVisible="{TemplateBinding ShowDefaultAddButton}">
                            <PathIcon Width="12" Height="12" Data="{DynamicResource UIKit.Icon.Plus}" />
                          </Button>
                          <Thumb Name="PART_RightDragWindowThumb" Theme="{StaticResource UIKitTabsWindowThumb}" />
                          <!-- tab_bar.rs last_empty_space: 12px after the tabs with a menu or a suffix. -->
                          <Panel Name="PART_RightContent" Width="12"
                                 IsVisible="{Binding RightContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </tabpanels:TopPanel>
                      </Panel>
                    </ScrollViewer>
                    <!-- tab_bar.rs menu(true): a ghost xsmall button with a caret that lists the tabs. -->
                    <uikit:TabsMenuButton Name="PART_MenuButton" Grid.Column="2" Classes="ghost xsmall icon-only"
                                          VerticalAlignment="Center" IsVisible="False">
                      <PathIcon Width="12" Height="12" Foreground="{DynamicResource UIKit.Button.Ghost.Caret}"
                                Data="{DynamicResource UIKit.Icon.ChevronDown}" />
                    </uikit:TabsMenuButton>
                    <ContentPresenter Name="PART_Suffix" Grid.Column="3" Content="{TemplateBinding RightContent}"
                                      VerticalAlignment="Center" />
                  </Grid>
                </Panel>
              </Border>
              <Panel>
                <ContentPresenter Name="PART_SelectedContentHost2"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  IsVisible="False" />
                <ContentPresenter Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Panel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:not(.outline):not(.pill):not(.segmented):not(.underline) /template/ Border#PART_Baseline">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:not(.outline):not(.pill):not(.segmented):not(.underline) /template/ Border#PART_Bar">
        <Setter Property="Background" Value="{DynamicResource UIKit.TabBar}" />
      </Style>
      <Style Selector="^:not(.outline):not(.pill):not(.segmented):not(.underline) /template/ Border#PART_IndicatorFill">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:not(.outline):not(.pill):not(.segmented):not(.underline).xsmall">
        <Setter Property="AdjacentHeaderItemOffset" Value="0" />
      </Style>
      <Style Selector="^:not(.outline):not(.pill):not(.segmented):not(.underline).small">
        <Setter Property="AdjacentHeaderItemOffset" Value="0" />
      </Style>
      <Style Selector="^:not(.outline):not(.pill):not(.segmented):not(.underline):not(.xsmall):not(.small):not(.large)">
        <Setter Property="AdjacentHeaderItemOffset" Value="0" />
      </Style>
      <Style Selector="^:not(.outline):not(.pill):not(.segmented):not(.underline).large">
        <Setter Property="AdjacentHeaderItemOffset" Value="0" />
      </Style>
      <Style Selector="^.outline /template/ Border#PART_Baseline">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^.outline /template/ Border#PART_Bar">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^.outline /template/ Border#PART_IndicatorFill">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^.outline.xsmall">
        <Setter Property="AdjacentHeaderItemOffset" Value="8" />
      </Style>
      <Style Selector="^.outline.small">
        <Setter Property="AdjacentHeaderItemOffset" Value="8" />
      </Style>
      <Style Selector="^.outline:not(.xsmall):not(.small):not(.large)">
        <Setter Property="AdjacentHeaderItemOffset" Value="12" />
      </Style>
      <Style Selector="^.outline.large">
        <Setter Property="AdjacentHeaderItemOffset" Value="16" />
      </Style>
      <Style Selector="^.pill /template/ Border#PART_Baseline">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^.pill /template/ Border#PART_Bar">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^.pill /template/ Border#PART_IndicatorFill">
        <Setter Property="Background" Value="{DynamicResource UIKit.Primary.Fill}" />
      </Style>
      <Style Selector="^.pill.xsmall">
        <Setter Property="AdjacentHeaderItemOffset" Value="4" />
      </Style>
      <Style Selector="^.pill.xsmall /template/ Border#PART_IndicatorFill">
        <Setter Property="CornerRadius" Value="10" />
      </Style>
      <Style Selector="^.pill.small">
        <Setter Property="AdjacentHeaderItemOffset" Value="4" />
      </Style>
      <Style Selector="^.pill.small /template/ Border#PART_IndicatorFill">
        <Setter Property="CornerRadius" Value="12" />
      </Style>
      <Style Selector="^.pill:not(.xsmall):not(.small):not(.large)">
        <Setter Property="AdjacentHeaderItemOffset" Value="4" />
      </Style>
      <Style Selector="^.pill:not(.xsmall):not(.small):not(.large) /template/ Border#PART_IndicatorFill">
        <Setter Property="CornerRadius" Value="16" />
      </Style>
      <Style Selector="^.pill.large">
        <Setter Property="AdjacentHeaderItemOffset" Value="4" />
      </Style>
      <Style Selector="^.pill.large /template/ Border#PART_IndicatorFill">
        <Setter Property="CornerRadius" Value="18" />
      </Style>
      <Style Selector="^.segmented /template/ Border#PART_Baseline">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^.segmented /template/ Border#PART_Bar">
        <Setter Property="Background" Value="{DynamicResource UIKit.TabBarSegmented}" />
      </Style>
      <Style Selector="^.segmented /template/ Border#PART_IndicatorFill">
        <Setter Property="Background" Value="{DynamicResource UIKit.Background}" />
        <Setter Property="BoxShadow" Value="{StaticResource UIKit.Shadow.Raised}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^.segmented.xsmall">
        <Setter Property="AdjacentHeaderItemOffset" Value="2" />
      </Style>
      <Style Selector="^.segmented.xsmall /template/ Border#PART_Bar">
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style Selector="^.segmented.xsmall /template/ Border#PART_IndicatorFill">
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <Style Selector="^.segmented.small">
        <Setter Property="AdjacentHeaderItemOffset" Value="2" />
      </Style>
      <Style Selector="^.segmented.small /template/ Border#PART_Bar">
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style Selector="^.segmented.small /template/ Border#PART_IndicatorFill">
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <Style Selector="^.segmented:not(.xsmall):not(.small):not(.large)">
        <Setter Property="AdjacentHeaderItemOffset" Value="2" />
      </Style>
      <Style Selector="^.segmented:not(.xsmall):not(.small):not(.large) /template/ Border#PART_Bar">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <Style Selector="^.segmented:not(.xsmall):not(.small):not(.large) /template/ Border#PART_IndicatorFill">
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style Selector="^.segmented.large">
        <Setter Property="AdjacentHeaderItemOffset" Value="2" />
      </Style>
      <Style Selector="^.segmented.large /template/ Border#PART_Bar">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <Style Selector="^.segmented.large /template/ Border#PART_IndicatorFill">
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="5" />
      </Style>
      <Style Selector="^.underline /template/ Border#PART_Baseline">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^.underline /template/ Border#PART_Bar">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^.underline /template/ Border#PART_IndicatorFill">
        <Setter Property="Background" Value="{DynamicResource UIKit.Primary.Fill}" />
        <Setter Property="Height" Value="2" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
      </Style>
      <Style Selector="^.underline.xsmall">
        <Setter Property="AdjacentHeaderItemOffset" Value="10" />
      </Style>
      <Style Selector="^.underline.small">
        <Setter Property="AdjacentHeaderItemOffset" Value="12" />
      </Style>
      <Style Selector="^.underline:not(.xsmall):not(.small):not(.large)">
        <Setter Property="AdjacentHeaderItemOffset" Value="16" />
      </Style>
      <Style Selector="^.underline.large">
        <Setter Property="AdjacentHeaderItemOffset" Value="20" />
      </Style>
      <Style Selector="^.menu /template/ Button#PART_MenuButton, ^.menu /template/ Panel#PART_RightContent">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- A closable tab is padded as the tabs story's (px_2). -->
  <Style Selector="tab|TabsControl[ShowDefaultCloseButton=True] > tab|DragTabItem">
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <!-- tab -->
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline) > tab|DragTabItem">
    <Setter Property="BorderThickness" Value="1,0,1,0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline) > tab|DragTabItem">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.TabForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline) > tab|DragTabItem:pointerover:not(:selected):not(:disabled)">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.TabActiveForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline) > tab|DragTabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.TabActiveForeground}" />
    <Setter Property="Background" Value="{DynamicResource UIKit.TabActive}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline) > tab|DragTabItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline) > tab|DragTabItem:disabled:selected">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).xsmall > tab|DragTabItem">
    <Setter Property="Height" Value="20" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextBlock.LineHeight" Value="15" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).xsmall > tab|DragTabItem /template/ Border#PART_Background">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).xsmall > tab|DragTabItem /template/ Border#PART_Inner">
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0,0,0,0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).xsmall > tab|DragTabItem.icon-only /template/ Border#PART_Inner">
    <Setter Property="Width" Value="22.5" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).xsmall > tab|DragTabItem /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).small > tab|DragTabItem">
    <Setter Property="Height" Value="24" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextBlock.LineHeight" Value="17.5" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).small > tab|DragTabItem /template/ Border#PART_Background">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).small > tab|DragTabItem /template/ Border#PART_Inner">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,0,0,0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).small > tab|DragTabItem.icon-only /template/ Border#PART_Inner">
    <Setter Property="Width" Value="27.5" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).small > tab|DragTabItem /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline):not(.xsmall):not(.small):not(.large) > tab|DragTabItem">
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextBlock.LineHeight" Value="17.5" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline):not(.xsmall):not(.small):not(.large) > tab|DragTabItem /template/ Border#PART_Background">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline):not(.xsmall):not(.small):not(.large) > tab|DragTabItem /template/ Border#PART_Inner">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,0,0,0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline):not(.xsmall):not(.small):not(.large) > tab|DragTabItem.icon-only /template/ Border#PART_Inner">
    <Setter Property="Width" Value="37.5" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline):not(.xsmall):not(.small):not(.large) > tab|DragTabItem /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).large > tab|DragTabItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="TextBlock.LineHeight" Value="20" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).large > tab|DragTabItem /template/ Border#PART_Background">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).large > tab|DragTabItem /template/ Border#PART_Inner">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Margin" Value="0,0,0,0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).large > tab|DragTabItem.icon-only /template/ Border#PART_Inner">
    <Setter Property="Width" Value="45" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="tab|TabsControl:not(.outline):not(.pill):not(.segmented):not(.underline).large > tab|DragTabItem /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5" />
