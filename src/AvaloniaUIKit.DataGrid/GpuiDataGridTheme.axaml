<!--
  GPUI Kit DataTable (crates/component/src/table) -> DataGrid
  (Avalonia.Controls.DataGrid), the same look as TableView's default theme:

    <DataGrid ItemsSource="{Binding Rows}" Classes="small stripe" />

  A bordered box (the class borderless drops the border), a header band of
  table_head with a border rule under it, fixed row heights by size (xsmall,
  small, medium, large) with a table_row_border rule under each row, hover and
  selected fills, resize hairlines in the header, the sort indicator (idle
  chevrons at half strength on every header while the grid sorts) and a ring
  for keyboard focus. Right-align a column with CellStyleClasses="text-right"
  and a right-aligned header. GPUI's cell selection, column selection, drag
  ghost and fixed-column divider have no DataGrid counterpart here.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gpui="using:AvaloniaUIKit"
        xmlns:collections="using:Avalonia.Collections"
        x:Class="AvaloniaUIKit.GpuiDataGridTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- DataGridTextColumn's TextBlock (by key): the cell pads it; it overflows to the cell's clip. -->
      <ControlTheme x:Key="DataGridCellTextBlockTheme" TargetType="TextBlock">
        <Setter Property="ClipToBounds" Value="False" />
      </ControlTheme>

      <ControlTheme x:Key="{x:Type DataGridCell}" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{Binding $self.(gpui:Tables.CellPadding)}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid ColumnDefinitions="*,Auto" Background="{TemplateBinding Background}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
              <Rectangle Name="PART_RightGridLine" Grid.Column="1" Width="1" VerticalAlignment="Stretch" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.text-right">
          <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="^.text-center">
          <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
      </ControlTheme>

      <!--
        A column header: a cell of the header band. The sort box (16px, 12px
        icon) sits at the end of its padded box; the resize hairline on its
        right edge lights up under the pointer.
      -->
      <ControlTheme x:Key="{x:Type DataGridColumnHeader}" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Gpui.TableHeadForeground}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="{Binding $self.(gpui:Tables.CellPadding)}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource Gpui.TableRowBorder}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="{TemplateBinding Background}">
              <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="*,Auto">
                <ContentPresenter Name="PART_ContentPresenter"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                <!-- state.rs render_sort_icon: p 2, radius 3, a 12px icon in secondary_foreground. -->
                <Border Name="PART_SortButton" Grid.Column="1"
                        Width="16" Height="16" CornerRadius="3"
                        VerticalAlignment="Center"
                        Background="Transparent">
                  <Panel Width="12" Height="12">
                    <PathIcon Name="PART_SortFaint" Opacity="0.2" IsVisible="False"
                              Width="12" Height="12"
                              Foreground="{DynamicResource Gpui.SecondaryForeground}" />
                    <PathIcon Name="PART_SortIcon"
                              Width="12" Height="12"
                              Foreground="{DynamicResource Gpui.SecondaryForeground}" />
                  </Panel>
                </Border>
              </Grid>
              <!-- The resize handle: the 4px inside the right edge, a 1px hairline on it. -->
              <Border Name="PART_ResizeGrip" Width="4" HorizontalAlignment="Right" Background="Transparent">
                <Border Name="PART_Hairline" Width="1" HorizontalAlignment="Right"
                        Background="{TemplateBinding SeparatorBrush}" />
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>

        <!-- Idle: the sortable column's chevrons at half strength (shown while the grid sorts). -->
        <Style Selector="^ /template/ Border#PART_SortButton">
          <Setter Property="IsVisible" Value="{Binding CanUserSortColumns, RelativeSource={RelativeSource AncestorType=DataGrid, Tree=Visual}}" />
          <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^ /template/ PathIcon#PART_SortIcon">
          <Setter Property="Data" Value="{DynamicResource Gpui.Icon.ChevronsUpDown}" />
        </Style>
        <Style Selector="^:sortascending, ^:sortdescending">
          <Style Selector="^ /template/ Border#PART_SortButton">
            <Setter Property="Opacity" Value="1" />
          </Style>
          <Style Selector="^ /template/ PathIcon#PART_SortFaint">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
        <Style Selector="^:sortascending">
          <Style Selector="^ /template/ PathIcon#PART_SortIcon">
            <Setter Property="Data" Value="{DynamicResource Gpui.Icon.SortAscending}" />
          </Style>
          <Style Selector="^ /template/ PathIcon#PART_SortFaint">
            <Setter Property="Data" Value="{DynamicResource Gpui.Icon.SortAscending.Faint}" />
          </Style>
        </Style>
        <Style Selector="^:sortdescending">
          <Style Selector="^ /template/ PathIcon#PART_SortIcon">
            <Setter Property="Data" Value="{DynamicResource Gpui.Icon.SortDescending}" />
          </Style>
          <Style Selector="^ /template/ PathIcon#PART_SortFaint">
            <Setter Property="Data" Value="{DynamicResource Gpui.Icon.SortDescending.Faint}" />
          </Style>
        </Style>
        <!-- Hovered: secondary at full strength; pressed: secondary_active. -->
        <Style Selector="^ /template/ Border#PART_SortButton:pointerover">
          <Setter Property="Background" Value="{DynamicResource Gpui.Secondary}" />
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_SortButton:pointerover">
          <Setter Property="Background" Value="{DynamicResource Gpui.SecondaryActive}" />
        </Style>

        <Style Selector="^ /template/ Border#PART_Hairline">
          <Setter Property="IsVisible" Value="{Binding CanUserResizeColumns, RelativeSource={RelativeSource AncestorType=DataGrid, Tree=Visual}}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_ResizeGrip:pointerover > Border#PART_Hairline">
          <Setter Property="Background" Value="{DynamicResource Gpui.Border}" />
        </Style>
        <!-- The last column without a filler, and the filler itself, have no handle. -->
        <Style Selector="^[AreSeparatorsVisible=False] /template/ Border#PART_Hairline, ^:disabled /template/ Border#PART_Hairline, ^:disabled /template/ Border#PART_SortButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- A dragged header (column move): column.rs DragColumn. -->
        <Style Selector="^:dragIndicator">
          <Setter Property="Opacity" Value="0.9" />
          <Setter Property="Background" Value="{DynamicResource Gpui.TableHead}" />
          <Setter Property="Foreground" Value="{DynamicResource Gpui.MutedForeground}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="GpuiDataGridTopLeftHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Gpui.TableRowBorder}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- The row header (cell mode's 12px column): table_head with a table_row_border rule on its right. -->
      <ControlTheme x:Key="{x:Type DataGridRowHeader}" TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="{DynamicResource Gpui.TableHead}" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource Gpui.TableRowBorder}" />
        <Setter Property="AreSeparatorsVisible" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Root"
                    Background="{TemplateBinding Background}"
                    BackgroundSizing="OuterBorderEdge"
                    BorderBrush="{TemplateBinding SeparatorBrush}"
                    BorderThickness="0,0,1,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!--
        A row: its fill (stripe, hover, selected) on one element under the
        bottom grid line, so a hover replaces a stripe as GPUI's does.
      -->
      <ControlTheme x:Key="{x:Type DataGridRow}" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="RowBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <DataGridFrozenGrid Name="PART_Root" ColumnDefinitions="Auto,*" RowDefinitions="*,Auto,Auto">
                <Border Name="BackgroundRectangle" Grid.RowSpan="3" Grid.ColumnSpan="2" />
                <DataGridRowHeader Name="PART_RowHeader" Grid.RowSpan="3" DataGridFrozenGrid.IsFrozen="True" />
                <DataGridCellsPresenter Name="PART_CellsPresenter" Grid.Column="1" DataGridFrozenGrid.IsFrozen="True" />
                <DataGridDetailsPresenter Name="PART_DetailsPresenter" Grid.Row="1" Grid.Column="1" />
                <Rectangle Name="PART_BottomGridLine" Grid.Row="2" Grid.Column="1" Height="1" HorizontalAlignment="Stretch" />
              </DataGridFrozenGrid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#BackgroundRectangle">
          <Setter Property="Background" Value="{DynamicResource Gpui.TableHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#BackgroundRectangle">
          <Setter Property="Background" Value="{DynamicResource Gpui.TableActive}" />
        </Style>
      </ControlTheme>

      <!-- The stripe class's rows: every other row table_even, under hover and selection. -->
      <ControlTheme x:Key="GpuiDataGridStripeRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style Selector="^:nth-child(2n) /template/ Border#BackgroundRectangle">
          <Setter Property="Background" Value="{DynamicResource Gpui.TableEven}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#BackgroundRectangle">
          <Setter Property="Background" Value="{DynamicResource Gpui.TableHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#BackgroundRectangle">
          <Setter Property="Background" Value="{DynamicResource Gpui.TableActive}" />
        </Style>
      </ControlTheme>

      <!-- No GPUI counterpart: a plain table_head band with the group's name. -->
      <ControlTheme x:Key="{x:Type DataGridRowGroupHeader}" TargetType="DataGridRowGroupHeader">
        <Setter Property="Background" Value="{DynamicResource Gpui.TableHead}" />
        <Setter Property="Foreground" Value="{DynamicResource Gpui.TableHeadForeground}" />
        <Setter Property="Template">
          <ControlTemplate>
            <DataGridFrozenGrid Name="PART_Root" Background="{TemplateBinding Background}"
                                ColumnDefinitions="Auto,Auto,Auto,Auto,*" RowDefinitions="*,Auto">
              <Rectangle Name="PART_IndentSpacer" Grid.Column="1" />
              <ToggleButton Name="PART_ExpanderButton" Grid.Column="2" Width="12" Height="12" Margin="8,0"
                            Background="Transparent" Focusable="False">
                <ToggleButton.Template>
                  <ControlTemplate>
                    <PathIcon Width="12" Height="12" Data="{DynamicResource Gpui.Icon.ChevronRight}"
                              Foreground="{TemplateBinding Foreground}" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <TextBlock Name="PART_PropertyNameElement" IsVisible="{TemplateBinding IsPropertyNameVisible}" />
                <TextBlock x:DataType="collections:DataGridCollectionViewGroup" Text="{Binding Key}" />
                <TextBlock Name="PART_ItemCountElement" IsVisible="{TemplateBinding IsItemCountVisible}" />
              </StackPanel>
              <DataGridRowHeader Name="PART_RowHeader" Grid.RowSpan="2" DataGridFrozenGrid.IsFrozen="True" />
            </DataGridFrozenGrid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type DataGrid}" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Gpui.Table}" />
        <Setter Property="Foreground" Value="{DynamicResource Gpui.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Gpui.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5.5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextBlock.LineHeight" Value="22.5" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Gpui.TableRowBorder}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Gpui.TableRowBorder}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <!-- sizing.rs: the row height less the 1px grid line DataGrid adds under the cells. -->
        <Setter Property="RowHeight" Value="31" />
        <Setter Property="ColumnHeaderHeight" Value="31" />
        <Setter Property="RowHeaderWidth" Value="12" />
        <Setter Property="gpui:Tables.CellPadding" Value="8,4" />
        <Setter Property="gpui:Tables.TracksKeyboardFocus" Value="True" />
        <!-- state.rs: the column-move drop bar, 2px of drag_border. -->
        <Setter Property="DropLocationIndicatorTemplate">
          <Template>
            <Border Width="2" Background="{DynamicResource Gpui.DragBorder}" />
          </Template>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_Fill"
                      Background="{TemplateBinding Background}"
                      BackgroundSizing="OuterBorderEdge"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}" />
              <Grid Margin="{TemplateBinding BorderThickness}"
                    ColumnDefinitions="Auto,*,Auto"
                    RowDefinitions="Auto,Auto,*,Auto"
                    ClipToBounds="True">
                <!-- The header and its scroll area both fill with table_head, as GPUI's do. -->
                <Border Name="PART_HeaderBand" Grid.RowSpan="2" Grid.ColumnSpan="3"
                        Background="{DynamicResource Gpui.TableHead}">
                  <Border Background="{DynamicResource Gpui.TableHead}" />
                </Border>
                <DataGridColumnHeader Name="PART_TopLeftCornerHeader" Theme="{StaticResource GpuiDataGridTopLeftHeader}" />
                <DataGridColumnHeadersPresenter Name="PART_ColumnHeadersPresenter" Grid.Column="1" Grid.ColumnSpan="2" />
                <Border Name="PART_ColumnHeadersAndRowsSeparator" Grid.Row="1" Grid.ColumnSpan="3"
                        Height="1" Background="{DynamicResource Gpui.Border}" />
                <DataGridRowsPresenter Name="PART_RowsPresenter" Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="3"
                                       ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}" />
                <Panel Name="PART_BottomRightCorner" Grid.Column="2" Grid.Row="3" />
                <ScrollBar Name="PART_VerticalScrollbar" Grid.Column="2" Grid.Row="2" Orientation="Vertical"
                           AllowAutoHide="{Binding (ScrollViewer.AllowAutoHide), RelativeSource={RelativeSource TemplatedParent}}" />
                <Grid Grid.Column="1" Grid.Row="3" ColumnDefinitions="Auto,*">
                  <Panel Name="PART_FrozenColumnScrollBarSpacer" />
                  <ScrollBar Name="PART_HorizontalScrollbar" Grid.Column="1" Orientation="Horizontal"
                             AllowAutoHide="{Binding (ScrollViewer.AllowAutoHide), RelativeSource={RelativeSource TemplatedParent}}" />
                </Grid>
              </Grid>
              <!-- The border over the content, as GPUI paints it. -->
              <Border Name="PART_Border"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      IsHitTestVisible="False" />
              <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3" CornerRadius="7.5"
                      BorderBrush="{DynamicResource Gpui.FocusRing}"
                      IsVisible="False" IsHitTestVisible="False" />
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:empty-columns">
          <Style Selector="^ /template/ DataGridColumnHeadersPresenter#PART_ColumnHeadersPresenter">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ Border#PART_ColumnHeadersAndRowsSeparator">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ Border#PART_HeaderBand">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>

        <Style Selector="^.borderless">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="^.borderless /template/ Border#PART_FocusRing">
          <Setter Property="CornerRadius" Value="1.5" />
        </Style>
        <Style Selector="^[(gpui|Tables.ShowsFocusRing)=True]">
          <Setter Property="BorderBrush" Value="{DynamicResource Gpui.Ring}" />
          <Style Selector="^ /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>

        <Style Selector="^.stripe">
          <Setter Property="RowTheme" Value="{StaticResource GpuiDataGridStripeRow}" />
        </Style>
        <Style Selector="^.xsmall">
          <Setter Property="RowHeight" Value="25" />
          <Setter Property="ColumnHeaderHeight" Value="25" />
          <Setter Property="gpui:Tables.CellPadding" Value="4,2" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="TextBlock.LineHeight" Value="19.5" />
        </Style>
        <Style Selector="^.small">
          <Setter Property="RowHeight" Value="29" />
          <Setter Property="ColumnHeaderHeight" Value="29" />
          <Setter Property="gpui:Tables.CellPadding" Value="6,3" />
        </Style>
        <Style Selector="^.large">
          <Setter Property="RowHeight" Value="39" />
          <Setter Property="ColumnHeaderHeight" Value="39" />
          <Setter Property="gpui:Tables.CellPadding" Value="12,8" />
          <Setter Property="FontSize" Value="16" />
          <Setter Property="TextBlock.LineHeight" Value="26" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- A cell's text overflows from the side it is aligned to (GPUI's justified content). -->
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="DataGridCell.text-right TextBlock">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="DataGridCell.text-center TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
</Styles>
