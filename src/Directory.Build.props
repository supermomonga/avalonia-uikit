<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <Authors>supermomonga</Authors>
    <Copyright>Copyright (c) 2026 supermomonga</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://avalonia-uikit.omofla.sh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/supermomonga/avalonia-uikit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The packages carry GPUI Kit-derived styles and Lucide geometry: ship their notices (ADR 27). -->
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
