<!--
  GPUI Kit ColorPicker and ColorSelect (crates/component/src/color_picker.rs)
  -> ColorPicker (Avalonia.Controls.ColorPicker).

    <ColorPicker Color="#2563EB" Classes="small" />            the swatch
    <ColorPicker Color="#2563EB" Content="Background" />       with a label
    <ColorPicker Color="#2563EB" Classes="field" Width="200" /> ColorSelect

  The swatch is a square of the color (16, 20, 32 or 44px for xsmall, small,
  medium and large) with a border of the color darkened 30% and its hex as a
  tooltip; open, the border is 2px. The field class is ColorSelect: an input
  frame with a small swatch, the hex and a caret, ringed while focused.
  Both open a 288px popover below: the palette (the control's Palette, the
  standard FluentColorPalette by default) and the color's components on two
  segmented tabs, and the color with its hex below. GPUI's own palette, its
  featured row and its HSL sliders are not reproduced.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AvaloniaUIKit"
        xmlns:pc="using:Avalonia.Controls"
        xmlns:pconv="using:Avalonia.Controls.Converters"
        x:Class="AvaloniaUIKit.NovaColorPickerTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <x:String x:Key="UIKit.ColorPicker.Palette">Palette</x:String>
      <x:String x:Key="UIKit.ColorPicker.Components">Components</x:String>
      <pconv:DoNothingForNullConverter x:Key="UIKit.ColorPicker.KeepColor" />

      <!-- The trigger draws nothing itself: no hover, press or focus look (GPUI's has none). -->
      <ControlTheme x:Key="UIKitColorPickerTrigger" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- ColorSwatch: 20px, square, a 1px border of the color darkened 10%; no selected look. -->
      <ControlTheme x:Key="UIKitColorSwatch" TargetType="ListBoxItem" x:DataType="Color">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Swatch"
                    BorderThickness="1" BackgroundSizing="OuterBorderEdge"
                    Background="{Binding Converter={x:Static local:ColorPickerConverters.Brush}}"
                    BorderBrush="{Binding Converter={x:Static local:ColorPickerConverters.Darken10}}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Swatch">
          <Setter Property="Background" Value="{Binding Converter={x:Static local:ColorPickerConverters.Lighten10}}" />
          <Setter Property="BorderBrush" Value="{Binding Converter={x:Static local:ColorPickerConverters.Darken30}}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Swatch">
          <Setter Property="Background" Value="{Binding Converter={x:Static local:ColorPickerConverters.Darken20}}" />
          <Setter Property="BorderBrush" Value="{Binding Converter={x:Static local:ColorPickerConverters.Darken50}}" />
        </Style>
      </ControlTheme>

      <!-- A component's slider: a flat 12.8px band of the component's colors (h_2_5 of the 32px row) under GPUI's slider thumb. -->
      <ControlTheme x:Key="{x:Type ColorSlider}" TargetType="ColorSlider">
        <Setter Property="Height" Value="32" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Height="12.8" VerticalAlignment="Center">
              <!-- ColorSlider paints the component's colors as its Background, sized to the track. -->
              <Border Background="{TemplateBinding Background}" />
              <Track Name="PART_Track"
                     ClipToBounds="False"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                     Orientation="Horizontal">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Focusable="False" Theme="{DynamicResource UIKitSliderTrackButton}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Focusable="False" Theme="{DynamicResource UIKitSliderTrackButton}" />
                </Track.IncreaseButton>
                <Thumb Theme="{DynamicResource UIKitSliderThumb}" />
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ColorPicker}" TargetType="ColorPicker">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <!-- The ring is drawn outside the bounds. -->
        <Setter Property="ClipToBounds" Value="False" />
        <!-- #RRGGBBAA, as GPUI writes a translucent color. -->
        <Setter Property="HexInputAlphaPosition" Value="Trailing" />
        <Setter Property="Palette">
          <pc:FluentColorPalette />
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <!-- ColorSelect's ring: the 3px band outside the frame. -->
              <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3" CornerRadius="7.5"
                      BorderBrush="{DynamicResource UIKit.FocusRing}"
                      IsVisible="False" IsHitTestVisible="False" />
              <Button Name="PART_Trigger"
                      Theme="{StaticResource UIKitColorPickerTrigger}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft"
                          PlacementConstraintAdjustment="SlideX, SlideY"
                          FlyoutPresenterClasses="color-picker">
                    <StackPanel Margin="2" Spacing="12">
                      <TabControl Classes="segmented">
                        <TabControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </TabControl.ItemsPanel>
                        <TabItem Header="{DynamicResource UIKit.ColorPicker.Palette}">
                          <ListBox Name="PART_Palette"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Left"
                                   Background="Transparent"
                                   ItemContainerTheme="{StaticResource UIKitColorSwatch}"
                                   ItemsSource="{TemplateBinding PaletteColors}"
                                   SelectedItem="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Converter={StaticResource UIKit.ColorPicker.KeepColor}}">
                            <ListBox.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding $parent[ColorPicker].PaletteColumnCount}" ColumnSpacing="4" RowSpacing="4" />
                              </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                          </ListBox>
                        </TabItem>
                        <TabItem Header="{DynamicResource UIKit.ColorPicker.Components}">
                          <StackPanel Margin="0,12,0,0" Spacing="8">
                            <StackPanel.Styles>
                              <Style Selector="TextBlock.component">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Opacity" Value="0.7" />
                              </Style>
                            </StackPanel.Styles>
                            <Grid ColumnDefinitions="64,*,40" ColumnSpacing="8">
                              <TextBlock Classes="component" Text="{TemplateBinding ColorModel, Converter={x:Static local:ColorPickerConverters.FirstComponent}}" />
                              <ColorSlider Name="PART_Component1" Grid.Column="1" ColorComponent="Component1"
                                           ColorModel="{TemplateBinding ColorModel}"
                                           HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                              <TextBlock Classes="component" Grid.Column="2" TextAlignment="Right"
                                         Text="{Binding #PART_Component1.Value, StringFormat={}{0:0}}" />
                            </Grid>
                            <Grid ColumnDefinitions="64,*,40" ColumnSpacing="8">
                              <TextBlock Classes="component" Text="{TemplateBinding ColorModel, Converter={x:Static local:ColorPickerConverters.SecondComponent}}" />
                              <ColorSlider Name="PART_Component2" Grid.Column="1" ColorComponent="Component2"
                                           ColorModel="{TemplateBinding ColorModel}"
                                           HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                              <TextBlock Classes="component" Grid.Column="2" TextAlignment="Right"
                                         Text="{Binding #PART_Component2.Value, StringFormat={}{0:0}}" />
                            </Grid>
                            <Grid ColumnDefinitions="64,*,40" ColumnSpacing="8">
                              <TextBlock Classes="component" Text="{TemplateBinding ColorModel, Converter={x:Static local:ColorPickerConverters.ThirdComponent}}" />
                              <ColorSlider Name="PART_Component3" Grid.Column="1" ColorComponent="Component3"
                                           ColorModel="{TemplateBinding ColorModel}"
                                           HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                              <TextBlock Classes="component" Grid.Column="2" TextAlignment="Right"
                                         Text="{Binding #PART_Component3.Value, StringFormat={}{0:0}}" />
                            </Grid>
                            <Grid ColumnDefinitions="64,*,40" ColumnSpacing="8"
                                  IsVisible="{TemplateBinding IsAlphaVisible}">
                              <TextBlock Classes="component" Text="Alpha" />
                              <ColorSlider Name="PART_Alpha" Grid.Column="1" ColorComponent="Alpha"
                                           ColorModel="{TemplateBinding ColorModel}"
                                           IsEnabled="{TemplateBinding IsAlphaEnabled}"
                                           HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                              <TextBlock Classes="component" Grid.Column="2" TextAlignment="Right"
                                         Text="{Binding #PART_Alpha.Value, StringFormat={}{0:0}}" />
                            </Grid>
                          </StackPanel>
                        </TabItem>
                      </TabControl>
                      <Separator />
                      <!-- The color, and its hex to edit (small input, 10px in). -->
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Border Width="20" Height="20" BorderThickness="1" CornerRadius="5.5" BackgroundSizing="OuterBorderEdge"
                                VerticalAlignment="Center"
                                Background="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:ColorPickerConverters.Brush}}"
                                BorderBrush="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:ColorPickerConverters.Darken20}}" />
                        <TextBox Name="PART_HexTextBox" Grid.Column="1" Classes="small"
                                 HorizontalAlignment="Stretch" Padding="0,0,10,0">
                          <TextBox.InnerLeftContent>
                            <TextBlock Text="#" VerticalAlignment="Center" Margin="10,0,0,0" />
                          </TextBox.InnerLeftContent>
                        </TextBox>
                      </Grid>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
                <Panel>
                  <!-- ColorPicker: the swatch, and the label 8px after it. -->
                  <StackPanel Name="PART_SwatchLook" Orientation="Horizontal" Spacing="8">
                    <Border Name="PART_Swatch"
                            Width="32" Height="32" BorderThickness="1" CornerRadius="5.5" BackgroundSizing="OuterBorderEdge"
                            VerticalAlignment="Center"
                            Background="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:ColorPickerConverters.Brush}}"
                            BorderBrush="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:ColorPickerConverters.Darken30}}"
                            ToolTip.Tip="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:ColorPickerConverters.Hex}}" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      VerticalAlignment="Center"
                                      FontSize="16"
                                      LineHeight="26"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <!-- ColorSelect: an input frame with the swatch, the hex and the caret, 8px apart. -->
                  <Border Name="PART_Frame"
                          IsVisible="False" BackgroundSizing="OuterBorderEdge"
                          Height="32" Padding="10,0"
                          BorderThickness="1" CornerRadius="5.5"
                          Background="{DynamicResource UIKit.InputBackground}"
                          BorderBrush="{DynamicResource UIKit.Input}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <Border Name="PART_FieldSwatch"
                              Width="16" Height="16" BorderThickness="1" CornerRadius="2.5" BackgroundSizing="OuterBorderEdge"
                              VerticalAlignment="Center"
                              Background="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:ColorPickerConverters.Brush}}"
                              BorderBrush="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:ColorPickerConverters.Darken30}}" />
                      <TextBlock Name="PART_FieldText" Grid.Column="1"
                                 VerticalAlignment="Center"
                                 FontSize="14" LineHeight="22.5"
                                 Text="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:ColorPickerConverters.Hex}}" />
                      <PathIcon Name="PART_Caret" Grid.Column="2"
                                Width="16" Height="16"
                                Data="{DynamicResource UIKit.Icon.ChevronDown}"
                                Foreground="{DynamicResource UIKit.MutedForeground}" />
                    </Grid>
                  </Border>
                </Panel>
              </Button>
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- The swatch's sizes (size_with) and its 2px border while open. -->
        <Style Selector="^.xsmall /template/ Border#PART_Swatch">
          <Setter Property="Width" Value="16" />
          <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="^.small /template/ Border#PART_Swatch">
          <Setter Property="Width" Value="20" />
          <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="^.large /template/ Border#PART_Swatch">
          <Setter Property="Width" Value="44" />
          <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="^ /template/ Button#PART_Trigger:flyout-open Border#PART_Swatch">
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="CornerRadius" Value="5" />
        </Style>

        <!-- ColorSelect. -->
        <Style Selector="^.field">
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Style Selector="^ /template/ StackPanel#PART_SwatchLook">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ Border#PART_Frame">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^:focus-within /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^:focus-within /template/ Border#PART_Frame">
            <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Ring}" />
          </Style>
          <!-- input_size / input_text_size and the swatch and caret sizes. -->
          <Style Selector="^.xsmall">
            <Style Selector="^ /template/ Border#PART_Frame">
              <Setter Property="Height" Value="20" />
              <Setter Property="Padding" Value="4,0" />
            </Style>
            <Style Selector="^ /template/ Border#PART_FieldSwatch">
              <Setter Property="Width" Value="12" />
              <Setter Property="Height" Value="12" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_FieldText">
              <Setter Property="FontSize" Value="12" />
              <Setter Property="LineHeight" Value="19.5" />
            </Style>
            <Style Selector="^ /template/ PathIcon#PART_Caret">
              <Setter Property="Width" Value="12" />
              <Setter Property="Height" Value="12" />
            </Style>
          </Style>
          <Style Selector="^.small">
            <Style Selector="^ /template/ Border#PART_Frame">
              <Setter Property="Height" Value="24" />
              <Setter Property="Padding" Value="8,0" />
            </Style>
            <Style Selector="^ /template/ Border#PART_FieldSwatch">
              <Setter Property="Width" Value="14" />
              <Setter Property="Height" Value="14" />
            </Style>
            <Style Selector="^ /template/ PathIcon#PART_Caret">
              <Setter Property="Width" Value="14" />
              <Setter Property="Height" Value="14" />
            </Style>
          </Style>
          <Style Selector="^.large">
            <Style Selector="^ /template/ Border#PART_Frame">
              <Setter Property="Height" Value="44" />
              <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style Selector="^ /template/ Border#PART_FieldSwatch">
              <Setter Property="Width" Value="20" />
              <Setter Property="Height" Value="20" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_FieldText">
              <Setter Property="FontSize" Value="16" />
              <Setter Property="LineHeight" Value="26" />
            </Style>
          </Style>
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Popover.w_72: the popover is 288px wide. -->
  <Style Selector="FlyoutPresenter.color-picker">
    <Setter Property="Width" Value="288" />
  </Style>
</Styles>
