<Project>
  <!-- The <UIKitIcon> items, as a property the generator can read (AvaloniaUIKit.props). -->
  <Target Name="_UIKitIconList" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
    <PropertyGroup>
      <_UIKitIconList>@(UIKitIcon)</_UIKitIconList>
    </PropertyGroup>
  </Target>
</Project>
