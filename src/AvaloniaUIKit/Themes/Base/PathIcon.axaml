<!--
  PathIcon draws the Lucide outlines in Icons/Lucide.g.axaml. Their geometry
  spans the full 24x24 icon box, so the Viewbox scales them exactly as GPUI
  scales an icon's SVG (crates/component/src/icon.rs). The default size is
  16px, GPUI's Size::Medium icon; the classes xsmall, small and large give
  Icon::xsmall/small/large (12, 14 and 24px). The color is the Foreground.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="{x:Type PathIcon}" TargetType="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Viewbox Stretch="Uniform">
            <Path Fill="{TemplateBinding Foreground}" Data="{TemplateBinding Data}" />
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.xsmall">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
