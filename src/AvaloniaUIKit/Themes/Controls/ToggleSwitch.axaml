<!--
  GPUI Kit Switch -> ToggleSwitch (crates/component/src/switch.rs).
  Classes: xsmall small large (medium is the default); label-left.

  The track is 28x16 / 36x20 / 44x24 with a 1px transparent border and 1px
  padding around the thumb. PART_SwitchKnob is the thumb's travel (track width
  - thumb - 4), so ToggleSwitch moves PART_MovingKnobs to 0 or the travel.
  The thumb moves with GPUI's `spring_move` (response 280ms, damping 0.85,
  epsilon 0.1px) through Motion.Spring, which keeps its velocity when the
  switch is toggled back mid-flight. While the thumb is dragged it follows the
  pointer at once (Spring::with_travel(false) in GPUI's terms).
  Unlike a button, a pointer press focuses a switch, so its ring shows on :focus.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit">
  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <!-- The thumb moves through Motion.Spring instead (see PART_MovingKnobs). -->
    <Setter Property="KnobTransitions">
      <Transitions />
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel Background="{TemplateBinding Background}">
          <Panel Name="PART_TrackArea" DockPanel.Dock="Left" VerticalAlignment="Top">
            <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3" CornerRadius="11.5"
                    BorderBrush="{DynamicResource UIKit.FocusRing}" IsVisible="False" IsHitTestVisible="False" />
            <Border Name="PART_Track" Width="36" Height="20" BorderThickness="1" Padding="1"
                    CornerRadius="9.5" BackgroundSizing="OuterBorderEdge"
                    BorderBrush="Transparent" Background="{DynamicResource UIKit.Switch}">
              <Canvas Name="PART_SwitchKnob" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Panel Name="PART_MovingKnobs" Width="16" Height="16"
                       uikit:Motion.Spring="{StaticResource UIKit.Spring.Move}" uikit:Motion.SpringsCanvasLeft="True">
                  <Border Name="PART_Thumb" CornerRadius="8" Background="{DynamicResource UIKit.SwitchThumb}" />
                </Panel>
              </Canvas>
            </Border>
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Margin="8,0,0,0"
                            IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" LineHeight="20" RecognizesAccessKey="True" />
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <!-- Size::XSmall and Size::Small share the 28x16 track; the label text differs. -->
    <Style Selector="^.xsmall, ^.small">
    </Style>
    <Style Selector="^.xsmall">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^.xsmall /template/ Border#PART_Track, ^.small /template/ Border#PART_Track">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="7.5" />
    </Style>
    <Style Selector="^.xsmall /template/ Canvas#PART_SwitchKnob, ^.small /template/ Canvas#PART_SwitchKnob">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="^.xsmall /template/ Panel#PART_MovingKnobs, ^.small /template/ Panel#PART_MovingKnobs">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="^.xsmall /template/ Border#PART_Thumb, ^.small /template/ Border#PART_Thumb">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="^.xsmall /template/ Border#PART_FocusRing, ^.small /template/ Border#PART_FocusRing">
      <Setter Property="CornerRadius" Value="9.5" />
    </Style>
    <Style Selector="^.xsmall /template/ ContentPresenter#PART_ContentPresenter, ^.small /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style Selector="^.large">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="^.large /template/ Border#PART_Track">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="11.5" />
    </Style>
    <Style Selector="^.large /template/ Canvas#PART_SwitchKnob">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="^.large /template/ Panel#PART_MovingKnobs">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="^.large /template/ Border#PART_Thumb">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="^.large /template/ Border#PART_FocusRing">
      <Setter Property="CornerRadius" Value="13.5" />
    </Style>
    <Style Selector="^.large /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="24" />
    </Style>

    <!-- Side::Left puts the label first (flex_row_reverse). -->
    <Style Selector="^.label-left /template/ Panel#PART_TrackArea">
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
    <Style Selector="^.label-left /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style Selector="^:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource UIKit.Primary}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource UIKit.Switch.Disabled.Track}" />
    </Style>
    <Style Selector="^:disabled:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource UIKit.Switch.Disabled.CheckedTrack}" />
    </Style>
    <Style Selector="^:focus /template/ Border#PART_Track">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Ring}" />
    </Style>
    <Style Selector="^:focus /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:dragging /template/ Panel#PART_MovingKnobs">
      <Setter Property="uikit:Motion.SpringTravel" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
