<!--
  GPUI Kit Tooltip -> ToolTip (crates/component/src/tooltip.rs; timing in
  crates/base/src/tooltip.rs).

  The bubble is the popover background with a 1px border, the theme radius,
  GPUI's shadow_md (sigma 6 and 4: Avalonia blur 19.0526 and 12.1244), 2px by
  8px of padding and 14px text on GPUI's default phi line (22.65px, which
  GPUI's edge snapping renders as a 28.5px bubble: the line is 22.5 here). It keeps a 12px
  margin (m_3) and opens above its trigger, centered, 10.5px from it as GPUI
  places it. It fades in and slides up 4px over 150ms with ease-out-cubic.
  GPUI shows a tooltip after 500ms; NovaTheme sets ToolTip.ShowDelay and the
  placement on every control.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <BoxShadows x:Key="UIKit.Shadow.Md">0 4 19.0526 -1 #1A000000, 0 2 12.1244 -2 #1A000000</BoxShadows>

  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource UIKit.Popover}" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.PopoverForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5.5" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="{DynamicResource UIKit.FontFamily}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Motion" Margin="12">
          <Panel.RenderTransform>
            <TranslateTransform />
          </Panel.RenderTransform>
          <Border Name="PART_Shadow" CornerRadius="6" BoxShadow="{StaticResource UIKit.Shadow.Md}" IsHitTestVisible="False" />
          <Border Name="PART_LayoutRoot"
                  BackgroundSizing="OuterBorderEdge"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              LineHeight="22.5" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:open /template/ Panel#PART_Motion">
      <Style.Animations>
        <Animation Duration="0:0:0.15" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="4" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
