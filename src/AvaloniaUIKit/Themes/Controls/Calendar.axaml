<!--
  GPUI Kit Calendar (crates/component/src/time/calendar.rs) -> Calendar,
  CalendarItem, CalendarDayButton and CalendarButton:

    <Calendar SelectedDate="2025-03-14" FirstDayOfWeek="Sunday" Classes="small" />

  A bordered card (radius_lg, 12px of padding): a header with the previous and
  next buttons and the month and year as two items between them, spaced
  evenly; the weekday titles (muted, at half strength); the days. Day states:
  outside the month muted, today accent, hovered secondary_hover, selected
  primary, blackout muted at half strength without a hover. The months grid
  (DisplayMode Year) has GPUI's three columns of full month names, its month
  item primary. Sizes: small (28px cells, 220 wide), medium (32, 248), large
  (40, 304). GPUI shows only the weeks a month needs where Avalonia always
  shows six, and its years grid has twenty years where Avalonia's decade has
  twelve; Avalonia's header acts as one button.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uikit="using:AvaloniaUIKit"
        xmlns:gconv="using:AvaloniaUIKit.Converters">
  <Styles.Resources>
    <!-- The previous and next buttons: a square cell around a 16px chevron. -->
    <ControlTheme x:Key="UIKitCalendarNavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource UIKit.SecondaryHover}" />
      </Style>
    </ControlTheme>

    <!--
      The header: GPUI's month and year items, spaced evenly between the
      previous and next buttons (justify_between). They show the displayed
      date, whatever Avalonia writes into the button.
    -->
    <ControlTheme x:Key="UIKitCalendarHeaderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="*,Auto,*,Auto,*" Background="Transparent">
            <Border Name="PART_MonthPill" Grid.Column="1" Background="Transparent" Padding="8,0" CornerRadius="6" Height="32">
              <TextBlock VerticalAlignment="Center" LineHeight="22.5"
                         Text="{Binding $parent[Calendar].DisplayDate, Converter={x:Static gconv:CalendarConverters.MonthName}}" />
            </Border>
            <Border Name="PART_YearPill" Grid.Column="3" Background="Transparent" Padding="8,0" CornerRadius="6" Height="32">
              <TextBlock VerticalAlignment="Center" LineHeight="22.5"
                         Text="{Binding $parent[Calendar].DisplayDate, Converter={x:Static gconv:CalendarConverters.Year}}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Border#PART_MonthPill:pointerover, ^ /template/ Border#PART_YearPill:pointerover">
        <Setter Property="Background" Value="{DynamicResource UIKit.SecondaryHover}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">
      <Setter Property="DayTitleTemplate">
        <Template x:DataType="x:String">
          <TextBlock Classes="uikit-calendar-weekday" Text="{Binding}" />
        </Template>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid RowDefinitions="Auto,2,Auto">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Name="PART_PreviousButton" Theme="{StaticResource UIKitCalendarNavButton}">
                  <PathIcon Data="{StaticResource UIKit.Icon.ChevronLeft}" />
                </Button>
                <Button Name="PART_HeaderButton" Grid.Column="1" Theme="{StaticResource UIKitCalendarHeaderButton}" />
                <Button Name="PART_NextButton" Grid.Column="2" Theme="{StaticResource UIKitCalendarNavButton}">
                  <PathIcon Data="{StaticResource UIKit.Icon.ChevronRight}" />
                </Button>
              </Grid>
              <!-- Seven cells overflow GPUI's content box by 2px on the right. -->
              <Grid Name="PART_MonthView" Grid.Row="2" IsVisible="False" Margin="0,0,-2,0"
                    HorizontalAlignment="Left"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" />
              <Grid Name="PART_YearView" Grid.Row="2" IsVisible="False"
                    uikit:CalendarGrid.Columns="3" ColumnSpacing="4"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnDefinitions="*,*,*" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar">
      <Setter Property="Width" Value="248" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7.5" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Name="PART_Root">
            <CalendarItem Name="PART_CalendarItem"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.small">
        <Setter Property="Width" Value="220" />
      </Style>
      <Style Selector="^.large">
        <Setter Property="Width" Value="304" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextBlock.LineHeight" Value="22.5" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <!-- Later wins: hover only on a day that is neither selected nor blacked out. -->
      <Style Selector="^:inactive">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
      </Style>
      <Style Selector="^:today">
        <Setter Property="Background" Value="{DynamicResource UIKit.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource UIKit.AccentForeground}" />
      </Style>
      <Style Selector="^:pointerover:not(:selected):not(:blackout)">
        <Setter Property="Background" Value="{DynamicResource UIKit.SecondaryHover}" />
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{DynamicResource UIKit.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource UIKit.PrimaryForeground}" />
      </Style>
      <Style Selector="^:blackout">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Calendar.Disabled}" />
      </Style>
    </ControlTheme>

    <!-- A months (or years) grid item: the cell's height and radius, the column's width. -->
    <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextBlock.LineHeight" Value="19.5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}">
              <TextBlock.Text>
                <MultiBinding Converter="{x:Static gconv:CalendarConverters.GridButtonText}">
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="DataContext" />
                  <Binding Path="$parent[Calendar].DisplayMode" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:inactive">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
      </Style>
      <Style Selector="^:pointerover:not(:selected)">
        <Setter Property="Background" Value="{DynamicResource UIKit.SecondaryHover}" />
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{DynamicResource UIKit.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource UIKit.PrimaryForeground}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- Weekday titles: a cell of muted text at half strength. -->
  <Style Selector="TextBlock.uikit-calendar-weekday">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Calendar.Weekday}" />
  </Style>
  <!-- The month item stays primary while the months grid shows. -->
  <Style Selector="Calendar[DisplayMode=Year] Button /template/ Border#PART_MonthPill, Calendar[DisplayMode=Decade] Button /template/ Border#PART_YearPill">
    <Setter Property="Background" Value="{DynamicResource UIKit.Primary}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource UIKit.PrimaryForeground}" />
  </Style>
  <!-- Decade mode disables the header button; it keeps its look. -->

  <!-- small: 28px cells, radius 3, 12px days (also a small date picker's calendar). -->
  <Style Selector="Calendar.small CalendarDayButton, Calendar.small TextBlock.uikit-calendar-weekday, CalendarDatePicker.small CalendarDayButton, CalendarDatePicker.small TextBlock.uikit-calendar-weekday">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="Calendar.small TextBlock.uikit-calendar-weekday, CalendarDatePicker.small TextBlock.uikit-calendar-weekday">
    <Setter Property="LineHeight" Value="28" />
  </Style>
  <Style Selector="Calendar.small CalendarDayButton, CalendarDatePicker.small CalendarDayButton">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextBlock.LineHeight" Value="19.5" />
  </Style>
  <Style Selector="Calendar.small CalendarButton, CalendarDatePicker.small CalendarButton">
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Calendar.small CalendarItem Button, CalendarDatePicker.small CalendarItem Button">
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Calendar.small CalendarItem Button#PART_PreviousButton, Calendar.small CalendarItem Button#PART_NextButton, CalendarDatePicker.small CalendarItem Button#PART_PreviousButton, CalendarDatePicker.small CalendarItem Button#PART_NextButton">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="Calendar.small Button /template/ Border#PART_MonthPill, Calendar.small Button /template/ Border#PART_YearPill, CalendarDatePicker.small Button /template/ Border#PART_MonthPill, CalendarDatePicker.small Button /template/ Border#PART_YearPill">
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <!-- large: 40px cells, radius 12. -->
  <Style Selector="Calendar.large CalendarDayButton, Calendar.large TextBlock.uikit-calendar-weekday, CalendarDatePicker.large CalendarDayButton, CalendarDatePicker.large TextBlock.uikit-calendar-weekday">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
  </Style>
  <Style Selector="Calendar.large TextBlock.uikit-calendar-weekday, CalendarDatePicker.large TextBlock.uikit-calendar-weekday">
    <Setter Property="LineHeight" Value="40" />
  </Style>
  <Style Selector="Calendar.large CalendarDayButton, CalendarDatePicker.large CalendarDayButton">
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Calendar.large CalendarButton, CalendarDatePicker.large CalendarButton">
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Calendar.large CalendarItem Button#PART_PreviousButton, Calendar.large CalendarItem Button#PART_NextButton, CalendarDatePicker.large CalendarItem Button#PART_PreviousButton, CalendarDatePicker.large CalendarItem Button#PART_NextButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Calendar.large Button /template/ Border#PART_MonthPill, Calendar.large Button /template/ Border#PART_YearPill, CalendarDatePicker.large Button /template/ Border#PART_MonthPill, CalendarDatePicker.large Button /template/ Border#PART_YearPill">
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
</Styles>
