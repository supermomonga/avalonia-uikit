<!--
  GPUI Kit Combobox's look for Avalonia's AutoCompleteBox (filtering as you
  type): the input frame as its text field (the TextBox theme), and the
  suggestions in GPUI's dropdown popup, as ComboBox draws it (6px below, as
  wide as the field, the popover surface, ring and shadows, the enter motion,
  rounded rows). AutoCompleteBox's cursor is its selected suggestion, so that
  row shows the accent; rows keep the check mark's slot without the mark.
  Classes: xsmall small large (medium is the default).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="GpuiDropdownItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Gpui.Foreground}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              VerticalAlignment="Center"
                              LineHeight="22.5"
                              TextTrimming="CharacterEllipsis" />
            <Panel Grid.Column="1" Width="12" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Gpui.Select.Row.Hover}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource Gpui.Accent}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Gpui.MutedForeground}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="GpuiDropdownListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource GpuiDropdownItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollViewer Name="PART_ScrollViewer"
                      HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                      VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                      IsScrollChainingEnabled="False">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}" />
        </ScrollViewer>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type AutoCompleteBox}" TargetType="AutoCompleteBox">
    <Setter Property="Foreground" Value="{DynamicResource Gpui.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource Gpui.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Gpui.Input}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5.5" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Gpui.MutedForeground}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <TextBox Name="PART_TextBox"
                   PlaceholderText="{TemplateBinding PlaceholderText}"
                   PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                   Width="{TemplateBinding Width}"
                   Foreground="{TemplateBinding Foreground}"
                   Background="{TemplateBinding Background}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="{TemplateBinding BorderThickness}"
                   CornerRadius="{TemplateBinding CornerRadius}"
                   CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                   ClearSelectionOnLostFocus="{TemplateBinding ClearSelectionOnLostFocus}"
                   Padding="{TemplateBinding Padding}"
                   FontSize="{TemplateBinding FontSize}"
                   DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                   MaxLength="{TemplateBinding MaxLength}"
                   InnerLeftContent="{TemplateBinding InnerLeftContent}"
                   InnerRightContent="{TemplateBinding InnerRightContent}" />
          <Popup Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 IsLightDismissEnabled="True"
                 Placement="BottomEdgeAlignedLeft"
                 PlacementTarget="{Binding #PART_TextBox}"
                 InheritsTransform="True">
            <Border Padding="0,6" ClipToBounds="False">
              <Panel Name="PART_PopupMotion"
                     Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}">
                <Panel.RenderTransform>
                  <TranslateTransform />
                </Panel.RenderTransform>
                <Border Name="PART_PopupRing" Margin="-1" CornerRadius="6"
                        Background="{DynamicResource Gpui.PopoverRing}" IsHitTestVisible="False" />
                <Border Name="PART_PopupShadow" CornerRadius="6"
                        BoxShadow="{StaticResource Gpui.Shadow.Popover}" IsHitTestVisible="False" />
                <Border Name="PART_PopupSurface" CornerRadius="6" ClipToBounds="True"
                        Background="{DynamicResource Gpui.Popover}"
                        TextElement.Foreground="{DynamicResource Gpui.PopoverForeground}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ListBox Name="PART_SelectingItemsControl"
                           Theme="{StaticResource GpuiDropdownListBox}"
                           ItemTemplate="{TemplateBinding ItemTemplate}" />
                </Border>
              </Panel>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.xsmall /template/ TextBox#PART_TextBox">
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="^.xsmall">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^.small /template/ TextBox#PART_TextBox">
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="^.large /template/ TextBox#PART_TextBox">
      <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="16" />
    </Style>

    <Style Selector="^[IsDropDownOpen=True] /template/ TextBox#PART_TextBox">
      <Setter Property="BorderBrush" Value="{DynamicResource Gpui.Ring}" />
    </Style>

    <!-- dropdown_popup, as ComboBox. -->
    <Style Selector="^[IsDropDownOpen=True] /template/ Panel#PART_PopupMotion">
      <Style.Animations>
        <Animation Duration="0:0:0.15" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^[IsDropDownOpen=True] /template/ Border#PART_PopupRing, ^[IsDropDownOpen=True] /template/ Border#PART_PopupShadow">
      <Style.Animations>
        <Animation Duration="0:0:0.15" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.001" /></KeyFrame>
          <KeyFrame Cue="20%"><Setter Property="Opacity" Value="0.008" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="0.027" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="0.064" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.125" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="Opacity" Value="0.216" /></KeyFrame>
          <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.343" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="Opacity" Value="0.512" /></KeyFrame>
          <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.729" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
