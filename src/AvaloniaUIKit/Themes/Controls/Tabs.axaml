        <Setter Property="Spacing" Value="0" />
      </Style>
      <Style Selector="^:not(.outline):not(.pill):not(.segmented):not(.underline).large /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="0" />
      </Style>
      <Style Selector="^.outline /template/ Border#PART_Baseline">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^.outline /template/ Border#PART_Bar">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^.outline /template/ Border#PART_IndicatorFill">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^.outline.xsmall /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="8" />
      </Style>
      <Style Selector="^.outline.small /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="8" />
      </Style>
      <Style Selector="^.outline:not(.xsmall):not(.small):not(.large) /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="12" />
      </Style>
      <Style Selector="^.outline.large /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="16" />
      </Style>
      <Style Selector="^.pill /template/ Border#PART_Baseline">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^.pill /template/ Border#PART_Bar">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^.pill /template/ Border#PART_IndicatorFill">
        <Setter Property="Background" Value="{DynamicResource UIKit.Primary.Fill}" />
      </Style>
      <Style Selector="^.pill.xsmall /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="4" />
      </Style>
      <Style Selector="^.pill.xsmall /template/ Border#PART_IndicatorFill">
        <Setter Property="CornerRadius" Value="10" />
      </Style>
      <Style Selector="^.pill.small /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="4" />
      </Style>
      <Style Selector="^.pill.small /template/ Border#PART_IndicatorFill">
        <Setter Property="CornerRadius" Value="12" />
      </Style>
      <Style Selector="^.pill:not(.xsmall):not(.small):not(.large) /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="4" />
      </Style>
      <Style Selector="^.pill:not(.xsmall):not(.small):not(.large) /template/ Border#PART_IndicatorFill">
        <Setter Property="CornerRadius" Value="16" />
      </Style>
      <Style Selector="^.pill.large /template/ StackPanel#PART_TabsPanel">
