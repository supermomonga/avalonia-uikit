      <Style Selector="^.segmented /template/ Border#PART_Bar">
        <Setter Property="Background" Value="{DynamicResource UIKit.TabBarSegmented}" />
      </Style>
      <Style Selector="^.segmented /template/ Border#PART_IndicatorFill">
        <Setter Property="Background" Value="{DynamicResource UIKit.Background}" />
        <Setter Property="BoxShadow" Value="{StaticResource UIKit.Shadow.Raised}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^.segmented.xsmall /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="2" />
      </Style>
      <Style Selector="^.segmented.xsmall /template/ Border#PART_Bar">
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style Selector="^.segmented.xsmall /template/ Border#PART_IndicatorFill">
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <Style Selector="^.segmented.small /template/ StackPanel#PART_TabsPanel">
        <Setter Property="Spacing" Value="2" />
      </Style>
      <Style Selector="^.segmented.small /template/ Border#PART_Bar">
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style Selector="^.segmented.small /template/ Border#PART_IndicatorFill">
