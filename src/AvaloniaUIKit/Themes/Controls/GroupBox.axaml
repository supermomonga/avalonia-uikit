<!--
  GPUI Kit GroupBox -> GroupBox (crates/component/src/group_box.rs).
  Classes: fill, outline (normal is the default).

  The title is muted on a 1.25 line; the surface follows 16px below it (12px
  for fill and outline). Fill paints the group_box token and outline a 1px
  border; both pad the content by 16px. GPUI text without a line height of
  its own uses phi (1.618) of its size, which the content keeps here.
  The footer is out of scope (GroupBox has no slot for it).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="{x:Type GroupBox}" TargetType="GroupBox">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.GroupBoxForeground}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <ContentPresenter Name="PART_HeaderPresenter" DockPanel.Dock="Top"
                            Margin="0,0,0,16"
                            IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{DynamicResource UIKit.MutedForeground}"
                            LineHeight="20" />
          <ContentPresenter Name="PART_ContentPresenter"
                            BackgroundSizing="OuterBorderEdge"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            LineHeight="25.8885" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.fill">
      <Setter Property="Background" Value="{DynamicResource UIKit.GroupBox}" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="^.outline">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5.5" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="^.fill /template/ ContentPresenter#PART_HeaderPresenter, ^.outline /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
