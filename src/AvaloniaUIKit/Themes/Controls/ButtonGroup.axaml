<!--
  GPUI Kit ButtonGroup (crates/component/src/button/button_group.rs) ->
  Buttons in a StackPanel with the button-group class (Spacing 0):

    <StackPanel Classes="button-group" Orientation="Horizontal">
      <Button Classes="outline" Content="One" />
      ...

  The buttons keep their own variant, size and state looks. Grouped, only the
  first and last keep their outer corners, and every later button drops the
  edge it shares with the one before (one 1px divider; borderless variants
  have no edge to drop). The focus ring follows the button's corners.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Controls.Converters"
        xmlns:gconv="using:AvaloniaUIKit.Converters">
  <Styles.Resources>
    <conv:CornerRadiusFilterConverter x:Key="UIKit.Corners.Left" Filter="TopLeft, BottomLeft" />
    <conv:CornerRadiusFilterConverter x:Key="UIKit.Corners.Right" Filter="TopRight, BottomRight" />
    <conv:CornerRadiusFilterConverter x:Key="UIKit.Corners.Top" Filter="TopLeft, TopRight" />
    <conv:CornerRadiusFilterConverter x:Key="UIKit.Corners.Bottom" Filter="BottomLeft, BottomRight" />
    <gconv:ThicknessFilterConverter x:Key="UIKit.Sides.NoLeft" Filter="Top, Right, Bottom" />
    <gconv:ThicknessFilterConverter x:Key="UIKit.Sides.NoTop" Filter="Left, Right, Bottom" />
  </Styles.Resources>

  <!-- Corners: the first and last keep the group's outer ones, the middle none. -->
  <Style Selector="StackPanel.button-group[Orientation=Horizontal] > Button:nth-child(1):not(:nth-last-child(1)) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius, Converter={StaticResource UIKit.Corners.Left}}" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Horizontal] > Button:nth-last-child(1):not(:nth-child(1)) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius, Converter={StaticResource UIKit.Corners.Right}}" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Vertical] > Button:nth-child(1):not(:nth-last-child(1)) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius, Converter={StaticResource UIKit.Corners.Top}}" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Vertical] > Button:nth-last-child(1):not(:nth-child(1)) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius, Converter={StaticResource UIKit.Corners.Bottom}}" />
  </Style>
  <Style Selector="StackPanel.button-group > Button:not(:nth-child(1)):not(:nth-last-child(1)) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Edges: every later button drops the one it shares with the previous button. -->
  <Style Selector="StackPanel.button-group[Orientation=Horizontal] > Button:not(:nth-child(1)) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="{Binding $parent[Button].BorderThickness, Converter={StaticResource UIKit.Sides.NoLeft}}" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Vertical] > Button:not(:nth-child(1)) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="{Binding $parent[Button].BorderThickness, Converter={StaticResource UIKit.Sides.NoTop}}" />
  </Style>

  <!--
    The ring's corners are the button's plus 3 (Border thickness 3: radius
    r + 1.5), 1.5 where the button's corner is square.
  -->
  <Style Selector="StackPanel.button-group[Orientation=Horizontal] > Button:nth-child(1):not(:nth-last-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="7.5,1.5,1.5,7.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Horizontal] > Button:nth-last-child(1):not(:nth-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5,7.5,7.5,1.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Vertical] > Button:nth-child(1):not(:nth-last-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="7.5,7.5,1.5,1.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Vertical] > Button:nth-last-child(1):not(:nth-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5,1.5,7.5,7.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Horizontal] > Button.rounded-small:nth-child(1):not(:nth-last-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="4.5,1.5,1.5,4.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Horizontal] > Button.rounded-small:nth-last-child(1):not(:nth-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5,4.5,4.5,1.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Vertical] > Button.rounded-small:nth-child(1):not(:nth-last-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="4.5,4.5,1.5,1.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Vertical] > Button.rounded-small:nth-last-child(1):not(:nth-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5,1.5,4.5,4.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Horizontal] > Button.rounded-large:nth-child(1):not(:nth-last-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="13.5,1.5,1.5,13.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Horizontal] > Button.rounded-large:nth-last-child(1):not(:nth-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5,13.5,13.5,1.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Vertical] > Button.rounded-large:nth-child(1):not(:nth-last-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="13.5,13.5,1.5,1.5" />
  </Style>
  <Style Selector="StackPanel.button-group[Orientation=Vertical] > Button.rounded-large:nth-last-child(1):not(:nth-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5,1.5,13.5,13.5" />
  </Style>
  <Style Selector="StackPanel.button-group > Button.rounded-none /template/ Border#PART_FocusRing, StackPanel.button-group > Button:not(:nth-child(1)):not(:nth-last-child(1)) /template/ Border#PART_FocusRing">
    <Setter Property="CornerRadius" Value="1.5" />
  </Style>
</Styles>
