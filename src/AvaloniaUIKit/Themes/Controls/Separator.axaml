<!--
  GPUI Kit Separator -> Separator (crates/component/src/separator.rs).
  A 1px line in the border color, centered on a box of no thickness: GPUI
  places the line absolutely in a zero-height (or zero-width) flex box, so it
  straddles the boundary between its neighbors without taking space.
  Classes: vertical, dashed (a [4, 2] dash).
  Inside a menu a separator is PopupMenuItem::Separator instead: a 2px line
  that runs to the surface edge with 2px above and below (see GpuiTheme.axaml).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Gpui.Border}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,-0.5" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^.vertical">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Margin" Value="-0.5,0" />
    </Style>
    <!-- PathBuilder::stroke(1px).dash_array([4, 2]): a 6px tile, 4px drawn. -->
    <Style Selector="^.dashed">
      <Setter Property="Template">
        <ControlTemplate>
          <Rectangle>
            <Rectangle.Fill>
              <VisualBrush TileMode="Tile" Stretch="None" AlignmentX="Left" AlignmentY="Top"
                           DestinationRect="0,0,6,1" SourceRect="0,0,6,1">
                <VisualBrush.Visual>
                  <Canvas Width="6" Height="1">
                    <Rectangle Width="4" Height="1" Fill="{Binding $parent[Separator].Background}" />
                  </Canvas>
                </VisualBrush.Visual>
              </VisualBrush>
            </Rectangle.Fill>
          </Rectangle>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^.vertical.dashed">
      <Setter Property="Template">
        <ControlTemplate>
          <Rectangle>
            <Rectangle.Fill>
              <VisualBrush TileMode="Tile" Stretch="None" AlignmentX="Left" AlignmentY="Top"
                           DestinationRect="0,0,1,6" SourceRect="0,0,1,6">
                <VisualBrush.Visual>
                  <Canvas Width="1" Height="6">
                    <Rectangle Width="1" Height="4" Fill="{Binding $parent[Separator].Background}" />
                  </Canvas>
                </VisualBrush.Visual>
              </VisualBrush>
            </Rectangle.Fill>
          </Rectangle>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
