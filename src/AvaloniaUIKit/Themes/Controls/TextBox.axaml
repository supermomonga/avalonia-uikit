<!--
  GPUI Kit Input (crates/component/src/input/input.rs) -> TextBox (MaskedTextBox
  shares the theme). Classes: xsmall small large (medium is the default);
  revealPasswordButton (GPUI's mask_toggle: an eye button that shows the text);
  clearButton (GPUI's cleanable: an x button that clears the text, shown while
  the single-line text is editable and not empty).

  A right click opens GPUI's input menu at the pointer (UIKitTextBoxContextFlyout,
  the ContextFlyout): Cut, Copy, Paste, a separator and Select All with their
  shortcuts. Cut needs an editable selection that is not masked, Copy a
  selection that is not masked, Paste an editable field; Select All is always
  on. Avalonia keeps the caret where it was (GPUI moves it to the pointer when
  the click is outside the selection). The labels are the UIKit.Strings.*
  resources.

  The frame: input_h (20/24/32/44), the theme radius, the input background and a
  1px `input` border that turns to `ring`, with the ring band, while the field or
  anything in it has focus (GPUI makes no pointer/keyboard distinction). The
  text sits on a 20px line centered in the frame, input_px from the border.
  InnerLeftContent / InnerRightContent are GPUI's prefix and suffix, a size's gap
  (6/4/6/8) from the text. After the text come, a gap apart, GPUI's mask toggle,
  clear button and suffix, in that order. No hover look. A disabled field fills with the
  disabled background and draws its text, placeholder and inner content at half
  strength. GPUI shows a selection only while focused, so an unfocused TextBox
  hides it (IsInactiveSelectionHighlightEnabled=False). Apps mask a password
  with PasswordChar="•" (U+2022, GPUI's mask character).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit">
  <!-- The menu's labels (GPUI Kit's Input.* strings in English); replace them to localize. -->
  <x:String x:Key="UIKit.Strings.Cut">Cut</x:String>
  <x:String x:Key="UIKit.Strings.Copy">Copy</x:String>
  <x:String x:Key="UIKit.Strings.Paste">Paste</x:String>
  <x:String x:Key="UIKit.Strings.SelectAll">Select All</x:String>

  <!--
    input.rs on_context_menu (drawn as native_menu/fallback.rs draws a NativeMenu):
    the items, their order, shortcuts and enabled rules. One menu for every text
    field; it opens at the pointer, so its presenter drops the trigger gap.
  -->
  <MenuFlyout x:Key="UIKitTextBoxContextFlyout" FlyoutPresenterClasses="context">
    <MenuItem Header="{DynamicResource UIKit.Strings.Cut}"
              Command="{Binding $parent[TextBox].Cut}"
              IsEnabled="{Binding $parent[TextBox].CanCut}"
              InputGesture="{x:Static TextBox.CutGesture}" />
    <MenuItem Header="{DynamicResource UIKit.Strings.Copy}"
              Command="{Binding $parent[TextBox].Copy}"
              IsEnabled="{Binding $parent[TextBox].CanCopy}"
              InputGesture="{x:Static TextBox.CopyGesture}" />
    <MenuItem Header="{DynamicResource UIKit.Strings.Paste}"
              Command="{Binding $parent[TextBox].Paste}"
              IsEnabled="{Binding $parent[TextBox].CanPaste}"
              InputGesture="{x:Static TextBox.PasteGesture}" />
    <Separator />
    <MenuItem Header="{DynamicResource UIKit.Strings.SelectAll}"
              Command="{Binding $parent[TextBox].SelectAll}"
              InputGesture="{x:Static uikit:TextMenus.SelectAllGesture}" />
  </MenuFlyout>

  <!-- Button::text().xsmall() with an eye icon: shows the masked text while checked. -->
  <ControlTheme x:Key="UIKitRevealPasswordToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Normal.Foreground}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="6">
          <Panel>
            <PathIcon Name="PART_Masked" Classes="xsmall" Data="{StaticResource UIKit.Icon.Eye}" Foreground="{TemplateBinding Foreground}" />
            <PathIcon Name="PART_Revealed" Classes="xsmall" Data="{StaticResource UIKit.Icon.EyeOff}" Foreground="{TemplateBinding Foreground}" IsVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Hover.Foreground}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Pressed.Foreground}" />
    </Style>
    <Style Selector="^:checked /template/ PathIcon#PART_Masked">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked /template/ PathIcon#PART_Revealed">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- clear_button (input/clear_button.rs): Button::text().xsmall() with the Close icon, no tab stop. -->
  <ControlTheme x:Key="UIKitClearButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Normal.Foreground}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="6">
          <PathIcon Classes="xsmall" Data="{StaticResource UIKit.Icon.Close}" Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Hover.Foreground}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Pressed.Foreground}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Disabled.Foreground}" />
    </Style>
  </ControlTheme>

  <!--
    InputGroupButton (input/group.rs): a ghost XSmall button laid out as a
    compact Medium one: 24px high (32 when small), 8px (10px) padding, medium
    weight on a 20px line, the small radius (the theme radius when small); hover
    and press tint it with `muted`. The group applies it to its buttons.
  -->
  <ControlTheme x:Key="UIKitInputGroupButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="2.5" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter"
                            BackgroundSizing="OuterBorderEdge"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{TemplateBinding Foreground}"
                            LineHeight="20"
                            TextWrapping="NoWrap"
                            RecognizesAccessKey="True" />
          <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3" CornerRadius="4.5"
                  BorderBrush="{DynamicResource UIKit.FocusRing}" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.icon-only">
      <Setter Property="Width" Value="24" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="5.5" />
    </Style>
    <Style Selector="^.small /template/ Border#PART_FocusRing">
      <Setter Property="CornerRadius" Value="7.5" />
    </Style>
    <Style Selector="^.small.icon-only">
      <Setter Property="Width" Value="32" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^:pointerover, ^:pressed">
      <Setter Property="Background" Value="{DynamicResource UIKit.InputGroup.Button.Hover}" />
    </Style>
    <!-- InputGroupButton::loading: a loading button does not react to the pointer (button.rs). -->
    <Style Selector="^[(uikit|Buttons.IsLoading)=True]:pointerover, ^[(uikit|Buttons.IsLoading)=True]:pressed">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource UIKit.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Input}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5.5" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource UIKit.Caret}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource UIKit.Selection}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource UIKit.MutedForeground}" />
    <Setter Property="IsInactiveSelectionHighlightEnabled" Value="False" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ContextFlyout" Value="{DynamicResource UIKitTextBoxContextFlyout}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_BorderElement"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BackgroundSizing="OuterBorderEdge" />
          <!-- focus_ring (styled.rs): a 3px band outside the border, in ring at 50%. -->
          <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3" CornerRadius="7.5"
                  BorderBrush="{DynamicResource UIKit.FocusRing}" IsVisible="False" IsHitTestVisible="False" />
          <Border Name="PART_ContentBorder" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
              <ContentPresenter Name="PART_InnerLeftContent" Grid.Column="0" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding InnerLeftContent}"
                                IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ScrollViewer Name="PART_ScrollViewer" Grid.Column="1"
                            HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                            IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                            AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                            BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                <Panel Name="PART_TextPanel">
                  <TextBlock Name="PART_Placeholder"
                             Foreground="{TemplateBinding PlaceholderForeground}"
                             Text="{TemplateBinding PlaceholderText}"
                             TextAlignment="{TemplateBinding TextAlignment}"
                             TextWrapping="{TemplateBinding TextWrapping}"
                             LineHeight="{TemplateBinding LineHeight}"
                             HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <TextBlock.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                      </MultiBinding>
                    </TextBlock.IsVisible>
                  </TextBlock>
                  <TextPresenter Name="PART_TextPresenter"
                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                 CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                 CaretIndex="{TemplateBinding CaretIndex}"
                                 SelectionStart="{TemplateBinding SelectionStart}"
                                 SelectionEnd="{TemplateBinding SelectionEnd}"
                                 TextAlignment="{TemplateBinding TextAlignment}"
                                 TextWrapping="{TemplateBinding TextWrapping}"
                                 LineHeight="{TemplateBinding LineHeight}"
                                 LetterSpacing="{TemplateBinding LetterSpacing}"
                                 PasswordChar="{TemplateBinding PasswordChar}"
                                 RevealPassword="{TemplateBinding RevealPassword}"
                                 SelectionBrush="{TemplateBinding SelectionBrush}"
                                 SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                 CaretBrush="{TemplateBinding CaretBrush}"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Panel>
              </ScrollViewer>
              <!-- input.rs: the suffix row, a gap apart: mask toggle, clear button, the app's suffix. -->
              <ToggleButton Name="PART_RevealButton" Grid.Column="2" Margin="6,0,0,0"
                            Theme="{StaticResource UIKitRevealPasswordToggle}"
                            IsChecked="{TemplateBinding RevealPassword, Mode=TwoWay}"
                            IsVisible="False" />
              <Button Name="PART_ClearButton" Grid.Column="3" Margin="6,0,0,0"
                      Theme="{StaticResource UIKitClearButton}"
                      Command="{Binding $parent[TextBox].Clear}"
                      IsVisible="False" />
              <ContentPresenter Name="PART_InnerRightContent" Grid.Column="4" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding InnerRightContent}"
                                IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Sizes (sizing.rs): input_h, input_px, text size; the inner gap per size (input.rs). -->
    <Style Selector="^.xsmall">
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="^.small /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="^.small /template/ ContentPresenter#PART_InnerRightContent, ^.small /template/ ToggleButton#PART_RevealButton, ^.small /template/ Button#PART_ClearButton">
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="^.large /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="^.large /template/ ContentPresenter#PART_InnerRightContent, ^.large /template/ ToggleButton#PART_RevealButton, ^.large /template/ Button#PART_ClearButton">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!--
      GPUI Kit Textarea (input/textarea.rs): multi-line text (AcceptsReturn) has
      no fixed height (apps give rows with MinLines/MaxLines, or a Height), wraps
      by default, and pads its text inside the scrolling area (input_px, input_py;
      a margin on the text panel, which MinLines counts once) rather than the
      frame, so the scrollbar overlays the whole inner frame. Lines wrap 10px
      before the right padding (RIGHT_MARGIN).
    -->
    <Style Selector="^[AcceptsReturn=True]">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="^[AcceptsReturn=True] /template/ Border#PART_ContentBorder">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^[AcceptsReturn=True] /template/ Panel#PART_TextPanel">
      <Setter Property="Margin" Value="10,8" />
    </Style>
    <Style Selector="^.xsmall[AcceptsReturn=True] /template/ Panel#PART_TextPanel">
      <Setter Property="Margin" Value="4,0" />
    </Style>
    <Style Selector="^.small[AcceptsReturn=True] /template/ Panel#PART_TextPanel">
      <Setter Property="Margin" Value="8,2" />
    </Style>
    <Style Selector="^.large[AcceptsReturn=True] /template/ Panel#PART_TextPanel">
      <Setter Property="Margin" Value="12,10" />
    </Style>
    <Style Selector="^[AcceptsReturn=True][TextWrapping=Wrap] /template/ TextPresenter#PART_TextPresenter, ^[AcceptsReturn=True][TextWrapping=Wrap] /template/ TextBlock#PART_Placeholder">
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style Selector="^:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Ring}" />
    </Style>
    <!--
      GPUI paints a selection only while the input has focus. Avalonia hides it
      when focus leaves (IsInactiveSelectionHighlightEnabled), but shows one made
      before the field was ever focused, and keeps showing it after a right
      click, which does not focus a TextBox.
    -->
    <Style Selector="^[IsInactiveSelectionHighlightEnabled=False]:not(:focus) /template/ TextPresenter#PART_TextPresenter">
      <Setter Property="SelectionBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:focus-within /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource UIKit.Input.Disabled.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Input.Disabled.Text}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource UIKit.Input.Disabled.Placeholder}" />
    </Style>
    <!-- The prefix and suffix fade to half as wholes; their text keeps its own color. -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_InnerLeftContent, ^:disabled /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    </Style>
    <Style Selector="^:disabled /template/ ToggleButton#PART_RevealButton">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!--
      GPUI Kit InputGroup (input/group.rs) -> the group class: InnerLeftContent
      and InnerRightContent are the addons, in muted medium-weight text on GPUI's
      default (phi) line, 8px from the text and 6px from the border. The frame is
      transparent (light) or tinted (dark); its border and background move to a
      new color over 120ms (easing_move), as GPUI's GroupAppearance transition.
      An invalid group (Avalonia's :error) shows the danger border and ring,
      even when unfocused or disabled. Disabled, the whole group fades to half.
    -->
    <Style Selector="^.group">
      <Setter Property="Background" Value="{DynamicResource UIKit.InputGroup.Background}" />
    </Style>
    <Style Selector="^.group /template/ Border#PART_BorderElement">
      <Setter Property="uikit:Motion.ColorTransition">
        <uikit:ColorTransition Duration="0:0:0.12" Easing="0.2,0,0,1" Properties="Background, BorderBrush" />
      </Setter>
    </Style>
    <Style Selector="^.group /template/ ContentPresenter#PART_InnerLeftContent, ^.group /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LineHeight" Value="22.6525" />
    </Style>
    <Style Selector="^.group.xsmall /template/ ContentPresenter#PART_InnerLeftContent, ^.group.xsmall /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="LineHeight" Value="19.4164" />
    </Style>
    <Style Selector="^.group.large /template/ ContentPresenter#PART_InnerLeftContent, ^.group.large /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="LineHeight" Value="25.8885" />
    </Style>
    <!-- 6px from the border (pl_1p5) and 8px to the text (pl_2), around the frame's input_px. -->
    <Style Selector="^.group /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="-4,0,8,0" />
    </Style>
    <Style Selector="^.group /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,-4,0" />
    </Style>
    <Style Selector="^.group.xsmall /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="2,0,8,0" />
    </Style>
    <Style Selector="^.group.xsmall /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,2,0" />
    </Style>
    <Style Selector="^.group.small /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="-2,0,8,0" />
    </Style>
    <Style Selector="^.group.small /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,-2,0" />
    </Style>
    <Style Selector="^.group.large /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="-6,0,8,0" />
    </Style>
    <Style Selector="^.group.large /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="8,0,-6,0" />
    </Style>
    <!-- Multi-line, the frame has no padding: 6px from the border, and the text panel's own margin less 2 to the text. -->
    <Style Selector="^.group[AcceptsReturn=True] /template/ ContentPresenter#PART_InnerLeftContent">
      <Setter Property="Margin" Value="6,0,-2,0" />
    </Style>
    <Style Selector="^.group[AcceptsReturn=True] /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Margin" Value="-2,0,6,0" />
    </Style>
    <Style Selector="^.group:error">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Danger}" />
    </Style>
    <Style Selector="^.group:error /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.InputGroup.Invalid.Ring}" />
    </Style>
    <Style Selector="^.group:disabled">
      <Setter Property="Background" Value="{DynamicResource UIKit.InputGroup.Disabled.Background}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^.group:disabled /template/ ContentPresenter#PART_InnerLeftContent, ^.group:disabled /template/ ContentPresenter#PART_InnerRightContent">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
    </Style>

    <Style Selector="^.revealPasswordButton[AcceptsReturn=False] /template/ ToggleButton#PART_RevealButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- input.rs show_clear_button: cleanable, editable (enabled, not read-only), not empty, single-line. -->
    <Style Selector="^.clearButton[AcceptsReturn=False][IsReadOnly=False]:not(:empty) /template/ Button#PART_ClearButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.clearButton:disabled /template/ Button#PART_ClearButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
