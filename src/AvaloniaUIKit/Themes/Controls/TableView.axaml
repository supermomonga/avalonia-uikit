<!--
  GPUI Kit's DataTable (crates/component/src/table/data_table.rs, state.rs) ->
  TableView, its default look; GPUI Kit's Table (table/table.rs) -> TableView
  with Theme="{StaticResource UIKitTable}". Without rows, the DataTable look
  shows its empty view (the Inbox icon) under the header; the Table look shows
  the header alone, as GPUI's Table has no empty view.

  Both looks share the cell and column header themes: the TableView's theme
  hands its size and look to the rows, cells and headers (created in code)
  through the inherited uikit:Tables values. Sizes are the classes xsmall,
  small, (medium) and large; the class stripe fills every other row with
  table_even.

  The table's fill sits under its content and its border over it, as GPUI
  paints a bordered box: the header and row fills reach the square corners
  just inside the 1px border, which the rounded border then covers.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uikit="using:AvaloniaUIKit"
        xmlns:gconv="using:AvaloniaUIKit.Converters">
  <Styles.Resources>
    <ResourceDictionary>
      <!--
        The scroll area under the header band. The header is outside the
        scrolled content, so it stays put vertically; the headers presenter
        follows the horizontal offset itself. The scrollbars overlay the rows.

        DataTable (state.rs): the header and its scroll area both fill with
        table_head, so the translucent dark fill lies twice; the header row's
        bottom rule is border. A striped table fills the body below its rows
        with empty rows (PART_Filler, shown by the stripe class). A table
        without rows shows its empty view in the body instead (PART_Empty).
      -->
      <ControlTheme x:Key="UIKitTableViewScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid RowDefinitions="Auto,*">
              <Border Name="PART_Header"
                      Height="{TemplateBinding (uikit:Tables.RowHeight)}"
                      Background="{DynamicResource UIKit.TableHead}"
                      TextElement.Foreground="{DynamicResource UIKit.TableHeadForeground}"
                      ClipToBounds="True">
                <Border Background="{DynamicResource UIKit.TableHead}"
                        BackgroundSizing="OuterBorderEdge"
                        BorderBrush="{DynamicResource UIKit.Border}"
                        BorderThickness="0,0,0,1">
                  <TableViewColumnHeadersPresenter />
                </Border>
              </Border>
              <Canvas Grid.Row="1" IsHitTestVisible="False">
                <ItemsControl Name="PART_Filler" IsVisible="False"
                              Width="{Binding Viewport.Width, RelativeSource={RelativeSource TemplatedParent}}">
                  <Canvas.Top>
                    <MultiBinding Converter="{x:Static gconv:TableConverters.RowsHeight}">
                      <Binding Path="$parent[TableView].ItemCount" />
                      <Binding Path="(uikit:Tables.RowHeight)" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                  </Canvas.Top>
                  <ItemsControl.ItemsSource>
                    <MultiBinding Converter="{x:Static gconv:TableConverters.FillerRows}">
                      <Binding Path="$parent[TableView].ItemCount" />
                      <Binding Path="(uikit:Tables.RowHeight)" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="Viewport.Height" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                  </ItemsControl.ItemsSource>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                      <Border Height="{Binding $self.(uikit:Tables.RowHeight)}"
                              BackgroundSizing="OuterBorderEdge"
                              BorderBrush="{DynamicResource UIKit.TableRowBorder}"
                              BorderThickness="0,0,0,1"
                              Classes.even="{Binding Converter={x:Static gconv:TableConverters.IsOdd}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  <ItemsControl.Styles>
                    <Style Selector="Border.even">
                      <Setter Property="Background" Value="{DynamicResource UIKit.TableEven}" />
                    </Style>
                  </ItemsControl.Styles>
                </ItemsControl>
              </Canvas>
              <ScrollContentPresenter Name="PART_ContentPresenter" Grid.Row="1"
                                      Padding="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                      VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                      HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                      VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                      ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}" />
              <!-- delegate.rs render_empty: a 48px Inbox icon in muted_foreground at 60% (List's), centered in the body. -->
              <Panel Name="PART_Empty" Grid.Row="1" IsVisible="False" IsHitTestVisible="False">
                <PathIcon Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="{StaticResource UIKit.Icon.Inbox}" Foreground="{DynamicResource UIKit.List.Empty}" />
              </Panel>
              <ScrollBar Name="PART_VerticalScrollBar" Grid.Row="1" Orientation="Vertical" />
              <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" />
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Table (table.rs TableHeader): one table_head fill, a table_row_border rule. -->
      <ControlTheme x:Key="UIKitTableScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid RowDefinitions="Auto,*">
              <Border Name="PART_Header"
                      Background="{DynamicResource UIKit.TableHead}"
                      BackgroundSizing="OuterBorderEdge"
                      BorderBrush="{DynamicResource UIKit.TableRowBorder}"
                      BorderThickness="0,0,0,1"
                      TextElement.Foreground="{DynamicResource UIKit.TableHeadForeground}"
                      ClipToBounds="True">
                <TableViewColumnHeadersPresenter />
              </Border>
              <ScrollContentPresenter Name="PART_ContentPresenter" Grid.Row="1"
                                      Padding="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                      VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                      HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                      VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                      ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}" />
              <ScrollBar Name="PART_VerticalScrollBar" Grid.Row="1" Orientation="Vertical" />
              <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" />
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- A column's resize handle: the 4px inside the column's right edge, with a 1px hairline on that edge. -->
      <ControlTheme x:Key="UIKitTableViewResizer" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource UIKit.TableRowBorder}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid ColumnDefinitions="4,4" Background="Transparent">
              <Border Name="PART_Inside" Background="Transparent">
                <Border Name="PART_Hairline" Width="1" HorizontalAlignment="Right" Background="{TemplateBinding Background}" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter>
        <!-- state.rs: the hairline turns border while the pointer is over the column's own half. -->
        <Style Selector="^ /template/ Border#PART_Inside:pointerover > Border#PART_Hairline">
          <Setter Property="Background" Value="{DynamicResource UIKit.Border}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Hairline">
          <Setter Property="IsVisible" Value="False" />
        </Style>
      </ControlTheme>

      <!-- The cell: the look's padding and alignment, the column's horizontal alignment. -->
      <ControlTheme x:Key="{x:Type TableViewCell}" TargetType="TableViewCell">
        <Setter Property="Padding" Value="{Binding $self.(uikit:Tables.CellPadding)}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding $self.(uikit:Tables.CellVerticalAlignment)}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!--
        The column header: a cell in the header band, with the resize handle on
        its right edge. The handle reaches 4px into the next column too, where
        it drags the same edge without lighting up (GPUI's leading band); the
        next header paints over it, so headers keep no background of their own.
      -->
      <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">
        <Setter Property="Padding" Value="{Binding $self.(uikit:Tables.CellPadding)}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding $self.(uikit:Tables.CellVerticalAlignment)}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <ContentPresenter Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Thumb Name="PART_Resizer"
                     Theme="{StaticResource UIKitTableViewResizer}"
                     Width="8" Margin="0,0,-4,0"
                     HorizontalAlignment="Right"
                     Cursor="SizeWestEast"
                     IsEnabled="{Binding $parent[TableViewColumnHeader].Column.CanUserEffectivelyResize, FallbackValue=False}" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <!-- Table has no resize handles to paint; the column still resizes. -->
        <Style Selector="^[(uikit|Tables.ShowsResizeHandles)=False] /template/ Thumb#PART_Resizer">
          <Setter Property="Opacity" Value="0" />
        </Style>
      </ControlTheme>

      <!--
        A DataTable row: the look's height with a table_row_border rule along
        its bottom, table_hover under the pointer, table_active when selected
        (hovering adds nothing). Pressing and focusing show nothing.
      -->
      <ControlTheme x:Key="{x:Type TableViewRow}" TargetType="TableViewRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Border"
                    Height="{TemplateBinding (uikit:Tables.RowHeight)}"
                    Background="{TemplateBinding Background}"
                    BackgroundSizing="OuterBorderEdge"
                    BorderBrush="{DynamicResource UIKit.TableRowBorder}"
                    BorderThickness="0,0,0,1">
              <TableViewCellsPresenter Name="PART_CellsPresenter" />
            </Border>
          </ControlTemplate>
        </Setter>
        <!-- state.rs need_render_border: rows filling the body drop the last rule (the table's border follows), unless it is selected. -->
        <Style Selector="^[(uikit|Tables.IsFilled)=True]:nth-last-child(1):not(:selected) /template/ Border#Border">
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Border">
          <Setter Property="Background" Value="{DynamicResource UIKit.TableHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#Border">
          <Setter Property="Background" Value="{DynamicResource UIKit.TableActive}" />
        </Style>
      </ControlTheme>

      <!-- A Table row: sized by its cells, with a table_row_border rule along its top after the first row. -->
      <ControlTheme x:Key="UIKitTableRow" TargetType="TableViewRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Border"
                    Background="{TemplateBinding Background}"
                    BackgroundSizing="OuterBorderEdge"
                    BorderBrush="{DynamicResource UIKit.TableRowBorder}">
              <TableViewCellsPresenter Name="PART_CellsPresenter" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:not(:nth-child(1)) /template/ Border#Border">
          <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
      </ControlTheme>

      <!--
        DataTable: the table fill, a 1px border with the theme radius (the
        class borderless drops both), fixed row heights, cells at the top left
        of their padding, and text by size (xsmall 12px, large 16px).
      -->
      <ControlTheme x:Key="{x:Type TableView}" TargetType="TableView">
        <Setter Property="Background" Value="{DynamicResource UIKit.Table}" />
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5.5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextBlock.LineHeight" Value="22.5" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource {x:Type TableViewRow}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="uikit:Tables.RowHeight" Value="32" />
        <Setter Property="uikit:Tables.CellPadding" Value="8,4" />
        <Setter Property="uikit:Tables.CellVerticalAlignment" Value="Top" />
        <Setter Property="uikit:Tables.ShowsResizeHandles" Value="True" />
        <Setter Property="uikit:Tables.TracksKeyboardFocus" Value="True" />
        <Setter Property="uikit:Tables.TracksFill" Value="True" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <!-- The border's outer edge: its width in a transparent border under the fill. -->
              <Border Name="PART_Fill"
                      Background="{TemplateBinding Background}"
                      BackgroundSizing="OuterBorderEdge"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}" />
              <ScrollViewer Name="PART_ScrollViewer"
                            Margin="{TemplateBinding BorderThickness}"
                            VerticalSnapPointsType="{TemplateBinding (ScrollViewer.VerticalSnapPointsType)}"
                            HorizontalSnapPointsType="{TemplateBinding (ScrollViewer.HorizontalSnapPointsType)}"
                            HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                            IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                            IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                            AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                            BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                Margin="{TemplateBinding Padding}" />
              </ScrollViewer>
              <Border Name="PART_Border"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      IsHitTestVisible="False" />
              <!-- styled.rs focus_ring: 3px of ring at 50% outside the border, around radius + 3. -->
              <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3" CornerRadius="7.5"
                      BorderBrush="{DynamicResource UIKit.FocusRing}"
                      IsVisible="False" IsHitTestVisible="False" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ ScrollViewer#PART_ScrollViewer">
          <Setter Property="Theme" Value="{StaticResource UIKitTableViewScrollViewer}" />
        </Style>
        <Style Selector="^.borderless">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="^.borderless /template/ Border#PART_FocusRing">
          <Setter Property="CornerRadius" Value="1.5" />
        </Style>
        <!-- Focused from the keyboard: the ring, and the border in ring. -->
        <Style Selector="^[(uikit|Tables.ShowsFocusRing)=True]">
          <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Ring}" />
          <Style Selector="^ /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
        <!-- sizing.rs: table_row_height, table_cell_padding, and the text of table_cell_size. -->
        <Style Selector="^.xsmall">
          <Setter Property="uikit:Tables.RowHeight" Value="26" />
          <Setter Property="uikit:Tables.CellPadding" Value="4,2" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="TextBlock.LineHeight" Value="19.5" />
        </Style>
        <Style Selector="^.small">
          <Setter Property="uikit:Tables.RowHeight" Value="30" />
          <Setter Property="uikit:Tables.CellPadding" Value="6,3" />
        </Style>
        <Style Selector="^.large">
          <Setter Property="uikit:Tables.RowHeight" Value="40" />
          <Setter Property="uikit:Tables.CellPadding" Value="12,8" />
          <Setter Property="FontSize" Value="16" />
          <Setter Property="TextBlock.LineHeight" Value="26" />
        </Style>
      </ControlTheme>

      <!--
        Table: no border by default (BorderThickness 1 with CornerRadius 5.5 is
        the story's bordered table), rows sized by their content, 14px text at
        every size, cells centered in their row, no resize handles to paint and
        no hover or selection colors.
      -->
      <ControlTheme x:Key="UIKitTable" TargetType="TableView" BasedOn="{StaticResource {x:Type TableView}}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource UIKitTableRow}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="uikit:Tables.RowHeight" Value="NaN" />
        <Setter Property="uikit:Tables.CellVerticalAlignment" Value="Center" />
        <Setter Property="uikit:Tables.ShowsResizeHandles" Value="False" />
        <Setter Property="uikit:Tables.TracksKeyboardFocus" Value="False" />
        <Setter Property="uikit:Tables.TracksFill" Value="False" />
        <Style Selector="^ /template/ ScrollViewer#PART_ScrollViewer">
          <Setter Property="Theme" Value="{StaticResource UIKitTableScrollViewer}" />
        </Style>
        <Style Selector="^.xsmall, ^.small, ^.large">
          <Setter Property="uikit:Tables.RowHeight" Value="NaN" />
          <Setter Property="FontSize" Value="14" />
          <Setter Property="TextBlock.LineHeight" Value="22.5" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!--
    A cell clips its text at its own edges, padding included, as GPUI's
    overflow_hidden cell does (Avalonia 12 clips a TextBlock to itself). A text
    too long for its cell overflows from the side it is aligned to, as GPUI's
    justified content does.
  -->
  <Style Selector="TableViewCell TextBlock">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TableViewCell[HorizontalContentAlignment=Right] TextBlock">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="TableViewCell[HorizontalContentAlignment=Center] TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- A striped DataTable's empty rows below the last row (state.rs). -->
  <Style Selector="TableView.stripe /template/ ScrollViewer#PART_ScrollViewer /template/ ItemsControl#PART_Filler">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <!-- A DataTable without rows: the empty view replaces the body, filler rows included (state.rs). Table has none. -->
  <Style Selector="TableView:empty /template/ ScrollViewer#PART_ScrollViewer /template/ Panel#PART_Empty">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TableView:empty /template/ ScrollViewer#PART_ScrollViewer /template/ ItemsControl#PART_Filler">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Stripes (state.rs, and the Table story): every other row, starting with the second, fills with table_even. -->
  <Style Selector="TableView.stripe TableViewRow:nth-child(2n)">
    <Setter Property="Background" Value="{DynamicResource UIKit.TableEven}" />
  </Style>
</Styles>
