<!--
  DO NOT EDIT. Generated by scripts/gen_dropdown_button_theme.py.

  GPUI Kit Button::dropdown_caret(true) -> DropDownButton (crates/component/src/button/button.rs).
  The Button theme with a caret after the content: the Button's classes (variants,
  outline, compact, selected, sizes, rounded) apply as they are. The content sits
  at the start and the caret at the end (justify_between), the size's gap apart;
  the caret keeps the normal foreground at 75% while hovered, pressed, selected or
  disabled, as GPUI colors it apart from the button's text. An open flyout shows
  the selected look; give the MenuFlyout Placement="BottomEdgeAlignedLeft".
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="PART_Frame"
                    BackgroundSizing="OuterBorderEdge"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <Grid Name="PART_Layout" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Foreground="{TemplateBinding Foreground}"
                                  LineHeight="17.5"
                                  TextWrapping="NoWrap"
                                  TextTrimming="CharacterEllipsis"
                                  RecognizesAccessKey="True" />
                <PathIcon Name="PART_Caret" Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center"
                          Data="{StaticResource UIKit.Icon.ChevronDown}" />
              </Grid>
            </Border>
            <!-- focus_ring (styled.rs): a 3px band outside the border, in ring at 50%. -->
            <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3"
                    CornerRadius="7.5"
                    BorderBrush="{DynamicResource UIKit.FocusRing}"
                    IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^.xsmall /template/ PathIcon#PART_Caret">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
      </Style>
      <Style Selector="^.xsmall /template/ Grid#PART_Layout">
        <Setter Property="ColumnSpacing" Value="4" />
      </Style>
      <Style Selector="^.small /template/ PathIcon#PART_Caret">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
      </Style>
      <Style Selector="^.small /template/ Grid#PART_Layout">
        <Setter Property="ColumnSpacing" Value="4" />
      </Style>
      <Style Selector="^.large /template/ PathIcon#PART_Caret">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
      </Style>
      <Style Selector="^.large /template/ Grid#PART_Layout">
        <Setter Property="ColumnSpacing" Value="8" />
      </Style>

      <!-- The caret: the normal foreground at 75%, in every state. -->
      <Style Selector="^ /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Default.Caret}" />
      </Style>
      <Style Selector="^.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Default.Outline.Caret}" />
      </Style>
      <Style Selector="^.primary /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Primary.Caret}" />
      </Style>
      <Style Selector="^.primary.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Primary.Outline.Caret}" />
      </Style>
      <Style Selector="^.secondary /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Secondary.Caret}" />
      </Style>
      <Style Selector="^.secondary.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Secondary.Outline.Caret}" />
      </Style>
      <Style Selector="^.danger /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Danger.Caret}" />
      </Style>
      <Style Selector="^.danger.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Danger.Outline.Caret}" />
      </Style>
      <Style Selector="^.warning /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Warning.Caret}" />
      </Style>
      <Style Selector="^.warning.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Warning.Outline.Caret}" />
      </Style>
      <Style Selector="^.success /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Success.Caret}" />
      </Style>
      <Style Selector="^.success.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Success.Outline.Caret}" />
      </Style>
      <Style Selector="^.info /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Info.Caret}" />
      </Style>
      <Style Selector="^.info.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Info.Outline.Caret}" />
      </Style>
      <Style Selector="^.ghost /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Ghost.Caret}" />
      </Style>
      <Style Selector="^.ghost.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Ghost.Outline.Caret}" />
      </Style>
      <Style Selector="^.link /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Link.Caret}" />
      </Style>
      <Style Selector="^.link.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Link.Outline.Caret}" />
      </Style>
      <Style Selector="^.text /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Caret}" />
      </Style>
      <Style Selector="^.text.outline /template/ PathIcon#PART_Caret">
        <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Outline.Caret}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>
</Styles>
