<!--
  GPUI Kit Slider (crates/component/src/slider.rs) -> Slider, with its Track,
  Thumb and TickBars:

    <Slider Value="40" />
    <Slider Orientation="Vertical" Classes="reverse" />

  A 6px pill (the bar at 20%) filled up to the value in the bar color, in a
  24px band; a 16px thumb (the bar at 50% around the thumb color) centered on
  the value, overhanging the ends by half its width. A 3px ring (ring at 50%)
  springs around the thumb while it is hovered or pressed, or the slider is.
  Disabled, the thumb is not drawn. The class reverse fills from the thumb to
  the end. One size, as GPUI's. Ticks (TickPlacement) are Avalonia's own:
  muted 1px lines at the band's edges.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uikit="using:AvaloniaUIKit"
        xmlns:gconv="using:AvaloniaUIKit.Converters">
  <Styles.Resources>
    <!--
      The ring at spring progress s: 3s wide, around the thumb, its outer radius
      8 + 3s. Layout rounding snaps its width and inset to device pixels as GPUI
      snaps every edge.
    -->
    <gconv:AffineConverter x:Key="UIKit.Slider.RingWidth" Scale="3" />
    <gconv:AffineConverter x:Key="UIKit.Slider.RingInset" Scale="-3" />
    <gconv:AffineConverter x:Key="UIKit.Slider.RingRadius" Scale="1.5" Offset="8" />

    <!-- A track half: the whole band takes presses, the fill shows on one side. -->
    <ControlTheme x:Key="UIKitSliderTrackButton" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent" />
      <!-- The fill reaches 8px past its half, under the thumb. -->
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="UIKitSliderThumb" TargetType="Thumb">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="PART_Edge" CornerRadius="8" Background="{DynamicResource UIKit.Slider.Thumb.Edge}" />
            <Border Name="PART_Ring"
                    uikit:Motion.Spring="{StaticResource UIKit.Spring.Control}"
                    uikit:Motion.SpringTarget="0"
                    Opacity="{Binding $self.(uikit:Motion.SpringValue)}"
                    BorderThickness="{Binding $self.(uikit:Motion.SpringValue), Converter={StaticResource UIKit.Slider.RingWidth}}"
                    Margin="{Binding $self.(uikit:Motion.SpringValue), Converter={StaticResource UIKit.Slider.RingInset}}"
                    CornerRadius="{Binding $self.(uikit:Motion.SpringValue), Converter={StaticResource UIKit.Slider.RingRadius}}"
                    BorderBrush="{DynamicResource UIKit.Slider.Ring}"
                    IsHitTestVisible="False" />
            <Border Name="PART_Face" Margin="1" CornerRadius="7" Background="{DynamicResource UIKit.SliderThumb}" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Ring, ^:pressed /template/ Border#PART_Ring">
        <Setter Property="uikit:Motion.SpringTarget" Value="1" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Name="PART_Root" Background="{TemplateBinding Background}">
            <Border Name="PART_Bar" CornerRadius="3" Background="{DynamicResource UIKit.Slider.Track}" />
            <TickBar Name="PART_TopTickBar"
                     IsVisible="False"
                     Placement="Top"
                     Fill="{DynamicResource UIKit.MutedForeground}"
                     Ticks="{TemplateBinding Ticks}"
                     TickFrequency="{TemplateBinding TickFrequency}"
                     Orientation="{TemplateBinding Orientation}"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                     ReservedSpace="{Binding #PART_Track.Thumb.Bounds}" />
            <TickBar Name="PART_BottomTickBar"
                     IsVisible="False"
                     Placement="Bottom"
                     Fill="{DynamicResource UIKit.MutedForeground}"
                     Ticks="{TemplateBinding Ticks}"
                     TickFrequency="{TemplateBinding TickFrequency}"
                     Orientation="{TemplateBinding Orientation}"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                     ReservedSpace="{Binding #PART_Track.Thumb.Bounds}" />
            <!--
              The track runs 8px past the bar at both ends, so the thumb's center
              (confined to the track) spans exactly the bar, as GPUI places it.
            -->
            <Track Name="PART_Track"
                   Orientation="{TemplateBinding Orientation}"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource UIKitSliderTrackButton}">
                  <Border Name="PART_DecreaseFill" CornerRadius="3" Background="{DynamicResource UIKit.SliderBar}" />
                </RepeatButton>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource UIKitSliderTrackButton}">
                  <Border Name="PART_IncreaseFill" CornerRadius="3" Background="{DynamicResource UIKit.SliderBar}" IsVisible="False" />
                </RepeatButton>
              </Track.IncreaseButton>
              <Thumb Name="PART_Thumb" Theme="{StaticResource UIKitSliderThumb}" />
            </Track>
          </Panel>
        </ControlTemplate>
      </Setter>

      <!-- Horizontal: a 24px band; the fill runs from the bar's start to the thumb's center. -->
      <Style Selector="^:horizontal">
        <Setter Property="Height" Value="24" />
      </Style>
      <Style Selector="^:horizontal /template/ Border#PART_Bar">
        <Setter Property="Height" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^:horizontal /template/ Track#PART_Track, ^:horizontal /template/ TickBar">
        <Setter Property="Margin" Value="-8,0" />
      </Style>
      <Style Selector="^:horizontal /template/ TickBar">
        <Setter Property="Height" Value="4" />
      </Style>
      <Style Selector="^:horizontal /template/ TickBar#PART_TopTickBar">
        <Setter Property="VerticalAlignment" Value="Top" />
      </Style>
      <Style Selector="^:horizontal /template/ TickBar#PART_BottomTickBar">
        <Setter Property="VerticalAlignment" Value="Bottom" />
      </Style>
      <Style Selector="^:horizontal /template/ Border#PART_DecreaseFill, ^:horizontal /template/ Border#PART_IncreaseFill">
        <Setter Property="Height" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^:horizontal /template/ Border#PART_DecreaseFill">
        <Setter Property="Margin" Value="8,0,-8,0" />
      </Style>
      <Style Selector="^:horizontal /template/ Border#PART_IncreaseFill">
        <Setter Property="Margin" Value="-8,0,8,0" />
      </Style>

      <!-- Vertical: 24px wide, 120px tall; the fill rises from the bottom. -->
      <Style Selector="^:vertical">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="120" />
      </Style>
      <Style Selector="^:vertical /template/ Border#PART_Bar">
        <Setter Property="Width" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
      <Style Selector="^:vertical /template/ Track#PART_Track, ^:vertical /template/ TickBar">
        <Setter Property="Margin" Value="0,-8" />
      </Style>
      <Style Selector="^:vertical /template/ TickBar">
        <Setter Property="Width" Value="4" />
      </Style>
      <Style Selector="^:vertical /template/ TickBar#PART_TopTickBar">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Placement" Value="Left" />
      </Style>
      <Style Selector="^:vertical /template/ TickBar#PART_BottomTickBar">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Placement" Value="Right" />
      </Style>
      <Style Selector="^:vertical /template/ Border#PART_DecreaseFill, ^:vertical /template/ Border#PART_IncreaseFill">
        <Setter Property="Width" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
      <Style Selector="^:vertical /template/ Border#PART_DecreaseFill">
        <Setter Property="Margin" Value="0,-8,0,8" />
      </Style>
      <Style Selector="^:vertical /template/ Border#PART_IncreaseFill">
        <Setter Property="Margin" Value="0,8,0,-8" />
      </Style>

      <!-- reverse: the fill runs from the thumb to the end instead. -->
      <Style Selector="^.reverse /template/ Border#PART_DecreaseFill">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^.reverse /template/ Border#PART_IncreaseFill">
        <Setter Property="IsVisible" Value="True" />
      </Style>

      <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#PART_TopTickBar, ^[TickPlacement=Outside] /template/ TickBar#PART_TopTickBar">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#PART_BottomTickBar, ^[TickPlacement=Outside] /template/ TickBar#PART_BottomTickBar">
        <Setter Property="IsVisible" Value="True" />
      </Style>

      <!-- Disabled: GPUI draws no thumb. It keeps its place so the fill keeps its length. -->
      <Style Selector="^:disabled /template/ Thumb#PART_Thumb">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!--
    A press anywhere on the slider (the track jumps the thumb under the pointer)
    keeps the ring up: GPUI finds the thumb hovered again once it has moved.
  -->
  <Style Selector="Slider:pressed /template/ Thumb#PART_Thumb /template/ Border#PART_Ring">
    <Setter Property="uikit:Motion.SpringTarget" Value="1" />
  </Style>
</Styles>
