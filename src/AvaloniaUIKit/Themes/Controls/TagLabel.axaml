<!--
  GPUI Kit Tag (crates/component/src/tag.rs) -> uikit:TagLabel.
  Classes: color   primary (default) secondary danger success warning info,
                   or a palette color: neutral gray red orange amber yellow lime green emerald teal cyan sky blue indigo violet purple fuchsia pink rose
           outline transparent fill, the color as the text
           size    xsmall / small (10px text, 6x2 padding, radius 3), the
                   default medium (12px, 10x4, radius 6), large (14px, 10x4)
           rounded-full
  Hover fades the whole tag to 90%, as GPUI does.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit">
  <ControlTheme x:Key="{x:Type uikit:TagLabel}" TargetType="uikit:TagLabel">
    <Setter Property="Background" Value="{DynamicResource UIKit.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.PrimaryForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Primary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5.5" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          BackgroundSizing="OuterBorderEdge"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          LineHeight="15"
                          TextWrapping="NoWrap"
                          VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- Theme colors: fill, border, text; outline keeps the border and colors the text. -->
    <Style Selector="^.outline">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Primary}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource UIKit.Secondary}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.SecondaryForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
    </Style>
    <Style Selector="^.secondary.outline">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
    </Style>
    <Style Selector="^.danger">
      <Setter Property="Background" Value="{DynamicResource UIKit.Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.DangerForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Danger}" />
    </Style>
    <Style Selector="^.danger.outline">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Danger}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource UIKit.Success}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.SuccessForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Success}" />
    </Style>
    <Style Selector="^.success.outline">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Success}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource UIKit.Warning}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.WarningForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Warning}" />
    </Style>
    <Style Selector="^.warning.outline">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Warning}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Background" Value="{DynamicResource UIKit.Info}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.InfoForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Info}" />
    </Style>
    <Style Selector="^.info.outline">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Info}" />
    </Style>

    <!-- Palette colors (TagVariant::Color): the same text with or without outline. -->
    <Style Selector="^.neutral">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Neutral.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Neutral.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Neutral.Border}" />
    </Style>
    <Style Selector="^.gray">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Gray.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Gray.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Gray.Border}" />
    </Style>
    <Style Selector="^.red">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Red.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Red.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Red.Border}" />
    </Style>
    <Style Selector="^.orange">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Orange.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Orange.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Orange.Border}" />
    </Style>
    <Style Selector="^.amber">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Amber.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Amber.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Amber.Border}" />
    </Style>
    <Style Selector="^.yellow">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Yellow.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Yellow.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Yellow.Border}" />
    </Style>
    <Style Selector="^.lime">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Lime.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Lime.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Lime.Border}" />
    </Style>
    <Style Selector="^.green">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Green.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Green.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Green.Border}" />
    </Style>
    <Style Selector="^.emerald">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Emerald.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Emerald.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Emerald.Border}" />
    </Style>
    <Style Selector="^.teal">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Teal.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Teal.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Teal.Border}" />
    </Style>
    <Style Selector="^.cyan">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Cyan.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Cyan.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Cyan.Border}" />
    </Style>
    <Style Selector="^.sky">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Sky.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Sky.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Sky.Border}" />
    </Style>
    <Style Selector="^.blue">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Blue.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Blue.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Blue.Border}" />
    </Style>
    <Style Selector="^.indigo">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Indigo.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Indigo.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Indigo.Border}" />
    </Style>
    <Style Selector="^.violet">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Violet.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Violet.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Violet.Border}" />
    </Style>
    <Style Selector="^.purple">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Purple.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Purple.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Purple.Border}" />
    </Style>
    <Style Selector="^.fuchsia">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Fuchsia.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Fuchsia.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Fuchsia.Border}" />
    </Style>
    <Style Selector="^.pink">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Pink.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Pink.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Pink.Border}" />
    </Style>
    <Style Selector="^.rose">
      <Setter Property="Background" Value="{DynamicResource UIKit.Tag.Rose.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Tag.Rose.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Tag.Rose.Border}" />
    </Style>
    <Style Selector="^.outline">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="^.xsmall, ^.small">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="2.5" />
    </Style>
    <Style Selector="^.xsmall /template/ ContentPresenter#PART_ContentPresenter, ^.small /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="12.5" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="^.large /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="17.5" />
    </Style>
    <!-- rounded_full is rems(1), which a single line clamps to half the height. -->
    <Style Selector="^.rounded-full">
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="^.rounded-full.xsmall, ^.rounded-full.small">
      <Setter Property="CornerRadius" Value="8.75" />
    </Style>
    <Style Selector="^.rounded-full.large">
      <Setter Property="CornerRadius" Value="13.25" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
