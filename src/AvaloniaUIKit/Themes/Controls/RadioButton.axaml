<!--
  DO NOT EDIT. Generated by scripts/gen_check_themes.py.

  GPUI Kit Radio -> RadioButton (crates/component/src/radio.rs).
  Classes: xsmall small large (medium is the default).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit">
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
          <!-- The ring wraps the whole row (focus_ring_style on the root, radius * 0.5). -->
          <Border Name="PART_FocusRing" Grid.ColumnSpan="2" Margin="-3" BorderThickness="3"
                  CornerRadius="4.5" BorderBrush="{DynamicResource UIKit.FocusRing}"
                  IsVisible="False" IsHitTestVisible="False" />
          <Border Name="PART_Indicator" Width="16" Height="16" VerticalAlignment="Top"
                  Margin="0,2,0,0"
                  Classes.bare="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNull}}"
                  BorderThickness="1" CornerRadius="7.5" BackgroundSizing="OuterBorderEdge"
                  Background="{DynamicResource UIKit.InputBackground}" BorderBrush="{DynamicResource UIKit.Input}">
            <PathIcon Name="PART_Mark" Width="12" Height="12" Margin="1"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Data="{StaticResource UIKit.Icon.Check}" Foreground="{DynamicResource UIKit.PrimaryForeground}"
                      uikit:Motion.Spring="{StaticResource UIKit.Spring.Control}" uikit:Motion.SpringTarget="0"
                      Opacity="{Binding $self.(uikit:Motion.SpringValue)}">
            </PathIcon>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Margin="8,0,0,0"
                            IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                            LineHeight="17.5" RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#PART_Indicator.bare">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^.xsmall">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^.xsmall /template/ Border#PART_Indicator">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="0,1.5,0,0" />
      <Setter Property="CornerRadius" Value="5.5" />
    </Style>
    <Style Selector="^.xsmall /template/ Border#PART_Indicator.bare">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^.xsmall /template/ PathIcon#PART_Mark">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="^.xsmall /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="15" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="^.small /template/ Border#PART_Indicator">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0,1.5,0,0" />
      <Setter Property="CornerRadius" Value="6.5" />
    </Style>
    <Style Selector="^.small /template/ Border#PART_Indicator.bare">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^.small /template/ PathIcon#PART_Mark">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="^.small /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="17.5" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="^.large /template/ Border#PART_Indicator">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="CornerRadius" Value="8.5" />
    </Style>
    <Style Selector="^.large /template/ Border#PART_Indicator.bare">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^.large /template/ PathIcon#PART_Mark">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="^.large /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style Selector="^:checked /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource UIKit.Primary.Fill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Primary}" />
    </Style>
    <Style Selector="^:checked /template/ PathIcon#PART_Mark">
      <Setter Property="uikit:Motion.SpringTarget" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Indicator">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Check.Disabled.Border}" />
    </Style>
    <Style Selector="^:disabled:checked /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource UIKit.Check.Disabled.Checked}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Check.Disabled.Checked}" />
    </Style>
    <Style Selector="^:disabled /template/ PathIcon#PART_Mark">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Check.Disabled.Mark}" />
    </Style>
    <!-- Avalonia only: the indeterminate state shows a minus mark (not compared, R16). -->
    <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource UIKit.Primary.Fill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Primary}" />
    </Style>
    <Style Selector="^:indeterminate /template/ PathIcon#PART_Mark">
      <Setter Property="Data" Value="{StaticResource UIKit.Icon.Minus}" />
      <Setter Property="uikit:Motion.SpringTarget" Value="1" />
    </Style>
    <!-- Keyboard focus only: GPUI prevents a pointer press from focusing the control. -->
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
