<!--
  GPUI Kit Empty (crates/component/src/empty.rs) -> uikit:EmptyState.
  A centered column, 24px padding and 16px gaps, on radius 12: the header
  (media 8px above, then title and description 8px apart, at most 384px
  wide), the actions (at most 384px), then the content. The title is text_sm
  medium, the description muted text_sm on a 1.625 line (22.75px, which GPUI lays out as 22.5), both centered and
  wrapping. icon-media frames the media in a 32px muted square (radius_lg).
  GPUI's dashed border needs a border width the app adds; Avalonia's Border
  draws no dashes, so it is not provided.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit">
  <ControlTheme x:Key="{x:Type uikit:EmptyState}" TargetType="uikit:EmptyState">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextBlock.TextAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Spacing="16" VerticalAlignment="Center">
            <StackPanel Name="PART_Header" Spacing="8" MaxWidth="384" HorizontalAlignment="Center">
              <Border Name="PART_Media" Margin="0,0,0,8" HorizontalAlignment="Center"
                      IsVisible="{TemplateBinding Media, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentPresenter Content="{TemplateBinding Media}" HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center" />
              </Border>
              <ContentPresenter Name="PART_Title" Content="{TemplateBinding Title}" FontWeight="Medium"
                                LineHeight="22.5" TextWrapping="Wrap" HorizontalContentAlignment="Center"
                                IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter Name="PART_Description" Content="{TemplateBinding Description}"
                                Foreground="{DynamicResource UIKit.MutedForeground}"
                                LineHeight="22.5" TextWrapping="Wrap" HorizontalContentAlignment="Center"
                                IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <ContentPresenter Name="PART_Actions" Content="{TemplateBinding Actions}" MaxWidth="384"
                              HorizontalAlignment="Center"
                              IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Center"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.icon-media /template/ Border#PART_Media">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource UIKit.Muted}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
