<!--
  GPUI Kit Avatar and AvatarGroup (crates/component/src/avatar) ->
  uikit:Avatar and uikit:AvatarGroup.
  A circle on the secondary color with a 1px ring. Inside the ring: the image
  (cover), else the initials on the hue the control picked (the ring takes
  the hue's border), else the placeholder icon at 60% of the size in the
  background color. Sizes: xsmall 16px (10.4px text), small 24 (12px), the
  default 48 (14px), large 80 (30px semibold); any other Width / Height stays
  a circle.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit"
                    xmlns:gconv="using:AvaloniaUIKit.Converters">
  <gconv:RoundedClipConverter x:Key="UIKit.Avatar.Clip" Radius="9999" />

  <ControlTheme x:Key="{x:Type uikit:Avatar}" TargetType="uikit:Avatar">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
    <Setter Property="Placeholder" Value="{StaticResource UIKit.Icon.User}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Base" Background="{DynamicResource UIKit.Secondary}"
                  CornerRadius="{Binding $self.Bounds, Converter={x:Static gconv:AvatarConverters.Circle}}" />
          <Border Name="PART_Fallback" Margin="1" Background="{TemplateBinding Background}" ClipToBounds="True"
                  CornerRadius="{Binding $self.Bounds, Converter={x:Static gconv:AvatarConverters.Circle}}">
            <Panel>
              <TextBlock Name="PART_Initials" IsVisible="False" Text="{TemplateBinding Initials}"
                         Foreground="{TemplateBinding Foreground}" LineHeight="22.5" ClipToBounds="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <PathIcon Name="PART_Placeholder" IsVisible="False" Data="{TemplateBinding Placeholder}"
                        Foreground="{DynamicResource UIKit.Background}" Width="28.8" Height="28.8" />
            </Panel>
          </Border>
          <Image Name="PART_Image" Margin="1" IsVisible="False" Source="{TemplateBinding Source}" Stretch="UniformToFill"
                 Clip="{Binding $self.Bounds, Converter={StaticResource UIKit.Avatar.Clip}}" />
          <Border Name="PART_Ring" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{Binding $self.Bounds, Converter={x:Static gconv:AvatarConverters.Ring}}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:initials /template/ TextBlock#PART_Initials">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:placeholder /template/ PathIcon#PART_Placeholder">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- A loaded image replaces the fallback, which GPUI then does not paint. -->
    <Style Selector="^:image /template/ Image#PART_Image">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:image /template/ Border#PART_Fallback">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- avatar.rs IdentityColor: the hue's fill and text; its border only without an image. -->
    <Style Selector="^[Hue=0]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue0.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue0.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue0.Border}" /></Style>
    <Style Selector="^[Hue=1]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue1.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue1.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue1.Border}" /></Style>
    <Style Selector="^[Hue=2]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue2.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue2.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue2.Border}" /></Style>
    <Style Selector="^[Hue=3]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue3.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue3.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue3.Border}" /></Style>
    <Style Selector="^[Hue=4]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue4.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue4.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue4.Border}" /></Style>
    <Style Selector="^[Hue=5]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue5.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue5.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue5.Border}" /></Style>
    <Style Selector="^[Hue=6]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue6.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue6.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue6.Border}" /></Style>
    <Style Selector="^[Hue=7]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue7.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue7.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue7.Border}" /></Style>
    <Style Selector="^[Hue=8]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue8.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue8.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue8.Border}" /></Style>
    <Style Selector="^[Hue=9]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue9.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue9.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue9.Border}" /></Style>
    <Style Selector="^[Hue=10]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue10.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue10.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue10.Border}" /></Style>
    <Style Selector="^[Hue=11]"><Setter Property="Background" Value="{DynamicResource UIKit.Avatar.Hue11.Background}" /><Setter Property="Foreground" Value="{DynamicResource UIKit.Avatar.Hue11.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource UIKit.Avatar.Hue11.Border}" /></Style>
    <Style Selector="^:image">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
    </Style>

    <Style Selector="^.xsmall">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="FontSize" Value="10.4" />
    </Style>
    <Style Selector="^.xsmall /template/ TextBlock#PART_Initials">
      <Setter Property="LineHeight" Value="17" />
    </Style>
    <Style Selector="^.xsmall /template/ PathIcon#PART_Placeholder">
      <Setter Property="Width" Value="9.6" />
      <Setter Property="Height" Value="9.6" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^.small /template/ TextBlock#PART_Initials">
      <Setter Property="LineHeight" Value="19.5" />
    </Style>
    <Style Selector="^.small /template/ PathIcon#PART_Placeholder">
      <Setter Property="Width" Value="14.4" />
      <Setter Property="Height" Value="14.4" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Width" Value="80" />
      <Setter Property="Height" Value="80" />
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^.large /template/ TextBlock#PART_Initials">
      <Setter Property="LineHeight" Value="48.5" />
    </Style>
    <Style Selector="^.large /template/ PathIcon#PART_Placeholder">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type uikit:AvatarGroup}" TargetType="uikit:AvatarGroup">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          <!-- avatar_group.rs: the ellipsis is a "⋯" avatar 4px after the last shown one. -->
          <uikit:Avatar Name="PART_Ellipsis" UserName="⋯" Margin="4,0,0,0"
                       IsVisible="{TemplateBinding IsCut}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
