<!--
  GPUI Kit Rating (crates/component/src/rating.rs) -> gpui:Rating.
  Stars are the star icon (star-fill when filled) with 2px padding, in the
  foreground color, filled and previewed ones in the theme's yellow (or
  ActiveBrush). Sizes: xsmall (12px icons), small (14), the default (16),
  large (24).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gpui="using:AvaloniaUIKit">
  <ControlTheme x:Key="{x:Type gpui:Rating}" TargetType="gpui:Rating">
    <Setter Property="ActiveBrush" Value="{DynamicResource Gpui.Yellow}" />
    <Setter Property="Foreground" Value="{DynamicResource Gpui.Foreground}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Name="PART_Items" Orientation="Horizontal" Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^.xsmall">
      <Setter Property="StarSize" Value="12" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="StarSize" Value="14" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="StarSize" Value="24" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type gpui:RatingStar}" TargetType="gpui:RatingStar">
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <PathIcon Name="PART_Icon" Data="{StaticResource Gpui.Icon.Star}"
                    Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:filled /template/ PathIcon#PART_Icon">
      <Setter Property="Data" Value="{StaticResource Gpui.Icon.StarFill}" />
    </Style>
    <Style Selector="^:active /template/ PathIcon#PART_Icon">
      <Setter Property="Foreground" Value="{Binding $parent[gpui:RatingStar].ActiveBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
