<!--
  GPUI Kit Select (crates/component/src/select.rs) -> ComboBox / ComboBoxItem.
  Classes: xsmall small large (medium is the default); combobox (GPUI Kit's
  Combobox, combobox.rs: the same look, titled with the committed item only);
  clearButton (GPUI's cleanable: while an item is selected, a clear button
  stands in for the caret and clears the selection, ComboBox.Clear()).

  The trigger is the input frame (input_h, input_px, the input border and
  background) with the title or the muted placeholder and a muted chevron 4px
  after it. It shows the ring while focused or open; GPUI refocuses the
  trigger after every close, so the ring stays after a mouse selection too.
  Disabled, the frame fades to half.

  The popup opens 6px below the trigger (or above it when it flips), as wide as
  the trigger and at most 320px tall: the popover surface with its ring and
  two shadows, 4px of padding around rows rounded with the theme radius. The
  row under the keyboard cursor (Avalonia's focused item, the selected one
  when the popup opens) shows the accent, a hovered row the accent at 70%;
  the selected row has a check mark. On every open the popup slides 8px down
  and fades in over 150ms (ease-out-cubic); its ring and shadows fade by the
  fourth power of the progress (dropdown_popup in popover.rs). While open, the
  trigger shows the item under the cursor, as GPUI titles it from the list's
  cursor (Selects.CursorItem).

  IsEditable: the title becomes a text field (PART_EditableTextBox), GPUI's
  Input without its own frame inside the Select frame: the title's place and
  line, the placeholder, the caret and selection colors. The frame shows the
  ring while the field has focus. Avalonia's rules for an editable ComboBox
  apply: typing selects the item with that text, F4 or Alt+Down opens the
  list, a click on the text does not.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit"
                    xmlns:gconv="using:AvaloniaUIKit.Converters">
  <!-- The editable field: Input with appearance(false), no frame or padding of its own. -->
  <ControlTheme x:Key="UIKitComboBoxTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CaretBrush" Value="{DynamicResource UIKit.Caret}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource UIKit.Selection}" />
    <Setter Property="IsInactiveSelectionHighlightEnabled" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <!-- The input menu of the TextBox theme (TextBox.axaml). -->
    <Setter Property="ContextFlyout" Value="{DynamicResource UIKitTextBoxContextFlyout}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ScrollViewer Name="PART_ScrollViewer"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
            <Panel VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <TextBlock Name="PART_Placeholder"
                         Foreground="{TemplateBinding PlaceholderForeground}"
                         Text="{TemplateBinding PlaceholderText}"
                         LineHeight="{TemplateBinding LineHeight}"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <TextPresenter Name="PART_TextPresenter"
                             Text="{TemplateBinding Text, Mode=TwoWay}"
                             CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                             CaretIndex="{TemplateBinding CaretIndex}"
                             SelectionStart="{TemplateBinding SelectionStart}"
                             SelectionEnd="{TemplateBinding SelectionEnd}"
                             LineHeight="{TemplateBinding LineHeight}"
                             SelectionBrush="{TemplateBinding SelectionBrush}"
                             SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                             CaretBrush="{TemplateBinding CaretBrush}"
                             TextWrapping="NoWrap" />
            </Panel>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource UIKit.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Input}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5.5" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource UIKit.MutedForeground}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <!-- While open, the trigger shows the item under the cursor (Selects). -->
    <Setter Property="uikit:Selects.TracksCursor" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3" CornerRadius="7.5"
                  BorderBrush="{DynamicResource UIKit.FocusRing}" IsVisible="False" IsHitTestVisible="False" />
          <Border Name="PART_Background"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BackgroundSizing="OuterBorderEdge"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <TextBlock Name="PlaceholderTextBlock"
                         VerticalAlignment="Center"
                         Foreground="{TemplateBinding PlaceholderForeground}"
                         Text="{TemplateBinding PlaceholderText}"
                         LineHeight="22.5"
                         TextTrimming="CharacterEllipsis">
                <TextBlock.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="SelectionBoxItem" Converter="{x:Static ObjectConverters.IsNull}" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="!IsEditable" />
                  </MultiBinding>
                </TextBlock.IsVisible>
              </TextBlock>
              <ContentPresenter Name="ContentPresenter"
                                VerticalAlignment="Center"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                LineHeight="22.5"
                                TextTrimming="CharacterEllipsis"
                                IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}">
                <ContentPresenter.Content>
                  <MultiBinding Converter="{x:Static gconv:FirstNonNullConverter.Instance}">
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(uikit:Selects.CursorItem)" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="SelectionBoxItem" />
                  </MultiBinding>
                </ContentPresenter.Content>
              </ContentPresenter>
              <TextBox Name="PART_EditableTextBox"
                       Theme="{StaticResource UIKitComboBoxTextBox}"
                       Foreground="{TemplateBinding Foreground}"
                       PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                       PlaceholderText="{TemplateBinding PlaceholderText}"
                       Text="{TemplateBinding Text, Mode=TwoWay}"
                       LineHeight="22.5"
                       IsVisible="{TemplateBinding IsEditable}" />
              <PathIcon Name="PART_Caret" Grid.Column="1" VerticalAlignment="Center"
                        Data="{StaticResource UIKit.Icon.ChevronDown}" Foreground="{DynamicResource UIKit.MutedForeground}" />
              <Button Name="PART_ClearButton" Grid.Column="1"
                      Theme="{StaticResource UIKitClearButton}"
                      Command="{Binding $parent[ComboBox].Clear}"
                      IsVisible="False" />
            </Grid>
          </Border>
          <Popup Name="PART_Popup"
                 IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                 PlacementTarget="PART_Background"
                 Placement="BottomEdgeAlignedLeft"
                 IsLightDismissEnabled="True"
                 WindowManagerAddShadowHint="False"
                 InheritsTransform="True">
            <!-- 6px either side of the trigger: Avalonia keeps an offset's sign when the popup flips. -->
            <Border Padding="0,6" ClipToBounds="False">
            <Panel Name="PART_PopupMotion"
                   Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}">
              <Panel.RenderTransform>
                <TranslateTransform />
              </Panel.RenderTransform>
              <Border Name="PART_PopupRing" Margin="-1" CornerRadius="6"
                      Background="{DynamicResource UIKit.PopoverRing}" IsHitTestVisible="False" />
              <Border Name="PART_PopupShadow" CornerRadius="6"
                      BoxShadow="{StaticResource UIKit.Shadow.Popover}" IsHitTestVisible="False" />
              <Border Name="PART_PopupSurface" CornerRadius="6" ClipToBounds="True"
                      Background="{DynamicResource UIKit.Popover}"
                      TextElement.Foreground="{DynamicResource UIKit.PopoverForeground}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Panel>
                  <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
                    <ItemsPresenter Name="PART_ItemsPresenter" Margin="4" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  </ScrollViewer>
                  <!-- select.rs: an empty list shows a 28px Inbox icon in 24px of padding. -->
                  <Panel Name="PART_Empty" Height="76" IsVisible="False">
                    <PathIcon Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{StaticResource UIKit.Icon.Inbox}" Foreground="{DynamicResource UIKit.Select.Empty}" />
                  </Panel>
                </Panel>
              </Border>
            </Panel>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Tab goes straight into the editable field (as Fluent's theme does). -->
    <Style Selector="^[IsEditable=True]">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
    </Style>

    <!-- select.rs cleanable: with a value, the clear button stands in for the caret. -->
    <Style Selector="^.clearButton /template/ Button#PART_ClearButton">
      <Setter Property="IsVisible" Value="{Binding $parent[ComboBox].SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Style>
    <Style Selector="^.clearButton /template/ PathIcon#PART_Caret">
      <Setter Property="IsVisible" Value="{Binding $parent[ComboBox].SelectedItem, Converter={x:Static ObjectConverters.IsNull}}" />
    </Style>

    <!-- GPUI Kit's Combobox titles the trigger with the committed item only. -->
    <Style Selector="^.combobox">
      <Setter Property="uikit:Selects.TracksCursor" Value="False" />
    </Style>

    <Style Selector="^:empty /template/ Panel#PART_Empty">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:empty /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Sizes (sizing.rs): input_h, input_px, text size and line, caret 12/14/16/16. -->
    <Style Selector="^ /template/ PathIcon#PART_Caret">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="^.xsmall">
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^.xsmall /template/ PathIcon#PART_Caret">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="^.xsmall /template/ TextBlock#PlaceholderTextBlock, ^.xsmall /template/ ContentPresenter#ContentPresenter">
      <Setter Property="TextBlock.LineHeight" Value="19.5" />
    </Style>
    <Style Selector="^.xsmall /template/ TextBox#PART_EditableTextBox">
      <Setter Property="LineHeight" Value="19.5" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="^.small /template/ PathIcon#PART_Caret">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="^.large /template/ TextBlock#PlaceholderTextBlock, ^.large /template/ ContentPresenter#ContentPresenter">
      <Setter Property="TextBlock.LineHeight" Value="26" />
    </Style>
    <Style Selector="^.large /template/ TextBox#PART_EditableTextBox">
      <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style Selector="^:focus, ^:dropdownopen">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Ring}" />
    </Style>
    <Style Selector="^:focus /template/ Border#PART_FocusRing, ^:dropdownopen /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Editable, the focus is in the field. -->
    <Style Selector="^[IsEditable=True]:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Ring}" />
    </Style>
    <Style Selector="^[IsEditable=True]:focus-within /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource UIKit.Select.Disabled.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Danger}" />
    </Style>

    <!--
      dropdown_popup: 8px down and a fade over 150ms. GPUI scales the ring and
      shadow inks by the cube of the progress and then fades them with the rest,
      so they follow the fourth power: here the cube on the layers inside the
      panel's fade.
    -->
    <Style Selector="^:dropdownopen /template/ Panel#PART_PopupMotion">
      <Style.Animations>
        <Animation Duration="0:0:0.15" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:dropdownopen /template/ Border#PART_PopupRing, ^:dropdownopen /template/ Border#PART_PopupShadow">
      <Style.Animations>
        <Animation Duration="0:0:0.15" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.001" /></KeyFrame>
          <KeyFrame Cue="20%"><Setter Property="Opacity" Value="0.008" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="0.027" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="0.064" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.125" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="Opacity" Value="0.216" /></KeyFrame>
          <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.343" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="Opacity" Value="0.512" /></KeyFrame>
          <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.729" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              VerticalAlignment="Center"
                              LineHeight="22.5"
                              TextTrimming="CharacterEllipsis" />
            <!-- The check keeps its 12px slot when hidden. -->
            <PathIcon Name="PART_Check" Grid.Column="1" Classes="xsmall" VerticalAlignment="Center"
                      Data="{StaticResource UIKit.Icon.Check}" Foreground="{DynamicResource UIKit.Foreground}" Opacity="0" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource UIKit.Select.Row.Hover}" />
    </Style>
    <Style Selector="^:focus">
      <Setter Property="Background" Value="{DynamicResource UIKit.Accent}" />
    </Style>
    <Style Selector="^:selected /template/ PathIcon#PART_Check">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.MutedForeground}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
