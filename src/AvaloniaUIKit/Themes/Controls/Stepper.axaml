<!--
  GPUI Kit Stepper (crates/component/src/stepper) -> uikit:Stepper with
  uikit:StepperItem (the content is the label):

    <uikit:Stepper SelectedIndex="1">
      <uikit:StepperItem Content="Order Details" Icon="{StaticResource UIKit.Icon.Calendar}" />
      <uikit:StepperItem Content="Shipping" />
    </uikit:Stepper>

  A step is its indicator (a circle in secondary, primary when checked, with
  the number or the icon) and its label 4px below (8px beside when vertical),
  then a line from 4px after the indicator to 4px before the next one, at the
  indicator's middle: border color, primary after a passed step. Sizes
  (indicator, line, label): xsmall 8 / 1.5 / 12px with no number, small 18 /
  2 / 12px, medium 24 / 2 / 14px, large 32 / 3 / 14px. An unchecked
  indicator takes secondary_hover under the pointer and secondary_active
  pressed, unless the stepper is disabled. CentersSteps gives every step an
  equal share with the indicator and label centered.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit"
                    xmlns:gconv="using:AvaloniaUIKit.Converters">
  <ControlTheme x:Key="{x:Type uikit:Stepper}" TargetType="uikit:Stepper">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <uikit:StepperPanel Orientation="{Binding $parent[uikit:Stepper].Orientation}"
                           SharesEqually="{Binding $parent[uikit:Stepper].CentersSteps}" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type uikit:StepperItem}" TargetType="uikit:StepperItem">
    <Setter Property="FontSize" Value="14" />
    <!-- A centered step's line reaches into the next step. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Line" Height="2" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                  Background="{DynamicResource UIKit.Border}" />
          <StackPanel Name="PART_Trigger" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Background="{TemplateBinding Background}">
            <Border Name="PART_Indicator" Width="{TemplateBinding IndicatorSize}" Height="{TemplateBinding IndicatorSize}"
                    CornerRadius="{Binding $self.Bounds, Converter={x:Static gconv:AvatarConverters.Circle}}" HorizontalAlignment="Left"
                    Background="{DynamicResource UIKit.Secondary}">
              <Panel>
                <TextBlock Name="PART_Number" Text="{TemplateBinding Number}" LineHeight="22.5"
                           Foreground="{DynamicResource UIKit.SecondaryForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <PathIcon Name="PART_Icon" IsVisible="False" Data="{TemplateBinding Icon}" Width="14" Height="14"
                          Foreground="{DynamicResource UIKit.SecondaryForeground}" />
              </Panel>
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" LineHeight="22.5" />
          </StackPanel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- stepper/item.rs StepperSeparator: placed from the indicator's size and the step's width. -->
    <Style Selector="^ /template/ Border#PART_Line">
      <Setter Property="Margin">
        <MultiBinding Converter="{x:Static gconv:StepperConverters.LineMargin}">
          <Binding Path="$parent[uikit:StepperItem].Bounds" />
          <Binding Path="$parent[uikit:StepperItem].IsVertical" />
          <Binding Path="$parent[uikit:StepperItem].IsCentered" />
          <Binding Path="$parent[uikit:StepperItem].IndicatorSize" />
        </MultiBinding>
      </Setter>
    </Style>
    <Style Selector="^:icon /template/ PathIcon#PART_Icon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:icon /template/ TextBlock#PART_Number">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ Border#PART_Indicator:pointerover">
      <Setter Property="Background" Value="{DynamicResource UIKit.SecondaryHover}" />
    </Style>
    <Style Selector="^:indicator-pressed /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource UIKit.SecondaryActive}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource UIKit.Secondary}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource UIKit.Primary}" />
    </Style>
    <Style Selector="^:checked /template/ TextBlock#PART_Number">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.PrimaryForeground}" />
    </Style>
    <Style Selector="^:checked /template/ PathIcon#PART_Icon">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.PrimaryForeground}" />
    </Style>
    <Style Selector="^:passed /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource UIKit.Primary}" />
    </Style>
    <Style Selector="^:last /template/ Border#PART_Line">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- text_center: the trigger centered; the line from the middle plus half the indicator and 4px to the next middle. -->
    <Style Selector="^:centered /template/ StackPanel#PART_Trigger">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:centered /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:centered /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>


    <!-- Vertical: the indicator and the label side by side; the line down from 4px under the indicator. -->
    <Style Selector="^:vertical /template/ StackPanel#PART_Trigger">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="^:vertical /template/ Border#PART_Line">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="^.xsmall">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^.xsmall">
      <Setter Property="IndicatorSize" Value="8" />
    </Style>
    <Style Selector="^.xsmall /template/ Border#PART_Indicator > Panel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.xsmall /template/ Border#PART_Line">
      <Setter Property="Height" Value="1.5" />
    </Style>
    <Style Selector="^.xsmall /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="19.5" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="IndicatorSize" Value="18" />
    </Style>
    <Style Selector="^.small /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="19.5" />
    </Style>
    <Style Selector="^.small /template/ TextBlock#PART_Number">
      <Setter Property="LineHeight" Value="19.5" />
    </Style>
    <Style Selector="^.small /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="IndicatorSize" Value="32" />
    </Style>
    <Style Selector="^.large /template/ Border#PART_Line">
      <Setter Property="Height" Value="3" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
