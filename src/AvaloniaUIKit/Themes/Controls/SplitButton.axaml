<!--
  DO NOT EDIT. Generated by scripts/gen_split_theme.py.

  GPUI Kit DropdownButton -> SplitButton (crates/component/src/button/dropdown_button.rs).
  Classes: the Button's variants, outline and sizes (xsmall small large).
  The flyout opens below the right edge in GPUI (Anchor::TopRight): give the
  SplitButton's MenuFlyout Placement="BottomEdgeAlignedRight".
  Avalonia focuses a SplitButton as one stop; its ring shows on the action half,
  where GPUI's first Tab lands.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="UIKitSplitButtonPart" TargetType="Button">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter" BackgroundSizing="OuterBorderEdge"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{TemplateBinding Foreground}"
                            TextWrapping="NoWrap" RecognizesAccessKey="True" />
          <Border Name="PART_FocusRing" Margin="-3" BorderThickness="3"
                  CornerRadius="7.5,1.5,1.5,7.5"
                  BorderBrush="{DynamicResource UIKit.FocusRing}" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- The SplitButton marks the focused half through Tag, as a theme may not reach into a nested template. -->
    <Style Selector="^[Tag=focus-ring] /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

