      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Button.Text.Disabled.Border}" />
    </Style>
    <!-- text outline -->
    <Style Selector="^.text.outline /template/ Button#PART_PrimaryButton">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5.5,0,0,5.5" />
    </Style>
    <Style Selector="^.text.outline /template/ Button#PART_SecondaryButton">
      <Setter Property="BorderThickness" Value="0,1,1,1" />
      <Setter Property="CornerRadius" Value="0,5.5,5.5,0" />
    </Style>
    <Style Selector="^.text.outline /template/ PathIcon#PART_Caret">
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Outline.Caret}" />
    </Style>
    <Style Selector="^.text.outline /template/ Button">
      <Setter Property="Background" Value="{DynamicResource UIKit.Button.Text.Outline.Normal.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Outline.Normal.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Button.Text.Outline.Normal.Border}" />
    </Style>
    <Style Selector="^.text.outline /template/ Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource UIKit.Button.Text.Outline.Hover.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Outline.Hover.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Button.Text.Outline.Hover.Border}" />
    </Style>
    <Style Selector="^.text.outline /template/ Button:pressed">
      <Setter Property="Background" Value="{DynamicResource UIKit.Button.Text.Outline.Pressed.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Outline.Pressed.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Button.Text.Outline.Pressed.Border}" />
    </Style>
    <Style Selector="^.text.outline.selected /template/ Button, ^.text.outline:flyout-open /template/ Button#PART_SecondaryButton">
      <Setter Property="Background" Value="{DynamicResource UIKit.Button.Text.Outline.Selected.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Outline.Selected.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Button.Text.Outline.Selected.Border}" />
    </Style>
    <Style Selector="^.text.outline:disabled /template/ Button">
      <Setter Property="Background" Value="{DynamicResource UIKit.Button.Text.Outline.Disabled.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Button.Text.Outline.Disabled.Foreground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Button.Text.Outline.Disabled.Border}" />
    </Style>

    <Style Selector="^:focus-visible /template/ Button#PART_PrimaryButton">
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Ring}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Button#PART_PrimaryButton">
      <Setter Property="Tag" Value="focus-ring" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
