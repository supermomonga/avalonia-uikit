<!--
  GPUI Kit Progress -> ProgressBar (crates/component/src/progress/progress.rs)
  GPUI Kit Spinner -> ProgressBar with Theme="{StaticResource UIKitSpinner}"
  (crates/component/src/spinner.rs).
  Classes: xsmall small large (medium is the default).

  The bar is 4/6/8/10px high with half that as radius: the progress color over
  the same color at 20%. A value change animates the indicator's width over
  duration_normal (180ms) with easing_move, cubic-bezier(0.2, 0, 0, 1).

  Indeterminate (`loading`), GPUI repeats a 1s cycle in which, at phase d, the
  bar spans [W * e(max(0, 2d - 1)), W * e(d)] with e the quadratic ease-in-out.
  The right edge is a full-width bar sliding in from -W under that easing. The
  left edge is a right-aligned rounded clip whose width shrinks from W to 0 over
  the second half of each cycle; the bar inside it is right-aligned too, so it
  stays put. The visible bar is where the two meet, with both ends rounded.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit"
                    xmlns:gconv="using:AvaloniaUIKit.Converters">
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.ProgressBar.Fill}" />
    <Setter Property="Background" Value="{DynamicResource UIKit.Progress.Track}" />
    <Setter Property="Height" Value="8" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Border Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}">
              <!-- Value changes animate; the width the bar first settles into does not. -->
              <uikit:Motion.SettledTransitions>
                <Transitions>
                  <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="0.2,0,0,1" />
                </Transitions>
              </uikit:Motion.SettledTransitions>
            </Border>
            <Border Name="PART_IndeterminateClip" HorizontalAlignment="Right"
                    CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True" IsVisible="False">
              <Border Name="PART_IndeterminateBar" HorizontalAlignment="Right"
                      Width="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateEndingOffset}"
                      Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}">
                <Border.RenderTransform>
                  <TranslateTransform X="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateStartingOffset}" />
                </Border.RenderTransform>
              </Border>
            </Border>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.xsmall">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_IndeterminateClip">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Right edge: W * e(d), the bar sliding from -W to 0 over the whole cycle. -->
    <Style Selector="^:indeterminate /template/ Border#PART_IndeterminateBar">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite" Easing="QuadraticEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateStartingOffset}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Left edge: the clip spans [L, W] with L = W * e(2d - 1) in the second half. Its
         width W - L passes 0.6W and 0.4W where e reaches 0.4 and 0.6; between those
         points e is exactly a quadratic (KeySpline 1/3,0,2/3,1/3 and 1/3,2/3,2/3,1),
         and across the inflection a fitted spline stays within 0.0003 of it. -->
    <Style Selector="^:indeterminate /template/ Border#PART_IndeterminateClip">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Width" Value="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateEndingOffset}" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Width" Value="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateEndingOffset}" />
          </KeyFrame>
          <KeyFrame Cue="72.36068%" KeySpline="0.333333,0,0.666667,0.333333">
            <Setter Property="Width" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2Width}" />
          </KeyFrame>
          <KeyFrame Cue="77.63932%" KeySpline="0.45,0.424922,0.55,0.575078">
            <Setter Property="Width" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerWidth}" />
          </KeyFrame>
          <KeyFrame Cue="100%" KeySpline="0.333333,0.666667,0.666667,1">
            <Setter Property="Width" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

  <!-- Spinner: the Lucide loader at the size's icon size, one turn per 0.8s with
       a quadratic ease-in-out applied to each turn. It takes the text color. -->
  <ControlTheme x:Key="UIKitSpinner" TargetType="ProgressBar">
    <Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Indicator" IsVisible="False" />
          <PathIcon Name="PART_Icon" Data="{StaticResource UIKit.Icon.Loader}"
                    Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                    Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="50%,50%">
            <PathIcon.RenderTransform>
              <RotateTransform />
            </PathIcon.RenderTransform>
          </PathIcon>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.xsmall">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="^ /template/ PathIcon#PART_Icon">
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="Infinite" Easing="QuadraticEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

  <!--
    GPUI Kit ProgressCircle -> ProgressBar with Theme="{StaticResource UIKitProgressCircle}"
    (crates/component/src/progress/progress_circle.rs).
    Classes: xsmall small large (medium is the default); any other Width/Height works.

    A ring in the progress color at 20%, and over it the value's arc clockwise from
    12 o'clock with flat ends, both touching the box's edge; the stroke is 15% of
    the width, at most 5px. A value change sweeps the arc over 180ms (easing_move).
    Indeterminate, a 1s cycle: at phase d the arc spans [e(max(0, 2d - 1)), e(d)]
    of a turn, e the quadratic ease-in-out, keyframed exactly by quadratic splines.
  -->
  <gconv:AffineConverter x:Key="UIKit.ProgressCircle.Degrees" Scale="3.6" />
  <gconv:AffineConverter x:Key="UIKit.ProgressCircle.Stroke" Scale="0.15" Maximum="5" />
  <ControlTheme x:Key="UIKitProgressCircle" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource UIKit.ProgressBar}" />
    <Setter Property="Background" Value="{DynamicResource UIKit.Progress.Track}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The whole box takes the pointer, not only the ring. -->
        <Panel Background="Transparent">
          <Border Name="PART_Indicator" IsVisible="False" />
          <Ellipse Name="PART_Ring" Stroke="{TemplateBinding Background}"
                   StrokeThickness="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UIKit.ProgressCircle.Stroke}}" />
          <Arc Name="PART_Arc" Stroke="{TemplateBinding Foreground}" StartAngle="-90"
               StrokeThickness="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UIKit.ProgressCircle.Stroke}}"
               SweepAngle="{Binding Percentage, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UIKit.ProgressCircle.Degrees}}">
            <!-- Value changes sweep; the angle the arc first settles into does not. -->
            <uikit:Motion.SettledTransitions>
              <Transitions>
                <DoubleTransition Property="SweepAngle" Duration="0:0:0.18" Easing="0.2,0,0,1" />
              </Transitions>
            </uikit:Motion.SettledTransitions>
          </Arc>
          <Arc Name="PART_IndeterminateArc" Stroke="{TemplateBinding Foreground}" IsVisible="False"
               StrokeThickness="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UIKit.ProgressCircle.Stroke}}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.xsmall">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="^:indeterminate /template/ Arc#PART_Arc">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:indeterminate /template/ Arc#PART_IndeterminateArc">
      <Setter Property="IsVisible" Value="True" />
      <Style.Animations>
        <!-- start / 360 = 0, then 2(2d - 1)^2, then 1 - 8(1 - d)^2; offset by a quarter turn. -->
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="StartAngle" Value="-90" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="StartAngle" Value="-90" /></KeyFrame>
          <KeyFrame Cue="75%" KeySpline="0.333333,0,0.666667,0.333333"><Setter Property="StartAngle" Value="90" /></KeyFrame>
          <KeyFrame Cue="100%" KeySpline="0.333333,0.666667,0.666667,1"><Setter Property="StartAngle" Value="270" /></KeyFrame>
        </Animation>
        <!-- sweep / 360 = 2d^2, then -3 + 12d - 10d^2 (its peak at 0.6), then 6(1 - d)^2. -->
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="SweepAngle" Value="0" /></KeyFrame>
          <KeyFrame Cue="50%" KeySpline="0.333333,0,0.666667,0.333333"><Setter Property="SweepAngle" Value="180" /></KeyFrame>
          <KeyFrame Cue="60%" KeySpline="0.333333,0.666667,0.666667,1"><Setter Property="SweepAngle" Value="216" /></KeyFrame>
          <KeyFrame Cue="75%" KeySpline="0.333333,0,0.666667,0.333333"><Setter Property="SweepAngle" Value="135" /></KeyFrame>
          <KeyFrame Cue="100%" KeySpline="0.333333,0.666667,0.666667,1"><Setter Property="SweepAngle" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
