<!--
  GPUI Kit HoverCard (crates/component/src/hover_card.rs) -> uikit:HoverCard:

    <uikit:HoverCard Placement="Bottom">
      <TextBlock Text="@huacnlee" />
      <uikit:HoverCard.Card>...</uikit:HoverCard.Card>
    </uikit:HoverCard>

  The card is the popover surface (the FlyoutPresenter theme: background,
  ring, shadow-md, 12px padding, 4px from the trigger). GPUI never flips it:
  the popup slides to stay on screen.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit">
  <ControlTheme x:Key="{x:Type uikit:HoverCard}" TargetType="uikit:HoverCard">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_Trigger" Background="Transparent"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          <Popup Name="PART_Popup" PlacementTarget="{Binding #PART_Trigger}" Placement="{TemplateBinding Placement}"
                 IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}" IsLightDismissEnabled="False"
                 PlacementConstraintAdjustment="SlideX, SlideY">
            <FlyoutPresenter Name="PART_Card" Content="{TemplateBinding Card}" />
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
