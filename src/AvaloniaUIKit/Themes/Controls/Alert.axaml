<!--
  GPUI Kit Alert (crates/component/src/alert.rs) -> uikit:Alert.
  Classes: variant info success warning error (default: foreground on the
                   background); the variant color is the text and icon, at
                   4% the fill and at 30% the border
           size    xsmall (12x6 padding, 6 gap), small (12x8, 6), the default
                   medium (16x10, 12), large (20x14, 12, radius_lg)
           banner  no corners and no title; the row is centered
  The text is text_sm on GPUI's 22.5px line. The 14px icon sits 5px below the
  top of the first line; the close button (2px padding around a 16px icon,
  12px at xsmall and 14px at small) is at the top right and takes the fill at 80% on hover, 90% pressed.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit">
  <ControlTheme x:Key="UIKitAlertCloseButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <PathIcon Name="PART_Icon" Data="{StaticResource UIKit.Icon.Close}" Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <!-- The icon is the alert's size at most Medium (GPUI's Size::max returns the smaller). -->
  <ControlTheme x:Key="UIKitAlertCloseButtonXSmall" TargetType="Button" BasedOn="{StaticResource UIKitAlertCloseButton}">
    <Style Selector="^ /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="UIKitAlertCloseButtonSmall" TargetType="Button" BasedOn="{StaticResource UIKitAlertCloseButton}">
    <Style Selector="^ /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type uikit:Alert}" TargetType="uikit:Alert">
    <Setter Property="Background" Value="{DynamicResource UIKit.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource UIKit.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5.5" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Icon" Value="{StaticResource UIKit.Icon.Info}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                BackgroundSizing="OuterBorderEdge"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <DockPanel Name="PART_Row">
            <Button Name="PART_CloseButton" DockPanel.Dock="Right" Margin="12,0,0,0"
                    Theme="{StaticResource UIKitAlertCloseButton}"
                    IsVisible="{TemplateBinding IsClosable}" />
            <PathIcon Name="PART_Icon" DockPanel.Dock="Left" Width="14" Height="14"
                      Margin="0,5,12,0" VerticalAlignment="Top"
                      Data="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" />
            <StackPanel Name="PART_Text" VerticalAlignment="Top" ClipToBounds="True">
              <TextBlock Name="PART_Title" Text="{TemplateBinding Title}" FontWeight="SemiBold"
                         LineHeight="22.5" TextTrimming="CharacterEllipsis"
                         IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                LineHeight="22.5" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Button#PART_CloseButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Close.Hover}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_CloseButton:pressed">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Close.Pressed}" />
    </Style>

    <Style Selector="^.info">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Info.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Info}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Alert.Info.Border}" />
    </Style>
    <Style Selector="^.info /template/ Button#PART_CloseButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Info.Close.Hover}" />
    </Style>
    <Style Selector="^.info /template/ Button#PART_CloseButton:pressed">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Info.Close.Pressed}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Success.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Success}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Alert.Success.Border}" />
    </Style>
    <Style Selector="^.success /template/ Button#PART_CloseButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Success.Close.Hover}" />
    </Style>
    <Style Selector="^.success /template/ Button#PART_CloseButton:pressed">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Success.Close.Pressed}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Warning.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Warning}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Alert.Warning.Border}" />
    </Style>
    <Style Selector="^.warning /template/ Button#PART_CloseButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Warning.Close.Hover}" />
    </Style>
    <Style Selector="^.warning /template/ Button#PART_CloseButton:pressed">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Warning.Close.Pressed}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Error.Background}" />
      <Setter Property="Foreground" Value="{DynamicResource UIKit.Danger}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UIKit.Alert.Error.Border}" />
    </Style>
    <Style Selector="^.error /template/ Button#PART_CloseButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Error.Close.Hover}" />
    </Style>
    <Style Selector="^.error /template/ Button#PART_CloseButton:pressed">
      <Setter Property="Background" Value="{DynamicResource UIKit.Alert.Error.Close.Pressed}" />
    </Style>

    <Style Selector="^.xsmall">
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="^.xsmall /template/ PathIcon#PART_Icon, ^.small /template/ PathIcon#PART_Icon">
      <Setter Property="Margin" Value="0,5,6,0" />
    </Style>
    <Style Selector="^.xsmall /template/ Button#PART_CloseButton, ^.small /template/ Button#PART_CloseButton">
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="20,14" />
      <Setter Property="CornerRadius" Value="7.5" />
    </Style>
    <Style Selector="^.xsmall /template/ Button#PART_CloseButton">
      <Setter Property="Theme" Value="{StaticResource UIKitAlertCloseButtonXSmall}" />
    </Style>
    <Style Selector="^.small /template/ Button#PART_CloseButton">
      <Setter Property="Theme" Value="{StaticResource UIKitAlertCloseButtonSmall}" />
    </Style>

    <Style Selector="^.banner">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^.banner /template/ TextBlock#PART_Title">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.banner /template/ PathIcon#PART_Icon, ^.banner /template/ StackPanel#PART_Text, ^.banner /template/ Button#PART_CloseButton">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.banner /template/ PathIcon#PART_Icon">
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="^.banner.xsmall /template/ PathIcon#PART_Icon, ^.banner.small /template/ PathIcon#PART_Icon">
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
