<!--
  Sizes GPUI Kit uses everywhere. GPUI sizes are rem based; the rem is the
  theme font size, 16px (crates/component/src/root.rs). Component-specific
  sizes live with each control theme and cite their source.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uikit="using:AvaloniaUIKit">
  <!-- MotionTokens::spring_control and spring_move (crates/component/src/theme/motion.rs). -->
  <uikit:Spring x:Key="UIKit.Spring.Control" Response="0:0:0.18" Damping="1" Epsilon="0.001" />
  <uikit:Spring x:Key="UIKit.Spring.Move" Response="0:0:0.28" Damping="0.85" Epsilon="0.1" />
  <!-- Theme.font_family is ".SystemUIFont": the platform UI font. -->
  <FontFamily x:Key="UIKit.FontFamily">$Default</FontFamily>
  <!-- Theme.font_size (crates/component/src/theme/mod.rs). -->
  <x:Double x:Key="UIKit.FontSize">16</x:Double>
  <!-- text_xs / text_sm / text_base / text_lg. -->
  <x:Double x:Key="UIKit.FontSize.Xs">12</x:Double>
  <x:Double x:Key="UIKit.FontSize.Sm">14</x:Double>
  <x:Double x:Key="UIKit.FontSize.Base">16</x:Double>
  <x:Double x:Key="UIKit.FontSize.Lg">18</x:Double>
  <!-- Theme.radius / radius_lg. -->
  <CornerRadius x:Key="UIKit.Radius">6</CornerRadius>
  <CornerRadius x:Key="UIKit.RadiusLg">8</CornerRadius>
</ResourceDictionary>
