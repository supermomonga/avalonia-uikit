<!--
  Sizes GPUI Kit uses everywhere. GPUI sizes are rem based; the rem is the
  theme font size, 16px (crates/component/src/root.rs). Component-specific
  sizes live with each control theme and cite their source.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Theme.font_family is ".SystemUIFont": the platform UI font. -->
  <FontFamily x:Key="Gpui.FontFamily">$Default</FontFamily>
  <!-- Theme.font_size (crates/component/src/theme/mod.rs). -->
  <x:Double x:Key="Gpui.FontSize">16</x:Double>
  <!-- text_xs / text_sm / text_base / text_lg. -->
  <x:Double x:Key="Gpui.FontSize.Xs">12</x:Double>
  <x:Double x:Key="Gpui.FontSize.Sm">14</x:Double>
  <x:Double x:Key="Gpui.FontSize.Base">16</x:Double>
  <x:Double x:Key="Gpui.FontSize.Lg">18</x:Double>
  <!-- Theme.radius / radius_lg. -->
  <CornerRadius x:Key="Gpui.Radius">6</CornerRadius>
  <CornerRadius x:Key="Gpui.RadiusLg">8</CornerRadius>
</ResourceDictionary>
