<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AvaloniaUIKit</RootNamespace>
    <PackageId>AvaloniaUIKit</PackageId>
    <Description>Avalonia themes that reproduce the look and motion of GPUI Kit components.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AvaloniaXamlIlVerifyIl>true</AvaloniaXamlIlVerifyIl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
    <InternalsVisibleTo Include="AvaloniaUIKit.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The icon generator ships in this package (ADR 38): built first, packed as its analyzer with its settings. -->
    <ProjectReference Include="../AvaloniaUIKit.Generators/AvaloniaUIKit.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../AvaloniaUIKit.Generators/bin/$(Configuration)/netstandard2.0/AvaloniaUIKit.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive/AvaloniaUIKit.props;buildTransitive/AvaloniaUIKit.targets" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>
</Project>
