diff -ruN a/crates/base/src/test_clock.rs b/crates/base/src/test_clock.rs
--- a/crates/base/src/test_clock.rs
+++ b/crates/base/src/test_clock.rs
@@ -0,0 +1,19 @@
+//! Reference-harness instrumentation (not part of upstream gpui-kit).
+//!
+//! The scrollbar samples its motion with `Instant::now()`. The harness pins
+//! that reading to the test executor's clock so captures are deterministic.
+use std::cell::Cell;
+
+thread_local! {
+    static NOW: Cell<Option<instant::Instant>> = const { Cell::new(None) };
+}
+
+/// Overrides the time returned by [`now`] on this thread; `None` restores the wall clock.
+pub fn set(now: Option<instant::Instant>) {
+    NOW.with(|cell| cell.set(now));
+}
+
+/// The overridden time, or the wall clock when no override is set.
+pub fn now() -> instant::Instant {
+    NOW.with(|cell| cell.get()).unwrap_or_else(instant::Instant::now)
+}
