<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="clr-namespace:AvaloniaUIKit;assembly=AvaloniaUIKit"
             xmlns:uikitcolor="clr-namespace:AvaloniaUIKit;assembly=AvaloniaUIKit.ColorPicker"
             xmlns:uikittabs="clr-namespace:AvaloniaUIKit;assembly=AvaloniaUIKit.Tabalonia"
             x:Class="AvaloniaUIKit.AotSmoke.App">
  <Application.Styles>
    <uikit:UIKitTheme />
    <uikitcolor:UIKitColorPickerTheme />
    <uikittabs:UIKitTabaloniaTheme />
  </Application.Styles>
</Application>
