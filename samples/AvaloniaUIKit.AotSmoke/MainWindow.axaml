<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AvaloniaUIKit.AotSmoke"
        x:Class="AvaloniaUIKit.AotSmoke.MainWindow"
        Title="AvaloniaUIKit gallery" Width="760" Height="860">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Margin="8">
      <MenuItem Header="File">
        <MenuItem Header="New File" />
        <MenuItem Header="Refresh" InputGesture="F5" />
        <Separator />
        <MenuItem Header="Quit" />
      </MenuItem>
      <MenuItem Header="Edit">
        <MenuItem Header="Undo" />
        <MenuItem Header="Redo" />
      </MenuItem>
    </Menu>
    <ScrollViewer AllowAutoHide="True">
      <StackPanel Margin="16" Spacing="20">
        <TextBlock Text="Button" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Content="Default" ToolTip.Tip="A tooltip" />
          <Button Classes="primary" Content="Primary" />
          <Button Classes="secondary" Content="Secondary" />
          <Button Classes="danger" Content="Danger" />
          <Button Classes="warning" Content="Warning" />
          <Button Classes="success" Content="Success" />
          <Button Classes="info" Content="Info" />
          <Button Classes="ghost" Content="Ghost" />
          <Button Classes="link" Content="Link" />
          <Button Classes="text" Content="Text" />
          <Button Classes="primary outline" Content="Outline" />
          <Button Classes="small" Content="Small" />
          <Button Classes="large" Content="Large" />
          <Button Classes="icon-only ghost">
            <PathIcon Data="{StaticResource Gpui.Icon.Copy}" />
          </Button>
          <Button Content="Disabled" IsEnabled="False" />
        </WrapPanel>

        <TextBlock Text="SplitButton" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <SplitButton Content="Save">
            <SplitButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Save As..." />
                <MenuItem Header="Save All" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <SplitButton Classes="primary" Content="Deploy" />
          <SplitButton Classes="ghost" Content="Ghost" />
        </WrapPanel>

        <TextBlock Text="Toggle, Checkbox, Radio, Switch" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <WrapPanel ItemSpacing="12" LineSpacing="8">
          <ToggleButton Content="Bold" IsChecked="True" />
          <ToggleButton Classes="outline" Content="Italic" />
          <CheckBox Content="Accept" IsChecked="True" />
          <CheckBox Content="Disabled" IsEnabled="False" />
          <RadioButton Content="Express" GroupName="ship" IsChecked="True" />
          <RadioButton Content="Standard" GroupName="ship" />
          <ToggleSwitch Content="Wi-Fi" IsChecked="True" />
          <ToggleSwitch Classes="small" Content="Bluetooth" />
        </WrapPanel>

        <TextBlock Text="NumericUpDown, Slider, ProgressBar, Spinner" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <StackPanel Spacing="12" HorizontalAlignment="Left">
          <NumericUpDown Value="42" Width="160" />
          <Slider Value="40" Width="240" HorizontalAlignment="Left" />
          <ProgressBar Value="40" Width="240" />
          <ProgressBar IsIndeterminate="True" Width="240" />
          <ProgressBar Theme="{StaticResource GpuiSpinner}" Classes="large" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ProgressBar Theme="{StaticResource GpuiProgressCircle}" Value="60" />
            <ProgressBar Theme="{StaticResource GpuiProgressCircle}" Classes="large" IsIndeterminate="True" />
          </StackPanel>
        </StackPanel>

                <TextBlock Text="ButtonGroup, ToggleGroup, Icon, Label" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <WrapPanel ItemSpacing="12" LineSpacing="8">
          <StackPanel Classes="button-group" Orientation="Horizontal">
            <Button Classes="outline" Content="One" />
            <Button Classes="outline" Content="Two" />
            <Button Classes="outline" Content="Three" />
          </StackPanel>
          <ListBox Classes="toggle-group" SelectionMode="Multiple,Toggle">
            <ListBoxItem Content="Bold" />
            <ListBoxItem Content="Italic" />
          </ListBox>
          <PathIcon Classes="large" Data="{StaticResource Gpui.Icon.Folder}" />
          <TextBlock Classes="label">Company address<Run Classes="secondary"> (optional)</Run></TextBlock>
        </WrapPanel>

        <TextBlock Text="Accordion, Collapsible" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <Border Classes="accordion" Width="320" HorizontalAlignment="Left">
          <StackPanel Classes="accordion">
            <Expander Header="Is it accessible?" Content="Yes, it is." IsExpanded="True" />
            <Expander Header="Is it animated?" Content="Yes, with a spring." />
          </StackPanel>
        </Border>
        <Expander Theme="{StaticResource GpuiCollapsible}" Classes="reveal" Header="Order details" Width="320" HorizontalAlignment="Left">
          <TextBlock Text="Details" Margin="0,8,0,0" />
        </Expander>

        <TextBlock Text="Resizable" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <Grid ColumnDefinitions="120,1,*" Width="320" Height="80" HorizontalAlignment="Left">
          <TextBlock Text="One" Margin="8" />
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
          <TextBlock Grid.Column="2" Text="Two" Margin="8" />
        </Grid>

        <TextBlock Text="Calendar" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Calendar SelectedDate="2025-03-14" DisplayDate="2025-03-14" />
          <Calendar DisplayMode="Year" DisplayDate="2025-03-14" Classes="small" />
        </StackPanel>

        <CalendarDatePicker Width="220" HorizontalAlignment="Left" SelectedDateFormat="Custom"
                            CustomDateFormatString="yyyy/MM/dd" PlaceholderText="Select date" />

        <TimePicker SelectedTime="09:30" ClockIdentifier="24HourClock" />

        <TextBlock Text="Table" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <TableView Theme="{StaticResource GpuiTable}" Classes="stripe" Width="360" HorizontalAlignment="Left"
                   ItemsSource="{x:Static local:Invoice.Samples}">
          <TableView.Columns>
            <TableViewColumn Header="Invoice" Binding="{Binding Id}" />
            <TableViewColumn Header="Method" Binding="{Binding Method}" />
            <TableViewColumn Header="Amount" Binding="{Binding Amount}" HorizontalContentAlignment="Right" />
          </TableView.Columns>
        </TableView>
        <TableView Classes="small" Width="360" Height="124" HorizontalAlignment="Left"
                   ItemsSource="{x:Static local:Invoice.Samples}">
          <TableView.Columns>
            <TableViewColumn Header="Invoice" Binding="{Binding Id}" Width="120" />
            <TableViewColumn Header="Method" Binding="{Binding Method}" Width="140" />
            <TableViewColumn Header="Amount" Binding="{Binding Amount}" Width="80" HorizontalContentAlignment="Right" />
          </TableView.Columns>
        </TableView>

        <TextBlock Text="Carousel" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <StackPanel Spacing="16" Width="240" Margin="48,0" HorizontalAlignment="Left">
          <Panel>
            <Carousel Name="Slides" Focusable="True">
              <Border Height="120" CornerRadius="7.5" BorderThickness="1" BackgroundSizing="OuterBorderEdge"
                      Background="{DynamicResource Gpui.Muted}" BorderBrush="{DynamicResource Gpui.Border}">
                <TextBlock Text="1" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Height="120" CornerRadius="7.5" BorderThickness="1" BackgroundSizing="OuterBorderEdge"
                      Background="{DynamicResource Gpui.Muted}" BorderBrush="{DynamicResource Gpui.Border}">
                <TextBlock Text="2" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Carousel>
            <Button Classes="outline icon-only rounded-full" Margin="-48,0,0,0" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Click="OnPreviousSlide">
              <PathIcon Data="{StaticResource Gpui.Icon.ChevronLeft}" />
            </Button>
            <Button Classes="outline icon-only rounded-full" Margin="0,0,-48,0" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="OnNextSlide">
              <PathIcon Data="{StaticResource Gpui.Icon.ChevronRight}" />
            </Button>
          </Panel>
          <PipsPager Classes="carousel" NumberOfPages="2" HorizontalAlignment="Center"
                     SelectedPageIndex="{Binding #Slides.SelectedIndex, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Text="Sidebar" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <SplitView DisplayMode="CompactInline" IsPaneOpen="True" OpenPaneLength="200" Width="400" Height="120"
                   HorizontalAlignment="Left">
          <Border Background="{DynamicResource Gpui.Muted}" />
        </SplitView>
        <DrawerPage DrawerLayoutBehavior="CompactInline" IsOpen="False" Width="400" Height="120"
                    HorizontalAlignment="Left">
          <DrawerPage.DrawerHeader>
            <TextBlock Text="Workspace" VerticalAlignment="Center" />
          </DrawerPage.DrawerHeader>
          <Border Background="{DynamicResource Gpui.Muted}" />
        </DrawerPage>

        <TextBlock Text="Sheet" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <DrawerPage Classes="sheet" DrawerBehavior="Flyout" DrawerPlacement="Right" DrawerHeader="Settings"
                    IsOpen="True" Width="400" Height="200" HorizontalAlignment="Left">
          <DrawerPage.Drawer>
            <TextBlock Text="Sheet content" />
          </DrawerPage.Drawer>
          <Border Background="{DynamicResource Gpui.Muted}" />
        </DrawerPage>

        <TextBlock Text="Popover" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <Button Classes="outline" Content="Open" HorizontalAlignment="Left">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" PlacementConstraintAdjustment="SlideX, SlideY" FlyoutPresenterClasses="arrow">
              <TextBlock Text="Popover content" />
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBlock Text="Toolbar" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <CommandBar Content="Files">
          <CommandBarButton>
            <CommandBarButton.Icon><PathIcon Data="{StaticResource Gpui.Icon.Undo2}" /></CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarButton>
            <CommandBarButton.Icon><PathIcon Data="{StaticResource Gpui.Icon.Redo2}" /></CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarSeparator />
          <CommandBarButton Label="New">
            <CommandBarButton.Icon><PathIcon Data="{StaticResource Gpui.Icon.Plus}" /></CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarSeparator />
          <CommandBarToggleButton Label="B" IsChecked="True" />
        </CommandBar>

        <TextBlock Text="Input, Textarea, InputGroup" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <StackPanel Spacing="12" HorizontalAlignment="Left" Width="320">
          <TextBox PlaceholderText="Your name" />
          <TextBox Classes="revealPasswordButton" PasswordChar="•" Text="secret" />
          <TextBox AcceptsReturn="True" MinLines="3" Text="Multi-line" />
          <TextBox Classes="group" PlaceholderText="Search" />
        </StackPanel>

        <TextBlock Text="List, Select, Combobox, Tree, Tabs, Pagination" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <StackPanel Spacing="12" HorizontalAlignment="Left">
          <ListBox Width="240" Height="120">
            <ListBoxItem Content="Apple" />
            <ListBoxItem Content="Banana" />
            <ListBoxItem Content="Cherry" />
          </ListBox>
          <ComboBox Width="200" PlaceholderText="Select a fruit">
            <ComboBoxItem Content="Apple" />
            <ComboBoxItem Content="Banana" />
          </ComboBox>
          <ComboBox Classes="combobox" Width="200" SelectedIndex="0">
            <ComboBoxItem Content="Apple" />
            <ComboBoxItem Content="Banana" />
          </ComboBox>
          <AutoCompleteBox Width="200" PlaceholderText="Fruit" />
          <TreeView Width="240">
            <TreeViewItem Header="src" IsExpanded="True">
              <TreeViewItem Header="main.rs" />
            </TreeViewItem>
            <TreeViewItem Header="Cargo.toml" />
          </TreeView>
          <TabStrip Classes="pill" SelectedIndex="0">
            <TabStripItem Content="Account" />
            <TabStripItem Content="Profile" />
            <TabStripItem Content="Settings" />
          </TabStrip>
          <TabControl Classes="underline" Width="320" HorizontalAlignment="Left">
            <TabItem Header="Account"><TextBlock Text="Account settings" Margin="0,8" /></TabItem>
            <TabItem Header="Profile"><TextBlock Text="Profile" Margin="0,8" /></TabItem>
          </TabControl>
          <PipsPager NumberOfPages="5" SelectedPageIndex="2" />
          <PipsPager Classes="compact small" NumberOfPages="5" SelectedPageIndex="0" />
        </StackPanel>

        <TextBlock Text="GroupBox, Separator, Link" Foreground="{DynamicResource Gpui.MutedForeground}" />
        <GroupBox Classes="outline" Header="Account" Content="Content" Width="320" HorizontalAlignment="Left" />
        <Separator Width="320" HorizontalAlignment="Left" />
        <Separator Classes="dashed" Width="320" HorizontalAlignment="Left" />
        <HyperlinkButton Content="Documentation" />

        <Border Width="200" Height="64" BorderThickness="1" Background="Transparent"
                BorderBrush="{DynamicResource Gpui.Border}" HorizontalAlignment="Left">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copy" InputGesture="F5" />
              <MenuItem Header="Word Wrap" ToggleType="CheckBox" IsChecked="True" />
              <Separator />
              <MenuItem Header="More">
                <MenuItem Header="Paste" />
              </MenuItem>
            </ContextMenu>
          </Border.ContextMenu>
          <TextBlock Text="Right-click" Margin="8" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
