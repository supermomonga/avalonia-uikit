<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             xmlns:demos="using:AvaloniaUIKit.Demos"
             x:Class="AvaloniaUIKit.Previews.OgImage"
             Width="1200" Height="630">
  <!-- The social image (sites/public/og.png): the site's name beside real controls, drawn by the theme itself. -->
  <Grid ColumnDefinitions="580,*" Background="{DynamicResource UIKit.Background}">
    <StackPanel Margin="72,0,0,0" VerticalAlignment="Center" Spacing="20">
      <Border Width="56" Height="56" CornerRadius="14" BorderThickness="4" BorderBrush="{DynamicResource UIKit.Foreground}" HorizontalAlignment="Left">
        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource UIKit.Blue}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" />
      </Border>
      <TextBlock Text="Avalonia UIKit" FontSize="64" FontWeight="SemiBold" LineHeight="70" Foreground="{DynamicResource UIKit.Foreground}" />
      <TextBlock Text="Nova-style themes and controls for Avalonia, based on shadcn/ui and GPUI Kit. Light and dark, verified pixel by pixel."
                 FontSize="22" LineHeight="30" TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Left"
                 Foreground="{DynamicResource UIKit.MutedForeground}" />
      <TextBlock Text="avalonia-uikit.omofla.sh" FontSize="18" Foreground="{DynamicResource UIKit.MutedForeground}" />
    </StackPanel>
    <Border Grid.Column="1" Margin="0,48,0,0" Padding="36,32" CornerRadius="20,0,0,20" BorderThickness="1,1,0,1"
            BorderBrush="{DynamicResource UIKit.Border}" Background="{DynamicResource UIKit.Background}" ClipToBounds="True">
      <LayoutTransformControl HorizontalAlignment="Left" VerticalAlignment="Top">
        <LayoutTransformControl.LayoutTransform>
          <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
        </LayoutTransformControl.LayoutTransform>
        <StackPanel Spacing="26" Width="640">
          <demos:ButtonDemo />
          <Grid ColumnDefinitions="Auto,28,*">
            <demos:CalendarDemo VerticalAlignment="Top" />
            <StackPanel Grid.Column="2" Spacing="20" VerticalAlignment="Top">
              <demos:SwitchDemo />
              <demos:CheckboxDemo />
              <demos:SliderDemo />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="28">
            <demos:BadgeDemo VerticalAlignment="Center" />
            <demos:AvatarDemo VerticalAlignment="Center" />
            <demos:TagDemo VerticalAlignment="Center" />
            <demos:RatingDemo VerticalAlignment="Center" />
          </StackPanel>
          <demos:StepperDemo />
          <StackPanel Orientation="Horizontal" Spacing="28">
            <demos:TabsDemo />
            <StackPanel Spacing="14" VerticalAlignment="Top">
              <demos:ToolbarDemo />
              <demos:ButtonGroupDemo />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </LayoutTransformControl>
    </Border>
  </Grid>
</UserControl>
