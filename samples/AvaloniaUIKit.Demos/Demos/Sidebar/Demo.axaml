<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gpui="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.SidebarDemo">
  <SplitView DisplayMode="CompactInline" OpenPaneLength="200" IsPaneOpen="{Binding #PaneToggle.IsChecked}"
             Width="480" Height="220" HorizontalAlignment="Left">
    <SplitView.Pane>
      <StackPanel Margin="12" Spacing="12">
        <TextBlock Text="Workspace" FontWeight="Medium" Margin="4,0" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
          <PathIcon Data="{StaticResource Gpui.Icon.Inbox}" />
          <TextBlock Text="Inbox" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
          <PathIcon Data="{StaticResource Gpui.Icon.Star}" />
          <TextBlock Text="Starred" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
          <PathIcon Data="{StaticResource Gpui.Icon.Folder}" />
          <TextBlock Text="Projects" />
        </StackPanel>
      </StackPanel>
    </SplitView.Pane>
    <Border Background="{DynamicResource Gpui.Muted}">
      <ToggleButton Name="PaneToggle" Classes="outline" IsChecked="True" Margin="8"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
        <PathIcon Data="{StaticResource Gpui.Icon.PanelLeftClose}" />
      </ToggleButton>
    </Border>
  </SplitView>
</UserControl>
