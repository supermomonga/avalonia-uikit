<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.SelectClearable">
  <Panel MinHeight="200">
    <WrapPanel ItemSpacing="8" LineSpacing="8" VerticalAlignment="Top">
      <ComboBox Classes="clearButton" Width="200" SelectedIndex="1">
        <ComboBoxItem Content="Apple" />
        <ComboBoxItem Content="Banana" />
        <ComboBoxItem Content="Cherry" />
      </ComboBox>
      <ComboBox Classes="clearButton" Width="200" PlaceholderText="Select a fruit">
        <ComboBoxItem Content="Apple" />
        <ComboBoxItem Content="Banana" />
        <ComboBoxItem Content="Cherry" />
      </ComboBox>
    </WrapPanel>
  </Panel>
</UserControl>
