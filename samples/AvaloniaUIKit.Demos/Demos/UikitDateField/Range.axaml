<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.UikitDateFieldRange">
  <Panel MinHeight="360">
    <uikit:DateField Width="260" IsRange="True" NumberOfMonths="2" IsCleanable="True"
                     Date="2025-03-07" EndDate="2025-03-14"
                     HorizontalAlignment="Left" VerticalAlignment="Top">
      <uikit:DateField.Presets>
        <uikit:DateRangePreset Label="Last 7 Days" Date="2025-03-07" EndDate="2025-03-14" />
        <uikit:DateRangePreset Label="Last 14 Days" Date="2025-02-28" EndDate="2025-03-14" />
        <uikit:DateRangePreset Label="Last 30 Days" Date="2025-02-12" EndDate="2025-03-14" />
      </uikit:DateField.Presets>
    </uikit:DateField>
  </Panel>
</UserControl>
