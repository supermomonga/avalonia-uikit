<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.ClipboardDemo">
  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
    <TextBlock Text="dotnet add package AvaloniaUIKit" VerticalAlignment="Center" />
    <uikit:Clipboard Text="dotnet add package AvaloniaUIKit" />
  </StackPanel>
</UserControl>
