<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gpui="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.ClipboardSizes">
  <WrapPanel ItemSpacing="8" LineSpacing="8">
    <gpui:Clipboard Classes="xsmall" Text="Copied text" />
    <gpui:Clipboard Classes="small" Text="Copied text" />
    <gpui:Clipboard Text="Copied text" />
    <gpui:Clipboard Classes="large" Text="Copied text" />
  </WrapPanel>
</UserControl>
