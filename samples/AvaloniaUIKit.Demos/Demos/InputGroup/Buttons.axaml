<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gpui="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.InputGroupButtons">
  <StackPanel Spacing="12" Width="280" HorizontalAlignment="Left">
    <TextBox Classes="group" Text="gpui">
      <TextBox.InnerRightContent>
        <Button Content="Clear" />
      </TextBox.InnerRightContent>
    </TextBox>
    <TextBox Classes="group" Text="gpui">
      <TextBox.InnerRightContent>
        <Button Classes="icon-only">
          <PathIcon Data="{StaticResource Gpui.Icon.Close}" />
        </Button>
      </TextBox.InnerRightContent>
    </TextBox>
    <TextBox Classes="group" AcceptsReturn="True" MinLines="3" MaxLines="3" PlaceholderText="Write a message">
      <TextBox.InnerRightContent>
        <Button Content="Send" />
      </TextBox.InnerRightContent>
    </TextBox>
  </StackPanel>
</UserControl>
