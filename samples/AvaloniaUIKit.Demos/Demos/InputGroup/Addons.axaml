<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.InputGroupAddons">
  <StackPanel Spacing="12" Width="280" HorizontalAlignment="Left">
    <TextBox Classes="group" Text="example" InnerLeftContent="https://" InnerRightContent=".com" />
    <TextBox Classes="group" Text="Read only" InnerRightContent="Saving" IsReadOnly="True" />
  </StackPanel>
</UserControl>
