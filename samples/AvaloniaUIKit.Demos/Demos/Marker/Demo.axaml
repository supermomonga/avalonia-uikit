<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.MarkerDemo">
  <StackPanel Spacing="16" Width="420" HorizontalAlignment="Left">
    <uikit:Marker Content="Conversation archived">
      <uikit:Marker.Icon>
        <PathIcon Data="{StaticResource UIKit.Icon.Info}" />
      </uikit:Marker.Icon>
    </uikit:Marker>
    <uikit:Marker Classes="separator" Content="Today" />
    <uikit:Marker Classes="border" Content="Earlier messages" />
  </StackPanel>
</UserControl>
