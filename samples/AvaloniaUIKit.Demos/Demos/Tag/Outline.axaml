<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gpui="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.TagOutline">
  <WrapPanel ItemSpacing="8" LineSpacing="8">
    <gpui:TagLabel Classes="outline" Content="Primary" />
    <gpui:TagLabel Classes="secondary outline" Content="Secondary" />
    <gpui:TagLabel Classes="danger outline" Content="Danger" />
    <gpui:TagLabel Classes="success outline" Content="Success" />
    <gpui:TagLabel Classes="warning outline" Content="Warning" />
    <gpui:TagLabel Classes="info outline" Content="Info" />
  </WrapPanel>
</UserControl>
