<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.LinkInline">
  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
    <TextBlock Text="Read the" VerticalAlignment="Center" />
    <HyperlinkButton Content="getting started guide" NavigateUri="https://avalonia-uikit.omofla.sh" VerticalAlignment="Center" />
    <TextBlock Text="or browse the" VerticalAlignment="Center" />
    <HyperlinkButton Content="source on GitHub" NavigateUri="https://github.com/supermomonga/avalonia-uikit" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
