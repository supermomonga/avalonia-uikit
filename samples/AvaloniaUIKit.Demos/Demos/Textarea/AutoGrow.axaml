<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gpui="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.TextareaAutoGrow">
  <StackPanel Spacing="12" Width="280" HorizontalAlignment="Left">
    <TextBox AcceptsReturn="True" MinLines="2" MaxLines="5" Text="One" />
    <TextBox AcceptsReturn="True" MinLines="2" MaxLines="5" Text="One&#10;Two&#10;Three&#10;Four" />
  </StackPanel>
</UserControl>
