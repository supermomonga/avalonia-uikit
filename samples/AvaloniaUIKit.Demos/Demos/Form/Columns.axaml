<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.FormColumns">
  <uikit:Form Columns="2" Width="520" HorizontalAlignment="Left">
    <uikit:FormField Label="First name">
      <TextBox PlaceholderText="Enter first name" />
    </uikit:FormField>
    <uikit:FormField Label="Last name">
      <TextBox PlaceholderText="Enter last name" />
    </uikit:FormField>
    <uikit:FormField Label="Address" ColumnSpan="2">
      <TextBox PlaceholderText="Enter address" />
    </uikit:FormField>
    <uikit:Form.Footer>
      <Button Classes="primary" Content="Save" />
    </uikit:Form.Footer>
  </uikit:Form>
</UserControl>
