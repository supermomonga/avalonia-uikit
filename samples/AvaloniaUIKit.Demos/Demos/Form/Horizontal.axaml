<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.FormHorizontal">
  <StackPanel Spacing="24" Width="360" HorizontalAlignment="Left">
    <uikit:Form LabelOrientation="Horizontal">
      <uikit:FormField Label="First name">
        <TextBox PlaceholderText="Enter first name" />
      </uikit:FormField>
      <uikit:FormField Label="Last name" IsRequired="True">
        <TextBox PlaceholderText="Enter last name" />
      </uikit:FormField>
      <uikit:FormField Label="Email" Description="Used for sign in.">
        <TextBox PlaceholderText="Enter email" />
      </uikit:FormField>
    </uikit:Form>
    <uikit:Form LabelOrientation="Horizontal" LabelWidth="100">
      <uikit:FormField Label="Name">
        <TextBox PlaceholderText="Enter name" />
      </uikit:FormField>
      <uikit:FormField Label="Email">
        <TextBox PlaceholderText="Enter email" />
      </uikit:FormField>
    </uikit:Form>
  </StackPanel>
</UserControl>
