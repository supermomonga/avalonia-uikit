<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.FormSizes">
  <StackPanel Spacing="24" Width="360" HorizontalAlignment="Left">
    <uikit:Form Classes="small">
      <uikit:FormField Label="Name">
        <TextBox Classes="small" PlaceholderText="Enter name" />
      </uikit:FormField>
      <uikit:FormField Label="Email" IsRequired="True" Description="We will never share your email.">
        <TextBox Classes="small" PlaceholderText="Enter email" />
      </uikit:FormField>
      <uikit:Form.Footer>
        <Button Classes="primary small" Content="Save" />
      </uikit:Form.Footer>
    </uikit:Form>
    <uikit:Form Classes="large">
      <uikit:FormField Label="Name">
        <TextBox Classes="large" PlaceholderText="Enter name" />
      </uikit:FormField>
      <uikit:FormField Label="Email" IsRequired="True" Description="We will never share your email.">
        <TextBox Classes="large" PlaceholderText="Enter email" />
      </uikit:FormField>
      <uikit:Form.Footer>
        <Button Classes="primary large" Content="Save" />
      </uikit:Form.Footer>
    </uikit:Form>
  </StackPanel>
</UserControl>
