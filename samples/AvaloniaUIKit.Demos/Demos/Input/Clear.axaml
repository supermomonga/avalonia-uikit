<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.InputClear">
  <StackPanel Spacing="12" Width="240" HorizontalAlignment="Left">
    <TextBox Classes="clearButton" Text="Hello world" PlaceholderText="Type something" />
    <TextBox Classes="revealPasswordButton clearButton" PasswordChar="•" Text="password123" />
  </StackPanel>
</UserControl>
