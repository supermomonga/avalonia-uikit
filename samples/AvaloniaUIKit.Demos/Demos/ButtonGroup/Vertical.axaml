<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.ButtonGroupVertical">
  <StackPanel Orientation="Horizontal" Spacing="16">
    <StackPanel Classes="button-group" Orientation="Vertical">
      <Button Classes="outline" Content="One" />
      <Button Classes="outline" Content="Two" />
      <Button Classes="outline" Content="Three" />
    </StackPanel>
    <StackPanel Classes="button-group" Orientation="Vertical">
      <Button Classes="primary" Content="One" />
      <Button Classes="primary" Content="Two" />
      <Button Classes="primary" Content="Three" />
    </StackPanel>
  </StackPanel>
</UserControl>
