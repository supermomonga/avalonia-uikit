<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.TabsReorder">
  <TabStrip Classes="pill" SelectedIndex="0" uikit:Tabs.Reorderable="True">
    <TabStripItem Content="Account" />
    <TabStripItem Content="Profile" />
    <TabStripItem Content="Settings" />
    <TabStripItem Content="Billing" />
    <TabStripItem Content="Notifications" />
  </TabStrip>
</UserControl>
