<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.GroupBoxDemo">
  <GroupBox Classes="outline" Header="Account" Width="320" HorizontalAlignment="Left">
    <StackPanel Spacing="12">
      <TextBox PlaceholderText="Display name" />
      <ToggleSwitch Content="Public profile" IsChecked="True" />
    </StackPanel>
  </GroupBox>
</UserControl>
