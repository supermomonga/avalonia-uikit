<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gpui="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.GroupBoxVariants">
  <WrapPanel ItemSpacing="16" LineSpacing="16">
    <GroupBox Header="Normal" Content="On the page background." Width="280" />
    <GroupBox Classes="fill" Header="Fill" Content="On the group box fill." Width="280" />
    <GroupBox Classes="outline" Header="Outline" Content="Inside a 1px border." Width="280" />
    <GroupBox Classes="fill" Content="Without a title." Width="280" />
  </WrapPanel>
</UserControl>
