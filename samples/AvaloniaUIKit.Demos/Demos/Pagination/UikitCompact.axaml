<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.PaginationUikitCompact">
  <StackPanel Orientation="Horizontal" Spacing="16">
    <uikit:Pagination Classes="compact" TotalPages="10" CurrentPage="1" />
    <uikit:Pagination Classes="compact small" TotalPages="10" CurrentPage="4" />
  </StackPanel>
</UserControl>
