<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.RatingColor">
  <StackPanel Spacing="8" HorizontalAlignment="Left">
    <uikit:Rating Value="4" ActiveBrush="{DynamicResource UIKit.Red}" />
    <uikit:Rating Value="4" ActiveBrush="{DynamicResource UIKit.Primary}" />
  </StackPanel>
</UserControl>
