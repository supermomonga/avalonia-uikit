<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gpui="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.EmptyDemo">
  <gpui:EmptyState Classes="icon-media" Title="No projects yet" Description="Create your first project to get started."
                   Width="420" HorizontalAlignment="Left">
    <gpui:EmptyState.Media>
      <PathIcon Data="{StaticResource Gpui.Icon.Folder}" />
    </gpui:EmptyState.Media>
    <gpui:EmptyState.Actions>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="Create project" />
        <Button Classes="outline" Content="Import project" />
      </StackPanel>
    </gpui:EmptyState.Actions>
  </gpui:EmptyState>
</UserControl>
