<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gpui="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.CheckboxSizes">
  <WrapPanel ItemSpacing="16" LineSpacing="8">
    <CheckBox Classes="xsmall" Content="Extra small" IsChecked="True" />
    <CheckBox Classes="small" Content="Small" IsChecked="True" />
    <CheckBox Content="Medium" IsChecked="True" />
    <CheckBox Classes="large" Content="Large" IsChecked="True" />
  </WrapPanel>
</UserControl>
