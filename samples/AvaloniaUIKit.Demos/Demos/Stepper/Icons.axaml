<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.StepperIcons">
  <uikit:Stepper SelectedIndex="1" Width="480" HorizontalAlignment="Left">
    <uikit:StepperItem Content="Order Details" Icon="{StaticResource UIKit.Icon.Calendar}" />
    <uikit:StepperItem Content="Shipping" Icon="{StaticResource UIKit.Icon.Inbox}" />
    <uikit:StepperItem Content="Finish" Icon="{StaticResource UIKit.Icon.Info}" />
  </uikit:Stepper>
</UserControl>
