<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uikit="using:AvaloniaUIKit"
             x:Class="AvaloniaUIKit.Demos.StepperDemo">
  <uikit:Stepper SelectedIndex="1" Width="480" HorizontalAlignment="Left">
    <uikit:StepperItem Content="Order Details" />
    <uikit:StepperItem Content="Shipping" />
    <uikit:StepperItem Content="Finish" />
  </uikit:Stepper>
</UserControl>
