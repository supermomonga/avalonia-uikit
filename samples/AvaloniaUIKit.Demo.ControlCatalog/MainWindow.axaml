<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uikit="using:AvaloniaUIKit"
        xmlns:views="using:AvaloniaUIKit.Demo.ControlCatalog.Views"
        xmlns:inspector="using:AvaloniaUIKit.Demo.ControlCatalog.Inspector"
        x:Class="AvaloniaUIKit.Demo.ControlCatalog.MainWindow"
        Title="Avalonia UIKit Control Catalog"
        Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="{OnPlatform BorderOnly, macOS=Full}">
  <DockPanel>
    <uikit:TitleBar DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <uikit:SidebarToggleButton Name="SidebarToggle" IsCollapsed="{Binding #Sidebar.IsCollapsed, Mode=TwoWay}"
                                   ToolTip.Tip="Toggle the sidebar" />
        <TextBlock Text="Avalonia UIKit" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Classes="muted" Text="Control Catalog" FontSize="14" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
        <uikit:Select Name="ThemeSelect" Classes="small" Width="210" IsSearchable="True"
                      SearchPlaceholderText="Search themes" PlaceholderText="Theme" MaxDropDownHeight="420"
                      Icon="{StaticResource UIKit.Icon.Palette}" ToolTip.Tip="Theme" />
        <ToggleButton Name="InspectorToggle" Classes="small" Padding="6,0" IsChecked="True"
                      ToolTip.Tip="Show the property grid">
          <PathIcon Data="{StaticResource UIKit.Icon.PanelRight}" />
        </ToggleButton>
      </StackPanel>
    </uikit:TitleBar>

    <uikit:Sidebar Name="Sidebar" DockPanel.Dock="Left" Collapsible="Offcanvas" ExpandedWidth="248">
      <uikit:Sidebar.Header>
        <TextBox Name="Search" Classes="small" Margin="8,8,8,4" HorizontalAlignment="Stretch" PlaceholderText="Search"
                 uikit:Inputs.CleanOnEscape="True">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource UIKit.Icon.Search}" Width="14" Height="14" Margin="8,0,0,0"
                      Foreground="{DynamicResource UIKit.MutedForeground}" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <uikit:Kbd Name="SearchKey" Margin="0,0,6,0" />
          </TextBox.InnerRightContent>
        </TextBox>
      </uikit:Sidebar.Header>
      <uikit:Sidebar.Footer>
        <TextBlock Name="Counts" Classes="muted" FontSize="12" Margin="16,8" />
      </uikit:Sidebar.Footer>
    </uikit:Sidebar>

    <Grid Name="Body" ColumnDefinitions="*,Auto,360">
      <ScrollViewer Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
        <ContentControl Name="PageHost" />
      </ScrollViewer>
      <GridSplitter Name="InspectorSplitter" Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns" />
      <inspector:InspectorPanel Name="Inspector" Grid.Column="2" />
    </Grid>
  </DockPanel>
</Window>
