{
  "name": "Avalonia UIKit",
  "short_name": "Avalonia UIKit",
  "description": "Themes and controls for Avalonia in the Nova style of shadcn/ui and GPUI Kit.",
  "start_url": "/",
  "display": "browser",
  "icons": [
    { "src": "/icon-192.png", "type": "image/png", "sizes": "192x192" },
    { "src": "/icon-512.png", "type": "image/png", "sizes": "512x512" },
    { "src": "/favicon.svg", "type": "image/svg+xml", "sizes": "any" }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff"
}
